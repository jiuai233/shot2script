{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "逐镜头人工标注",
  "type": "object",
  "properties": {
    "集": {
      "type": "integer",
      "minimum": 1
    },
    "视频": {
      "type": "string",
      "minLength": 1
    },
    "校对完成": {
      "type": "boolean"
    },
    "人物": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^H[0-9]{2,}$"
          },
          "名称": {
            "type": "string",
            "minLength": 1
          },
          "外观": {
            "type": "string",
            "minLength": 1
          },
          "出现": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{2,}:[0-5][0-9]\\.[0-9]-[0-9]{2,}:[0-5][0-9]\\.[0-9]$"
            }
          },
          "待核对": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "名称",
          "外观",
          "出现"
        ],
        "additionalProperties": false
      }
    },
    "台词": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L[0-9]{2,}$"
          },
          "起": {
            "type": "string",
            "pattern": "^[0-9]{2,}:[0-5][0-9]\\.[0-9]$"
          },
          "止": {
            "type": "string",
            "pattern": "^[0-9]{2,}:[0-5][0-9]\\.[0-9]$"
          },
          "文本": {
            "type": "string",
            "minLength": 1
          },
          "说话人": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^H[0-9]{2,}$"
          },
          "形态": {
            "enum": [
              "画内",
              "画外",
              "心声",
              "设备",
              null
            ]
          },
          "待核对": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "起",
          "止",
          "文本",
          "说话人",
          "形态"
        ],
        "additionalProperties": false
      }
    },
    "关键动作": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M[0-9]{2,}$"
          },
          "起": {
            "type": "string",
            "pattern": "^[0-9]{2,}:[0-5][0-9]\\.[0-9]$"
          },
          "止": {
            "type": "string",
            "pattern": "^[0-9]{2,}:[0-5][0-9]\\.[0-9]$"
          },
          "执行者": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^H[0-9]{2,}$"
          },
          "动作": {
            "type": "string",
            "minLength": 1
          },
          "对象": {
            "type": [
              "string",
              "null"
            ]
          },
          "物件": {
            "type": [
              "string",
              "null"
            ]
          },
          "结果": {
            "type": [
              "string",
              "null"
            ]
          },
          "类别": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "待核对": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "起",
          "止",
          "执行者",
          "动作",
          "对象",
          "物件",
          "结果",
          "类别"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "集",
    "视频",
    "人物",
    "台词",
    "关键动作"
  ],
  "additionalProperties": false
}
