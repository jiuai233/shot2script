<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<?mso-application progid="Word.Document"?>
<pkg:package xmlns:pkg="http://schemas.microsoft.com/office/2006/xmlPackage"><pkg:part pkg:name="/_rels/.rels" pkg:contentType="application/vnd.openxmlformats-package.relationships+xml"><pkg:xmlData><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId4" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties" Target="docProps/core.xml"/><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties" Target="docProps/app.xml"/><Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/custom-properties" Target="docProps/custom.xml"/></Relationships></pkg:xmlData></pkg:part><pkg:part pkg:name="/word/_rels/document.xml.rels" pkg:contentType="application/vnd.openxmlformats-package.relationships+xml"><pkg:xmlData><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId4" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/fontTable" Target="fontTable.xml"/><Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/theme" Target="theme/theme1.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/settings" Target="settings.xml"/><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships></pkg:xmlData></pkg:part><pkg:part pkg:name="/word/document.xml" pkg:contentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"><pkg:xmlData><w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" xmlns:wpsCustomData="http://www.wps.cn/officeDocument/2013/wpsCustomData" mc:Ignorable="w14 w15 wp14"><w:body><w:p w14:paraId="2AF82335"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:b/><w:sz w:val="36"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>改</w:t></w:r><w:bookmarkStart w:id="0" w:name="_GoBack"/><w:bookmarkEnd w:id="0"/><w:r><w:rPr><w:b/><w:sz w:val="36"/></w:rPr><w:t>TG26090377假穷真爱 剧本合集</w:t></w:r></w:p><w:p w14:paraId="5E09A12F"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="497E23FA"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第1集</w:t></w:r></w:p><w:p w14:paraId="05B06D24"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>1-1 城南旧街路边云吞摊 日 外</w:t></w:r></w:p><w:p w14:paraId="69CF5D03"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、沈曼云、周启山、吴倩、莉莉</w:t></w:r></w:p><w:p w14:paraId="30354946"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 画面显示“城南旧街路边云吞摊”字样。蒸汽腾腾的路边摊位前，沈曼云正在忙碌地煮云吞。周启山坐在轮椅上，周明川身穿深蓝色工装坐在桌边。</w:t></w:r></w:p><w:p w14:paraId="4EFDC7A1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 字幕闪过：“盛川集团太子爷周明川”。</w:t></w:r></w:p><w:p w14:paraId="6DCED008"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（抱怨）：妈，好歹我们都是身家百亿的人，非得在这装穷相亲。</w:t></w:r></w:p><w:p w14:paraId="18D2A796"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（压低声音，严厉）：小点声，人马上就到了，你生怕别人听不见啊？</w:t></w:r></w:p><w:p w14:paraId="07F82175"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（无奈，指着父亲）：我装成修车工就算了，爸的腿明明都能走，你还让他坐轮椅。</w:t></w:r></w:p><w:p w14:paraId="4D6098B8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 字幕闪过：“盛川集团董事长沈曼云”。</w:t></w:r></w:p><w:p w14:paraId="3D5AAC45"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（严肃，一边下云吞）：儿媳妇什么出身我不管，可人品一定得经得住考验。</w:t></w:r></w:p><w:p w14:paraId="1975691A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（摊手）：你要看人品，也不用把咱家祖孙三代都整成困难户吧。</w:t></w:r></w:p><w:p w14:paraId="3FE44408"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川转向坐在轮椅上的父亲。</w:t></w:r></w:p><w:p w14:paraId="382724C3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（求助）：爸，你说句话呀。</w:t></w:r></w:p><w:p w14:paraId="5C8519DB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（语重心长）：明川，你从小身边围着的那些姑娘，看的是你这个人，还是盛川集团继承人这几个字，你分得出来？</w:t></w:r></w:p><w:p w14:paraId="06C43044"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头给到周启山特写，字幕显示：“盛川集团总裁周启山”。</w:t></w:r></w:p><w:p w14:paraId="0770A6DB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（平静）：家里都听你妈的。</w:t></w:r></w:p><w:p w14:paraId="68E5E192"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（震惊）：合着你们俩联手整我啊？</w:t></w:r></w:p><w:p w14:paraId="6DBCF07A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（淡定）：北城新能源基地那个项目，你盯了半年吧？还想要就耐心把今天的相亲相完。</w:t></w:r></w:p><w:p w14:paraId="20928CB3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（崩溃）：爸，我到底是不是亲生的？</w:t></w:r></w:p><w:p w14:paraId="6E548A48"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（快速叮嘱）：记住了，你是个汽修工，月薪五千，没车，婚房就老破小，你爸腿不好，我摆摊的，别说漏嘴。</w:t></w:r></w:p><w:p w14:paraId="729174CD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（敷衍）：知道了妈，你不去当演员真是可惜了。</w:t></w:r></w:p><w:p w14:paraId="338334DC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 两个年轻女子走来，左边穿白裙，右边穿黑衣短裤。字幕分别标注：“相亲女吴倩”、“闺蜜莉莉”。</w:t></w:r></w:p><w:p w14:paraId="1CD219AF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（嫌弃，捂鼻）：约这种地方相亲，介绍人脑子没病吧，啊哈哈？</w:t></w:r></w:p><w:p w14:paraId="5B09E6FE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云热情挥手招呼两人过来坐下。</w:t></w:r></w:p><w:p w14:paraId="5FB0F30B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（打量周明川）：你就是周明川？做什么的？一个月挣多少？</w:t></w:r></w:p><w:p w14:paraId="15A5762B"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="05BDBB7B"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第2集</w:t></w:r></w:p><w:p w14:paraId="0CEC509D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>2-1 城南旧街路边云吞摊 日 外</w:t></w:r></w:p><w:p w14:paraId="3083492F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、吴倩、莉莉、沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="5997C5DC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 蒸汽腾腾的路边摊位前，招牌写着“旧街口云香”和“手工肉肉 8元一碗”。周明川身穿深蓝色工装坐在桌边，对面坐着吴倩和莉莉。</w:t></w:r></w:p><w:p w14:paraId="0E2F756B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（平静）：汽修，五千左右。</w:t></w:r></w:p><w:p w14:paraId="406A4498"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（震惊）：五千？那房呢？</w:t></w:r></w:p><w:p w14:paraId="10210746"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（淡定）：老步梯房，四十来年了。</w:t></w:r></w:p><w:p w14:paraId="1D9E8AA7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（追问）：车呢？</w:t></w:r></w:p><w:p w14:paraId="12D78BA9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（摇头）：没有。</w:t></w:r></w:p><w:p w14:paraId="6CD9FCDE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头扫过一旁坐在轮椅上的周启山，吴倩目光扫向他。</w:t></w:r></w:p><w:p w14:paraId="3CBF0642"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（嫌弃）：你爸这腿，以后离不了人吧？</w:t></w:r></w:p><w:p w14:paraId="3161BAAD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（解释）：康复还需要一段时间，家里人肯定要照料。</w:t></w:r></w:p><w:p w14:paraId="64AC988C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（嘲讽，语速加快）：你妈摆摊你爸瘫着，你一个月才五千，还没房没车，你相什么亲啊？</w:t></w:r></w:p><w:p w14:paraId="56FEFA80"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 莉莉凑近吴倩耳边低语。</w:t></w:r></w:p><w:p w14:paraId="32323743"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>莉莉（不满）：倩倩，我早说这介绍人不靠谱，这不纯纯坑人吗？</w:t></w:r></w:p><w:p w14:paraId="22524DEC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（轻蔑）：你不是找老婆，你是找一个免费保姆吧？</w:t></w:r></w:p><w:p w14:paraId="375D3401"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（冷脸）：条件不合适你可以走，没必要这么说我父母。</w:t></w:r></w:p><w:p w14:paraId="62B309B3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（挑衅）：怎么，我说错了？就你这条件，谁嫁过来不是跳火坑？</w:t></w:r></w:p><w:p w14:paraId="0EA8B545"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 吴倩起身时故意将手提包甩向桌面，汤汁溅到包上。</w:t></w:r></w:p><w:p w14:paraId="426137BF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（尖叫）：啊！脏死了！我这包五万多，你赔得起吗你？</w:t></w:r></w:p><w:p w14:paraId="14C93BFD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>莉莉（拉扯吴倩）：快走快走，沾一身油烟味晦气。</w:t></w:r></w:p><w:p w14:paraId="3C2AF5F4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 吴倩被莉莉拉着往外走，回头怒视周明川。</w:t></w:r></w:p><w:p w14:paraId="3F625D17"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>吴倩（恶毒）：就你这条件还敢出来相亲，谁嫁你谁倒八辈子霉！</w:t></w:r></w:p><w:p w14:paraId="546C59A3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 两人离去，周明川独自坐在桌前，神情无奈。</w:t></w:r></w:p><w:p w14:paraId="3B55F6B0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（无奈）：我妈到底想让我找媳妇，还是想让我看破红尘？</w:t></w:r></w:p><w:p w14:paraId="1BE0F8FE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站起身走向摊位后的沈曼云。</w:t></w:r></w:p><w:p w14:paraId="76ED9721"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（抱怨）：妈，要不换个法子吧，再这么筛下去，好姑娘没见着，我先被骂出心理阴影。</w:t></w:r></w:p><w:p w14:paraId="2DFDE185"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（擦拭碗筷，平静）：还有最后一个。</w:t></w:r></w:p><w:p w14:paraId="250FBB8D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（决绝）：不相了。</w:t></w:r></w:p><w:p w14:paraId="4F4D5035"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川转身欲走，轮椅上的周启山伸手拉住他。</w:t></w:r></w:p><w:p w14:paraId="5AA3FF43"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（严肃）：北城项目。</w:t></w:r></w:p><w:p w14:paraId="7765DA17"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="0B3B4F20"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第3集</w:t></w:r></w:p><w:p w14:paraId="1072F772"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>3-1 城南旧街路边云吞摊 日 外</w:t></w:r></w:p><w:p w14:paraId="4EF170D5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、周启山、沈曼云、林晓禾</w:t></w:r></w:p><w:p w14:paraId="7EB3E69C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老旧街道旁，蒸汽腾腾的云吞摊前，招牌写着“旧街口云香”。周明川身穿深蓝色工装站在桌边，神情烦躁。周启山坐在轮椅上，伸手拉住儿子的衣角。</w:t></w:r></w:p><w:p w14:paraId="0D370474"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（焦急）：爸。</w:t></w:r></w:p><w:p w14:paraId="347ADCC7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（严肃）：项目还要不要了？</w:t></w:r></w:p><w:p w14:paraId="7A63AAF0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（愤怒）：那也不能拿终身大事卡我啊。</w:t></w:r></w:p><w:p w14:paraId="712D25F1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（训斥）：连等一个姑娘的耐心都没有，你还能跟十几个部门磨项目？</w:t></w:r></w:p><w:p w14:paraId="55E51692"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（无奈叹气，转身坐下）：行，最后一个。再碰上个嘴这么毒的，我当天就出家。</w:t></w:r></w:p><w:p w14:paraId="1E9CB454"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 摊位后的沈曼云擦拭着双手，看向街道远处。</w:t></w:r></w:p><w:p w14:paraId="5F4DCD5F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（招呼）：来了。</w:t></w:r></w:p><w:p w14:paraId="0AA13730"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一辆载满纸箱、风扇和旧电视的蓝色电动三轮车驶来，急刹车停在摊位前。林晓禾身穿工装背带裤跳下车，大步走向桌子。</w:t></w:r></w:p><w:p w14:paraId="2B8F7F60"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 画面左侧闪过竖排字幕“维修店主林晓禾”。</w:t></w:r></w:p><w:p w14:paraId="7411BBC1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（扫视众人）：谁是周明川？</w:t></w:r></w:p><w:p w14:paraId="3160AFFF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（愣住，举手）：我。</w:t></w:r></w:p><w:p w14:paraId="4BB24FE8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾拿出手机对比照片，上下打量周明川。</w:t></w:r></w:p><w:p w14:paraId="5B196E13"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（评价）：还行，比照片精神。</w:t></w:r></w:p><w:p w14:paraId="63B53C5F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，疑惑）：这到底是来相亲的还是来拆摊的？</w:t></w:r></w:p><w:p w14:paraId="5883E9B3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，审视）：长得倒还行，就是不知道人怎么样。</w:t></w:r></w:p><w:p w14:paraId="3A224C7D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（热情）：晓禾是吧？快坐，阿姨给你下一碗云吞。</w:t></w:r></w:p><w:p w14:paraId="6779819A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（礼貌摆手）：谢谢阿姨，先不用。我来晚了八分钟，不好意思。</w:t></w:r></w:p><w:p w14:paraId="4590F5E7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（冷淡）：堵车？</w:t></w:r></w:p><w:p w14:paraId="29CF99FD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（解释）：路口老太太家电饭锅短路跳闸，顺手给换了个插头。</w:t></w:r></w:p><w:p w14:paraId="56448908"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（讽刺）：相个亲还顺路接活，时间倒是一点不浪费。</w:t></w:r></w:p><w:p w14:paraId="2DB6A89F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾坐下时晃动了一下桌子，发现桌腿松动，随即蹲下从工具包里掏出扳手。</w:t></w:r></w:p><w:p w14:paraId="29DDCCA6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：阿姨，这桌子不能这么凑合用。</w:t></w:r></w:p><w:p w14:paraId="22E78BDF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，鄙夷）：才坐下就嫌我妈摊子破，又是一个拜金女。</w:t></w:r></w:p><w:p w14:paraId="10BEEB7A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 特写镜头：林晓禾熟练地用扳手拧紧桌腿螺丝。</w:t></w:r></w:p><w:p w14:paraId="7C28B65D"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="7AB799D1"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第4集</w:t></w:r></w:p><w:p w14:paraId="0035B40A"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>4-1 城南旧街路边云吞摊 日 外</w:t></w:r></w:p><w:p w14:paraId="58382FF7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="742589A8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老旧街道旁，地面湿润。林晓禾蹲在地上用扳手拧紧折叠桌的桌腿螺丝，随后站起身拍了拍手。周明川坐在对面。</w:t></w:r></w:p><w:p w14:paraId="02731A04"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（轻松）：行了，再晃就是桌板的问题。</w:t></w:r></w:p><w:p w14:paraId="53299D3C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向摊位后方，沈曼云站在冒着热气的锅前微笑，周启山坐在旁边的轮椅上。</w:t></w:r></w:p><w:p w14:paraId="0933E37C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（赞赏）：你这手可真巧啊。</w:t></w:r></w:p><w:p w14:paraId="0D27B41E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾将扳手放回腰间的工具包里，笑着回应。</w:t></w:r></w:p><w:p w14:paraId="3D241E3F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（爽朗）：干我们这行的，见着松的就手痒，不拧紧浑身不得劲。</w:t></w:r></w:p><w:p w14:paraId="188F1400"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云端着两碗热气腾腾的云吞走过来，放在桌上。林晓禾坐回桌边，看着对面的周明川。</w:t></w:r></w:p><w:p w14:paraId="4A444352"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：先问清楚，你一个月挣多少？</w:t></w:r></w:p><w:p w14:paraId="3ECA5541"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，无奈）：来了，果然还是为了钱。</w:t></w:r></w:p><w:p w14:paraId="51734BC2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（平静）：五千左右。</w:t></w:r></w:p><w:p w14:paraId="44FE0404"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（追问）：有网贷吗？</w:t></w:r></w:p><w:p w14:paraId="7EE1DE40"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（摇头）：没有。</w:t></w:r></w:p><w:p w14:paraId="1C694E67"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（继续追问）：信用卡欠多少？</w:t></w:r></w:p><w:p w14:paraId="434E840C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（干脆）：不欠。</w:t></w:r></w:p><w:p w14:paraId="56DF5A25"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（审视）：网赌赌球炒币沾不沾？</w:t></w:r></w:p><w:p w14:paraId="58D90AC6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（否认）：都不碰。</w:t></w:r></w:p><w:p w14:paraId="28030042"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（盯着他）：喝大酒吗？</w:t></w:r></w:p><w:p w14:paraId="4C78C8AF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（解释）：应酬偶尔喝。</w:t></w:r></w:p><w:p w14:paraId="07F9F39A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（犀利）：动手打女人吗？</w:t></w:r></w:p><w:p w14:paraId="58E00FCF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（反问）：我看着像有这个爱好？</w:t></w:r></w:p><w:p w14:paraId="3966CC58"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：看不出来，所以才问。</w:t></w:r></w:p><w:p w14:paraId="7011939D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾拿起筷子，神情放松了一些。</w:t></w:r></w:p><w:p w14:paraId="1E030A30"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（满意）：行，底子没坏。</w:t></w:r></w:p><w:p w14:paraId="41C6F349"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（疑惑）：什么就行了？</w:t></w:r></w:p><w:p w14:paraId="31056F28"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（坦诚）：工资低点能再挣，身上全是坏毛病的，不适合过日子。</w:t></w:r></w:p><w:p w14:paraId="0D3298A2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>os</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>内心独白</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>）：没车没房我不怕，赌博网贷那种人，我可受不起。</w:t></w:r></w:p><w:p w14:paraId="2B0D59B7"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="3374C320"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第5集</w:t></w:r></w:p><w:p w14:paraId="37B48A5E"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>5-1 城南旧街路边馄饨摊 日 外</w:t></w:r></w:p><w:p w14:paraId="2D107454"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="63C69288"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老旧街道旁，地面湿润。周明川和林晓禾坐在小桌前吃馄饨，桌上放着醋瓶和辣椒油。</w:t></w:r></w:p><w:p w14:paraId="69ADA193"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，若有所思）：原来</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>她</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>在意的是这些。</w:t></w:r></w:p><w:p w14:paraId="20F21474"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川放下勺子，看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="6F5D7207"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（试探）：那你呢？收入多少？</w:t></w:r></w:p><w:p w14:paraId="288B0576"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（坦诚）：不固定，好的月份一万出头，差的时候三四千。</w:t></w:r></w:p><w:p w14:paraId="2DAC760A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（追问）：做什么的？</w:t></w:r></w:p><w:p w14:paraId="0613388D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（微笑）：旧货维修，家电家具小电器，能修的都修，顺便收旧货。</w:t></w:r></w:p><w:p w14:paraId="3D2C6884"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（继续问）：房呢？</w:t></w:r></w:p><w:p w14:paraId="71387453"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（轻松）：我爸留的铺子，楼上两间房，够住。</w:t></w:r></w:p><w:p w14:paraId="65B998A6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（调侃）：你就不怕我图你那铺子？</w:t></w:r></w:p><w:p w14:paraId="0B0A96E2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（回怼）：你先把你那五千工资保住再说。</w:t></w:r></w:p><w:p w14:paraId="023D918F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头拉远，沈曼云站在一旁整理青菜，周启山坐在轮椅上看着两人微笑。</w:t></w:r></w:p><w:p w14:paraId="607FE086"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（好奇）：晓禾啊，你不嫌明川挣得少？</w:t></w:r></w:p><w:p w14:paraId="5CCD2941"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（干脆）：嫌啊。</w:t></w:r></w:p><w:p w14:paraId="125C80BF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾夹起一个馄饨，神情认真。</w:t></w:r></w:p><w:p w14:paraId="58C36C2A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：但嫌不等于不能处，人不是工资条，先看人。</w:t></w:r></w:p><w:p w14:paraId="2FCB2EF3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（笑着挥手）：你们俩别在这耗着了，自己出去转转吧。</w:t></w:r></w:p><w:p w14:paraId="39CCC6DA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川和林晓禾站起身。</w:t></w:r></w:p><w:p w14:paraId="615F0315"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（提议）：要不我请你去吃个饭？</w:t></w:r></w:p><w:p w14:paraId="4E6D8DD2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（答应）：行。</w:t></w:r></w:p><w:p w14:paraId="4757250A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾走向停在路边的一辆蓝色电动三轮车，拍了拍车斗。</w:t></w:r></w:p><w:p w14:paraId="6CDC0B2D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（招呼）：上车。</w:t></w:r></w:p><w:p w14:paraId="0B0F822A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（震惊，指着自己）：我吗？</w:t></w:r></w:p><w:p w14:paraId="1C1306EE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（回头笑）：不然我拉空气？</w:t></w:r></w:p><w:p w14:paraId="04B2CF5C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，崩溃）：我妈让我装穷，也没说要装到坐废品车斗这个程度。</w:t></w:r></w:p><w:p w14:paraId="21E02453"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（催促）：等等。</w:t></w:r></w:p><w:p w14:paraId="7860D8DF"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="24BBC5E6"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第6集</w:t></w:r></w:p><w:p w14:paraId="078594C5"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>6-1 老街街道 日 外</w:t></w:r></w:p><w:p w14:paraId="688D1148"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、大爷</w:t></w:r></w:p><w:p w14:paraId="79F80D28"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夕阳下的老街，路面有些潮湿。林晓禾蹲在一辆蓝色电动三轮车后斗旁，用抹布擦拭车斗上的油污。周明川站在一旁看着。</w:t></w:r></w:p><w:p w14:paraId="1841ACE0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（关切）：刚拉过空调外机，油灰重，别把你裤子蹭黑了。</w:t></w:r></w:p><w:p w14:paraId="177504C4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川坐上三轮车后斗，看着林晓禾满是油污的手。</w:t></w:r></w:p><w:p w14:paraId="2A101A2E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>os</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（感慨）：手上全是机油，心倒比很多人干净。</w:t></w:r></w:p><w:p w14:paraId="5AA42E8B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 两人骑车行驶在路上，前方一位大爷推着装满蔬菜的手推车过马路，车轮突然脱落，蔬菜散落一地。</w:t></w:r></w:p><w:p w14:paraId="72AEFFBE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（惊呼）：你！</w:t></w:r></w:p><w:p w14:paraId="374E9E07"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾急忙停车，跳下车跑向大爷。</w:t></w:r></w:p><w:p w14:paraId="2C8631D8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（焦急）：大爷别推，轴销掉了，再推车架都得变形。</w:t></w:r></w:p><w:p w14:paraId="2D0528AC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>大爷（摆手）：姑娘不用麻烦，我找根铁丝绑绑凑合用就行。</w:t></w:r></w:p><w:p w14:paraId="2CAB49B8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾打开工具箱，拿出零件。</w:t></w:r></w:p><w:p w14:paraId="07676D51"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：铁丝绑不住，走两步还得掉。</w:t></w:r></w:p><w:p w14:paraId="585CDEBE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾熟练地蹲下修理车轮，很快修好。大爷满脸感激。</w:t></w:r></w:p><w:p w14:paraId="13705C78"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>大爷（感激）：哎呀多亏你了姑娘，多少钱我给你？</w:t></w:r></w:p><w:p w14:paraId="588432A7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（爽朗）：两个小零件收什么钱，下次别装这么满，轮子扛不住。</w:t></w:r></w:p><w:p w14:paraId="4EE773EC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>大爷（点头）：对对。</w:t></w:r></w:p><w:p w14:paraId="6C584B83"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾回到车上，发动三轮车。</w:t></w:r></w:p><w:p w14:paraId="0FA3EAA4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（提醒）：坐稳了，摔着我可不修人。</w:t></w:r></w:p><w:p w14:paraId="234E19AC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（调侃）：我人可比车贵。</w:t></w:r></w:p><w:p w14:paraId="626D45FC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（回怼）：我只修车，不修自恋的毛病。</w:t></w:r></w:p><w:p w14:paraId="4DD795FF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 三轮车驶离画面。</w:t></w:r></w:p><w:p w14:paraId="5123FAAC"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="184FE94C"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>6-2 城南菜市场口杂货铺 日 外</w:t></w:r></w:p><w:p w14:paraId="16DC78AD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、杂货铺老板娘</w:t></w:r></w:p><w:p w14:paraId="0B701412"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 三轮车停在一家挂着“城南菜市场口杂货铺”招牌的店铺前。店门口摆放着风扇等杂物。</w:t></w:r></w:p><w:p w14:paraId="013A9C0C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 杂货铺老板娘从店里探出头，看到林晓禾。</w:t></w:r></w:p><w:p w14:paraId="1F74B7C9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>杂货铺老板娘（急切）：晓禾快帮我看一眼！</w:t></w:r></w:p><w:p w14:paraId="2E9E617E"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="66A200A0"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第7集</w:t></w:r></w:p><w:p w14:paraId="33DB8F56"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>7-1 城南菜市场口杂货铺 日 外</w:t></w:r></w:p><w:p w14:paraId="0F8A5882"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、杂货铺老板娘、维修工</w:t></w:r></w:p><w:p w14:paraId="7F5240C2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 白天，杂货铺门口，杂货铺老板娘情绪激动地指着旁边的维修工，林晓禾坐在蓝色电动三轮车后斗上，周明川站在车旁。</w:t></w:r></w:p><w:p w14:paraId="3019BC39"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>杂货铺老板娘（愤怒，手指维修工）：他非说电机烧了，要600块换新的，我这台才用三年！</w:t></w:r></w:p><w:p w14:paraId="0F5A7EF1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修工双手抱胸，一脸不屑地看着杂货铺老板娘。</w:t></w:r></w:p><w:p w14:paraId="5B24A62F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>维修工（傲慢）：电机都不转了，不换新的能怎么办？小姑娘家家的，别瞎掺和。</w:t></w:r></w:p><w:p w14:paraId="5B471DC5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾从三轮车上下来，走到一台旧电风扇前蹲下检查。她拆下风扇网罩，仔细查看内部零件。</w:t></w:r></w:p><w:p w14:paraId="163FB02B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾用手指着风扇内部的电容，抬头看向维修工。</w:t></w:r></w:p><w:p w14:paraId="45B08D1C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷静，指着电容）：电机没烧，启动电容鼓包了。</w:t></w:r></w:p><w:p w14:paraId="4D15F0AB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修工皱起眉头，表情不悦。</w:t></w:r></w:p><w:p w14:paraId="06118448"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>维修工（质疑）：壳都没全拆你就敢断定？我修了十几年电器，还能看错？</w:t></w:r></w:p><w:p w14:paraId="4F8170B4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾继续检查风扇轴头，用手转动扇叶。</w:t></w:r></w:p><w:p w14:paraId="30795AD5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（专业）：烧电机有焦味，轴头发涩转不动。这个轴顺，线圈也没黑，瞎换什么电机。</w:t></w:r></w:p><w:p w14:paraId="5C365AB2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾从工具箱里拿出一个新的电容，熟练地更换上去，然后重新组装好风扇。</w:t></w:r></w:p><w:p w14:paraId="1A3ED8ED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾按下开关，风扇叶片开始转动。杂货铺老板娘惊喜地凑上前。</w:t></w:r></w:p><w:p w14:paraId="4E6388ED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>杂货铺老板娘（惊喜）：真好了！多少钱？</w:t></w:r></w:p><w:p w14:paraId="69DC8E77"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静）：电容十块，工钱二十，一共三十。</w:t></w:r></w:p><w:p w14:paraId="27B22A73"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>杂货铺老板娘（惊讶）：才三十？换个新的我得多花五百多。</w:t></w:r></w:p><w:p w14:paraId="3C816844"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：能修就修，能省就省，没必要多花钱。</w:t></w:r></w:p><w:p w14:paraId="45C772F0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川坐在三轮车后斗上，目光注视着林晓禾，神情若有所思。</w:t></w:r></w:p><w:p w14:paraId="478514E7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，感慨）：她天天跟钱打交道，却不是想怎么从别人兜里多拿，而是想怎么让别人少花冤枉钱。</w:t></w:r></w:p><w:p w14:paraId="2C14619C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修工双臂交叉抱在胸前，冷笑着看向林晓禾。</w:t></w:r></w:p><w:p w14:paraId="1F007C72"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>维修工（嘲讽）：你这么做生意，难怪店开不大。</w:t></w:r></w:p><w:p w14:paraId="27D1FF6A"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="7B26876F"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第8集</w:t></w:r></w:p><w:p w14:paraId="4D18D40E"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>8-1 杂货铺门口街道 日 外</w:t></w:r></w:p><w:p w14:paraId="64A18B35"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="1BCD70EB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 白天，杂货铺门口，林晓禾蹲在地上用螺丝刀修理一台旧电风扇，神情专注。</w:t></w:r></w:p><w:p w14:paraId="0DAAB636"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：开不大也饿不死，坏的不彻底就让人扔，才叫砸自己招牌。</w:t></w:r></w:p><w:p w14:paraId="3FDC78FA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾修好风扇站起身，看向坐在蓝色电动三轮车上的周明川。</w:t></w:r></w:p><w:p w14:paraId="140EFC8C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（催促）：走了，再耽搁，九块钱的螺蛳粉都卖完了。</w:t></w:r></w:p><w:p w14:paraId="527BB44F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（惊讶）：九块钱的粉还能卖完？</w:t></w:r></w:p><w:p w14:paraId="7743C41D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（自信，跨上三轮车后座）：便宜饭菜不愁卖，别小看这点生意。</w:t></w:r></w:p><w:p w14:paraId="3F37207A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川驾驶电动三轮车带着林晓禾驶离画面。</w:t></w:r></w:p><w:p w14:paraId="7A1E913E"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="74647D00"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>8-2 螺蛳粉小店 日 内</w:t></w:r></w:p><w:p w14:paraId="6F685ECB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="7F905D1F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 简陋的螺蛳粉店内，墙上贴着红纸黑字的价目表“原味螺粉 9元”。周明川和林晓禾面对面坐在木桌旁，桌上放着两碗螺蛳粉。</w:t></w:r></w:p><w:p w14:paraId="1E67DC89"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（调侃）：第一次约会，就吃这个？</w:t></w:r></w:p><w:p w14:paraId="4F7587D6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（笑着拆开一次性筷子）：九块钱一碗，配你现在的收入正好。</w:t></w:r></w:p><w:p w14:paraId="3CD20DD3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（微笑）：那我还得谢谢你替我精打细算。</w:t></w:r></w:p><w:p w14:paraId="38C18B03"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（俏皮）：不用谢，加卤蛋自己掏钱。</w:t></w:r></w:p><w:p w14:paraId="4D1BAF67"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="5A482E6B"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>8-3 螺蛳粉小店 日 内</w:t></w:r></w:p><w:p w14:paraId="418AD1A6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、老奶奶、老板</w:t></w:r></w:p><w:p w14:paraId="21C64402"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一位衣衫褴褛的老奶奶颤巍巍地走到桌边，伸手想要端走桌上剩下的一碗粉。</w:t></w:r></w:p><w:p w14:paraId="5502CDFA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（震惊，迅速按住碗）：你干什么？</w:t></w:r></w:p><w:p w14:paraId="33CACB1C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川看着这一幕，眉头微皱。</w:t></w:r></w:p><w:p w14:paraId="2EF208CC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，凝重）：这是嫌老人脏？</w:t></w:r></w:p><w:p w14:paraId="26F530EA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老奶奶（委屈，眼含泪水）：姑娘我就是饿了，我……</w:t></w:r></w:p><w:p w14:paraId="35AFE9F3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾端起那碗剩粉，转身走向柜台后的老板。</w:t></w:r></w:p><w:p w14:paraId="709525B6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（果断）：老板，重新下一碗，加蛋再加一份肉。</w:t></w:r></w:p><w:p w14:paraId="63EEE2B2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老奶奶（局促不安，低头搓手）：姑娘我我没钱。</w:t></w:r></w:p><w:p w14:paraId="7181F6AD"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="64024A2A"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第9集</w:t></w:r></w:p><w:p w14:paraId="0B402D26"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>9-1 螺蛳粉小店 日 内</w:t></w:r></w:p><w:p w14:paraId="60A31DA7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、老奶奶、周明川、老板</w:t></w:r></w:p><w:p w14:paraId="67B1AC48"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 简陋的螺蛳粉店内，墙上贴着红纸黑字的价目表。林晓禾面带微笑看着面前的老奶奶。</w:t></w:r></w:p><w:p w14:paraId="71B6A6DD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（温和）：我请你吃不要钱。</w:t></w:r></w:p><w:p w14:paraId="5A9E4BB5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老奶奶从口袋里掏出两枚硬币，递向林晓禾。</w:t></w:r></w:p><w:p w14:paraId="3623942C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老奶奶（诚恳）：我有两块，不能白吃你的。</w:t></w:r></w:p><w:p w14:paraId="287E998B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾接过硬币，握在手中。</w:t></w:r></w:p><w:p w14:paraId="0D769CA7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（爽快）：行那我收着。</w:t></w:r></w:p><w:p w14:paraId="595C5E4A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向旁边桌正在吃粉的周明川，他放下筷子，看向林晓禾。</w:t></w:r></w:p><w:p w14:paraId="62D18776"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>os</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（疑惑）：都请了，怎么还收这两块？</w:t></w:r></w:p><w:p w14:paraId="6CBE616F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾拿着硬币走到柜台前，将硬币放在老板的记账本上。</w:t></w:r></w:p><w:p w14:paraId="1BC1C890"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（低声叮嘱）：他下次要是再来，给他抵两块，别告诉他是我放的。</w:t></w:r></w:p><w:p w14:paraId="53816C06"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老板（点头）：好。</w:t></w:r></w:p><w:p w14:paraId="56166098"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：还有下次给他少辣，老人胃受不了。</w:t></w:r></w:p><w:p w14:paraId="394CFD1B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾转身走回座位，发现周明川正盯着自己看。</w:t></w:r></w:p><w:p w14:paraId="25B38450"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（嗔怪）：看什么，粉坨了你赔我一碗。</w:t></w:r></w:p><w:p w14:paraId="37A23235"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（掩饰）：没什么。</w:t></w:r></w:p><w:p w14:paraId="0E4FC991"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，若有所思）：今天已经看错她两次了。</w:t></w:r></w:p><w:p w14:paraId="2CF64AE5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾坐下，拿出手机对准周明川。</w:t></w:r></w:p><w:p w14:paraId="14CAB4EB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（干脆）：收款码给我。</w:t></w:r></w:p><w:p w14:paraId="6E2E52C0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（不解）：干什么？</w:t></w:r></w:p><w:p w14:paraId="00A92E27"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（理直气壮）：把我那份转你。</w:t></w:r></w:p><w:p w14:paraId="57DDCDD3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（自信）：第一次吃饭，我请得起。</w:t></w:r></w:p><w:p w14:paraId="75ED9EE1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：请我可以，老人那碗算我的。</w:t></w:r></w:p><w:p w14:paraId="1DD6ECF1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（困惑）：为什么分这么清？</w:t></w:r></w:p><w:p w14:paraId="0A9BAB09"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（坚定）：因为那是我想请的人，不该让你替我做人情。</w:t></w:r></w:p><w:p w14:paraId="18BC4DA7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 特写手机屏幕，显示转账界面，金额5.00元，备注“没敢多收”。</w:t></w:r></w:p><w:p w14:paraId="5262E385"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川看着手机屏幕，眼神中流露出惊讶和触动。</w:t></w:r></w:p><w:p w14:paraId="51374159"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，感慨）：她不是怕欠我钱，是连自己的好意都不拿别人买单。</w:t></w:r></w:p><w:p w14:paraId="48B3CAF9"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="67716535"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第10集</w:t></w:r></w:p><w:p w14:paraId="51746264"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>10-1 螺蛳粉小店 日 内</w:t></w:r></w:p><w:p w14:paraId="49408441"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="2994581B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 简陋的小店内，周明川和林晓禾面对面坐着吃粉。周明川看着林晓禾，神情认真。</w:t></w:r></w:p><w:p w14:paraId="21A12283"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（疑惑）：你谈恋爱都这么算？</w:t></w:r></w:p><w:p w14:paraId="6BF54D66"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静）：没谈过不知道。</w:t></w:r></w:p><w:p w14:paraId="4A0A0BF4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（惊讶）：你也没谈过？</w:t></w:r></w:p><w:p w14:paraId="1E25D8F0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（无奈）：忙着接我爸的店，天天修东西收旧货哪有空。你呢？</w:t></w:r></w:p><w:p w14:paraId="1293CADB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（微笑）：也没有。</w:t></w:r></w:p><w:p w14:paraId="44A5A1D3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（开心）：那挺好两个生手，谁也别笑话谁。</w:t></w:r></w:p><w:p w14:paraId="13C41AF1"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="5187D11C"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>10-2 街道 日 外</w:t></w:r></w:p><w:p w14:paraId="02869FDB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="5FA3C19D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 两人走出店门，来到街边一辆蓝色电动三轮车旁。林晓禾跨上车，周明川站在车旁看着她笑。</w:t></w:r></w:p><w:p w14:paraId="00D644F3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾骑车离开，周明川目送她远去，脸上带着笑意。</w:t></w:r></w:p><w:p w14:paraId="061DB7E8"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="3DA3AA96"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>10-3 老街巷口（路边摊） 傍 外</w:t></w:r></w:p><w:p w14:paraId="681489D2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="794F6300"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夕阳下的老街巷口，沈曼云在冒着热气的摊位前忙碌。周启山坐在轮椅上，腿上放着一个印有美元符号的银色手提箱。</w:t></w:r></w:p><w:p w14:paraId="2F5C8C13"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川笑着走向摊位，在桌边坐下。</w:t></w:r></w:p><w:p w14:paraId="248E9FF9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（期待）：怎么样？</w:t></w:r></w:p><w:p w14:paraId="09D9D57F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（敷衍）：一般。</w:t></w:r></w:p><w:p w14:paraId="7C59B932"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（调侃）：一般你一路笑什么？</w:t></w:r></w:p><w:p w14:paraId="33D6FE0F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（掩饰）：风大脸抽筋。</w:t></w:r></w:p><w:p w14:paraId="3F058640"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（拆穿）：今天没风。</w:t></w:r></w:p><w:p w14:paraId="4FABF814"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（淡然）：一碗9块钱螺蛳粉，说明不了什么。</w:t></w:r></w:p><w:p w14:paraId="646CCB12"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（深沉）：我看已经能说明不少。</w:t></w:r></w:p><w:p w14:paraId="7C19F10A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（严肃）：真过日子不是吃顿便宜饭，要看他能不能接受这个家。</w:t></w:r></w:p><w:p w14:paraId="57833129"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（不耐烦）：妈差不多得了。</w:t></w:r></w:p><w:p w14:paraId="058CA7EF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（戏谑）：怎么才见一面就心疼了？</w:t></w:r></w:p><w:p w14:paraId="138AE0F0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真）：我是不想没完没了骗人。</w:t></w:r></w:p><w:p w14:paraId="2BCFE880"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（坚定）：最后一关，明天带他去你爷爷那套老房，他真能接受，这事再往下谈。</w:t></w:r></w:p><w:p w14:paraId="673D1364"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="3A1C08F0"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第11集</w:t></w:r></w:p><w:p w14:paraId="6B205377"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>11-1 老街巷口（路边摊） 傍 外</w:t></w:r></w:p><w:p w14:paraId="367AE23A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、沈曼云</w:t></w:r></w:p><w:p w14:paraId="26FEFC59"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夕阳下的老街巷口，蒸汽氤氲。周明川身穿深蓝色工装坐在塑料凳上，神情落寞。沈曼云在摊位前忙碌。</w:t></w:r></w:p><w:p w14:paraId="1C877AD5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，低沉）：我心疼什么？我只是不想再看她被谁打分。</w:t></w:r></w:p><w:p w14:paraId="5E9502A7"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="1D3CA8C0"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>11-2 盛川集团会议室 日 内</w:t></w:r></w:p><w:p w14:paraId="0D4F95A8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、李经理、员工甲、员工乙、员工丙、员工丁</w:t></w:r></w:p><w:p w14:paraId="7ED88922"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 现代化的会议室，大屏幕上显示着“389 盛川集团”的数据图表。周明川身穿深灰色西装坐在主位，神情严肃。李经理站在一旁指着屏幕汇报。</w:t></w:r></w:p><w:p w14:paraId="430F7529"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 字幕闪过“盛川集团会议室”。</w:t></w:r></w:p><w:p w14:paraId="4D6EEA7A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（急切，指着屏幕）：周总，热失控冗余测试正常要多跑七天，只要您签字放行，我们可以先投产，后续补做验证。</w:t></w:r></w:p><w:p w14:paraId="281E4FBB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川低头翻看手中的文件，文件封面上写着“风险警示”。他抬起头，目光坚定。</w:t></w:r></w:p><w:p w14:paraId="0AD3EF66"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（果断）：不签。</w:t></w:r></w:p><w:p w14:paraId="10812AFF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（焦急）：可北城项目节点……</w:t></w:r></w:p><w:p w14:paraId="5256BC55"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（严厉）：节点是用来追的，不是拿安全换的。七天工期我来想办法追回，涉及电池安全的测试一项都不能少。</w:t></w:r></w:p><w:p w14:paraId="5E08B4DC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川将文件重重拍在桌上。</w:t></w:r></w:p><w:p w14:paraId="19C141CC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（命令）：重排排期，明天上午给我。另外外部汽买配套供应商的资质再筛一遍，不合规的直接剔除，不用走复审。</w:t></w:r></w:p><w:p w14:paraId="3EE366D2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 会议结束，其他人员离开。一名助理走到周明川身边，看着手机汇报。</w:t></w:r></w:p><w:p w14:paraId="29735AFA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>助理（恭敬）：周总，董事长问您今天相亲结果怎么样？</w:t></w:r></w:p><w:p w14:paraId="183E697A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川揉了揉眉心，显得有些疲惫。</w:t></w:r></w:p><w:p w14:paraId="537CB0A9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（无奈）：就说我在开会。</w:t></w:r></w:p><w:p w14:paraId="5B2BED6F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>助理（继续汇报）：他还交代明天上午十点，老纺织厂家属院见。</w:t></w:r></w:p><w:p w14:paraId="2C1A4C62"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（苦笑）：比项目进度还难赶。</w:t></w:r></w:p><w:p w14:paraId="1830DFC1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，感慨）：工作上的风险算得清，感情这笔账算不清。</w:t></w:r></w:p><w:p w14:paraId="3A3510D1"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="47309817"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第12集</w:t></w:r></w:p><w:p w14:paraId="2A22A269"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>12-1 晓禾旧货维修店 日 内</w:t></w:r></w:p><w:p w14:paraId="55EB1247"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、林小满</w:t></w:r></w:p><w:p w14:paraId="3FED3512"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光透过卷帘门照进堆满旧电视机的维修店。林小满站在梯子上整理货架，林晓禾骑着三轮车停在门口。</w:t></w:r></w:p><w:p w14:paraId="6E9BD0A4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 字幕显示“晓禾旧货维修店”。</w:t></w:r></w:p><w:p w14:paraId="6DE3DD55"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（兴奋，跳下梯子）：怎么样怎么样？人帅不帅？有房有车吗？</w:t></w:r></w:p><w:p w14:paraId="1D006235"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（无奈，放下工具包）：你怎么跟楼下王姨一个德行，张口就问条件。</w:t></w:r></w:p><w:p w14:paraId="5727E761"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（嬉皮笑脸）：那我问人品总行吧？人靠不靠谱？</w:t></w:r></w:p><w:p w14:paraId="61770E28"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾走到工具墙前挂扳手。</w:t></w:r></w:p><w:p w14:paraId="1F99749C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静）：条件挺差。</w:t></w:r></w:p><w:p w14:paraId="402709FE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（惊讶，瞪大眼睛）：条件差你还跟人吃半天饭？</w:t></w:r></w:p><w:p w14:paraId="6B1E2300"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（转身，认真）：条件差又不是人品差，又不犯法。</w:t></w:r></w:p><w:p w14:paraId="4F818007"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（急切）：那总有优点吧？总不能啥都没有你还愿意聊？</w:t></w:r></w:p><w:p w14:paraId="76CEF763"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（列举）：不嫌我三轮脏，路上帮老人修车没催，吃九块钱螺蛳粉也没摆脸。</w:t></w:r></w:p><w:p w14:paraId="32F2524C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（嫌弃）：这也算优点？</w:t></w:r></w:p><w:p w14:paraId="1FD67804"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾拿起螺丝刀。</w:t></w:r></w:p><w:p w14:paraId="7F917D82"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（走到工作台前）：现在很多人嘴上说尊重劳动，真让他坐废品堆旁边吃顿饭，鼻子先皱到天上去。</w:t></w:r></w:p><w:p w14:paraId="27396C7B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（试探）：所以有戏？</w:t></w:r></w:p><w:p w14:paraId="34E8900F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（低头修收音机）：先修着看。</w:t></w:r></w:p><w:p w14:paraId="7450CA92"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（调侃）：姐，人家是相亲对象，不是你台里的坏收音机。</w:t></w:r></w:p><w:p w14:paraId="20704535"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（手中动作不停）：都一样，乱按开关都容易烧。</w:t></w:r></w:p><w:p w14:paraId="5DF4E761"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="205ABA1E"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>12-2 城南纺织厂旧家属院 日 外</w:t></w:r></w:p><w:p w14:paraId="34195CA4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="4497532A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头切到一栋红砖老楼，墙上刷着红色标语。字幕显示“城南纺织厂旧家属院”。</w:t></w:r></w:p><w:p w14:paraId="1FA03A11"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云推着坐在轮椅上的周启山走出楼道，周明川身穿深蓝色工装站在一旁等待。</w:t></w:r></w:p><w:p w14:paraId="1ECB5B80"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾驾驶蓝色三轮车驶入画面，看到三人后停车。</w:t></w:r></w:p><w:p w14:paraId="049EA541"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="1C0E49CD"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第13集</w:t></w:r></w:p><w:p w14:paraId="611243BA"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>13-1 纺织厂家属院楼下 日 外</w:t></w:r></w:p><w:p w14:paraId="43AD8CC4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、周启山、沈曼云</w:t></w:r></w:p><w:p w14:paraId="35BCCC7C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一辆蓝色电动三轮车停在红砖楼下。林晓禾从车上下来，走向坐在轮椅上的周启山和站在一旁的周明川。</w:t></w:r></w:p><w:p w14:paraId="4901F8FA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（询问）：你爸住6楼？</w:t></w:r></w:p><w:p w14:paraId="3704EF8D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（平静）：一楼，以前爷爷单位分的。</w:t></w:r></w:p><w:p w14:paraId="300F21AD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（庆幸）：还好住一楼，真要天天抬轮椅上下楼，你们仨腰先报废。</w:t></w:r></w:p><w:p w14:paraId="528DCEE1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云提着菜站在周启山身后，闻言掩嘴轻笑。周启山也露出无奈的笑容。</w:t></w:r></w:p><w:p w14:paraId="183E5B76"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（自嘲）：我最近腰也确实不太好。</w:t></w:r></w:p><w:p w14:paraId="5EBD1DAD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：叔，腿的事还没定论呢，先别给自己加新病。</w:t></w:r></w:p><w:p w14:paraId="7E5C7D48"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="584C8CF1"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>13-2 周家旧屋 日 内</w:t></w:r></w:p><w:p w14:paraId="1E8266D2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="09C05B23"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 钥匙转动打开斑驳的木门。屋内光线昏暗，墙皮脱落严重，厨房设施陈旧。</w:t></w:r></w:p><w:p w14:paraId="6C3320E7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾走进屋内，查看窗户和暖气片，神情凝重。周明川站在门口看着她。</w:t></w:r></w:p><w:p w14:paraId="71138949"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（感慨）：前面说的再好听，真看见这种日子，谁都会退。</w:t></w:r></w:p><w:p w14:paraId="1188C295"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾蹲在地上打开黑色工具箱，拿出一块硬纸板和马克笔开始写字。镜头特写纸板，上面写着“电线、龙头、扶手、冰箱、窗锁”。</w:t></w:r></w:p><w:p w14:paraId="1F7A10EB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（疑惑）：你在算什么？</w:t></w:r></w:p><w:p w14:paraId="0E1C6EE4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（专注）：先看看。</w:t></w:r></w:p><w:p w14:paraId="0CCF4EB4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾起身检查吊柜、墙壁插座，并拿出卷尺测量门框宽度。</w:t></w:r></w:p><w:p w14:paraId="5F218E34"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（回头）：你们一直这么住？</w:t></w:r></w:p><w:p w14:paraId="5C688A83"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（点头）：嗯。</w:t></w:r></w:p><w:p w14:paraId="72935C8C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾收起工具，转身向门外走去。周明川看着她的背影，眼神惊讶。</w:t></w:r></w:p><w:p w14:paraId="728FA2A8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（急切）：晓禾！</w:t></w:r></w:p><w:p w14:paraId="428DF381"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾走出楼道，跨上三轮车驶离。画面定格在桌上留下的纸板清单和一只搪瓷杯上。</w:t></w:r></w:p><w:p w14:paraId="4DC2C8F9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 字幕显示“未完待续”。</w:t></w:r></w:p><w:p w14:paraId="2DE70993"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="72BE7268"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第14集</w:t></w:r></w:p><w:p w14:paraId="1DE0F635"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>14-1 纺织厂家属院楼下 日 外</w:t></w:r></w:p><w:p w14:paraId="757EC4F5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、沈曼云、周启山、林晓禾</w:t></w:r></w:p><w:p w14:paraId="278B9001"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老旧红砖楼下的街道上，周明川推着坐在轮椅上的父亲周启山，母亲沈曼云随行在侧。一辆蓝色电动三轮车驶来停在路边，林晓禾坐在车上。</w:t></w:r></w:p><w:p w14:paraId="4D17E9CF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（惊讶）：你不是走了吗？</w:t></w:r></w:p><w:p w14:paraId="07976FE8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（轻松）：不走我去哪买东西？</w:t></w:r></w:p><w:p w14:paraId="00336EC5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾从三轮车上下来，递给周明川一块写有“能修，别扔！”的纸板和一个搪瓷杯。</w:t></w:r></w:p><w:p w14:paraId="4B43AAF9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，沉思）：他写的是房子，还是这个家？</w:t></w:r></w:p><w:p w14:paraId="13D41F71"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（回头，催促）：愣着干什么？搭把手，油挺沉。</w:t></w:r></w:p><w:p w14:paraId="58BEEE5D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾将车后斗的一个沉重的金属油桶递给周明川，周明川接过。</w:t></w:r></w:p><w:p w14:paraId="404C790D"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="51CF2F12"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>14-2 周家旧屋 日 内</w:t></w:r></w:p><w:p w14:paraId="0E2CE52A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="71F69ADD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 屋内光线昏暗，墙皮斑驳脱落。林晓禾正在用螺丝刀拆卸墙壁上的插座面板，桌上摆放着各种维修工具。</w:t></w:r></w:p><w:p w14:paraId="50BB4EFE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 特写镜头显示一根电线外皮焦黑破损。林晓禾拿着坏掉的电线展示给周明川看。</w:t></w:r></w:p><w:p w14:paraId="2380098B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：外皮都焦了，再拖容易起火。</w:t></w:r></w:p><w:p w14:paraId="1071BEC8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（震惊）：这么严重？</w:t></w:r></w:p><w:p w14:paraId="0BE2980A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（专业，一边整理线路一边说）：最危险的两路换掉，厨房单独拉一根。不用全砸墙，钱得花在保命的地方，不是撑面子的地方。</w:t></w:r></w:p><w:p w14:paraId="0E0DEA05"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾蹲在一台老旧的白色双门冰箱前，用螺丝刀卸下背部挡板进行检查。</w:t></w:r></w:p><w:p w14:paraId="7C880BBE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>画外</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>）：这个都坏两年了。</w:t></w:r></w:p><w:p w14:paraId="651A958A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（无奈）：之前找人说修不好。</w:t></w:r></w:p><w:p w14:paraId="1C1DE11E"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="0010B00F"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第15集</w:t></w:r></w:p><w:p w14:paraId="1220A607"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>15-1 周家旧屋 日 内</w:t></w:r></w:p><w:p w14:paraId="246205CC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="22405D40"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 特写镜头，一双沾着油污的手用螺丝刀拨动空调外机风扇。</w:t></w:r></w:p><w:p w14:paraId="3DF3E29A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾蹲在老旧的白色冰箱旁，抬头看向站在一旁的周明川。</w:t></w:r></w:p><w:p w14:paraId="0945396D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（专业，笃定）：压缩机没坏，就启动器烧了。几十块能修好，谁让你买新冰箱谁坑你。</w:t></w:r></w:p><w:p w14:paraId="6DDC8594"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾站起身，拍了拍手上的灰，认真地看着周明川。</w:t></w:r></w:p><w:p w14:paraId="3ECF273E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（语重心长）：以后坏东西先找人看，别一坏就扔。</w:t></w:r></w:p><w:p w14:paraId="5FDD9088"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="5B011E62"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>15-2 纺织厂家属院楼下 日 外</w:t></w:r></w:p><w:p w14:paraId="50E9E7CA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="71522E5D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾将一个金属架子搬上停在路边的蓝色三轮车车斗。</w:t></w:r></w:p><w:p w14:paraId="662DB0AE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站在楼门口看着这一幕，双手叉腰。</w:t></w:r></w:p><w:p w14:paraId="478889E0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（疑惑）：你不是说能修就不扔吗？</w:t></w:r></w:p><w:p w14:paraId="41018678"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾整理车斗里的杂物，回头解释。</w:t></w:r></w:p><w:p w14:paraId="4D78A031"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（干脆）：能修的留，修不动还占地方的，该清就得清。</w:t></w:r></w:p><w:p w14:paraId="782041D5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川靠在树干上，双臂抱胸，似笑非笑地看着她。</w:t></w:r></w:p><w:p w14:paraId="50A2E47E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（调侃）：你这是准备把我家搬空？</w:t></w:r></w:p><w:p w14:paraId="0290830F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾倚在三轮车边，笑着摆摆手。</w:t></w:r></w:p><w:p w14:paraId="290FB9E6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（轻松）：放心，你暂时不按斤卖。</w:t></w:r></w:p><w:p w14:paraId="53F00E85"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="29363154"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>15-3 废品回收站 日 内</w:t></w:r></w:p><w:p w14:paraId="5730BFD2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾</w:t></w:r></w:p><w:p w14:paraId="73C5D369"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 电子秤显示屏特写，数字跳动后定格在“486.7”。</w:t></w:r></w:p><w:p w14:paraId="7CC5B5FA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾数着一叠美元钞票，将其装入透明密封袋中。</w:t></w:r></w:p><w:p w14:paraId="126D11C6"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="5FF37C81"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>15-4 周家旧屋 日 内</w:t></w:r></w:p><w:p w14:paraId="4098F9EC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、沈曼云</w:t></w:r></w:p><w:p w14:paraId="7AEA013C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 屋内光线明亮，沈曼云坐在木质长椅上。林晓禾走进来，将装着钱的袋子放在桌上。</w:t></w:r></w:p><w:p w14:paraId="301B8351"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（疑惑）：这是？</w:t></w:r></w:p><w:p w14:paraId="382241B8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾拿起一张皱巴巴的小票，低头念着上面的数字。</w:t></w:r></w:p><w:p w14:paraId="24ADD6C6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：废品卖了四百八十六，买厨房灯窗锁和防滑垫花了三百一十六，剩一百七。</w:t></w:r></w:p><w:p w14:paraId="624709FA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云站起身，看着林晓禾，眼神中带着心疼。</w:t></w:r></w:p><w:p w14:paraId="18AE6651"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（关切）：你忙一上午工钱都不算？</w:t></w:r></w:p><w:p w14:paraId="3CBFBFA5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾抬起头，脸上露出灿烂的笑容。</w:t></w:r></w:p><w:p w14:paraId="040C407A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（俏皮）：今天是来看看对象家，不是上门接单。</w:t></w:r></w:p><w:p w14:paraId="3A3949EB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云看着林晓禾，若有所思地点点头。</w:t></w:r></w:p><w:p w14:paraId="501CE6FF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云 os（内心独白，欣慰）：他不是不会算。</w:t></w:r></w:p><w:p w14:paraId="424A99D1"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="37481D1D"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第16集</w:t></w:r></w:p><w:p w14:paraId="22A722A6"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>16-1 周家旧屋 日 内</w:t></w:r></w:p><w:p w14:paraId="21B584A6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、林晓禾、周明川、周启山</w:t></w:r></w:p><w:p w14:paraId="0368780A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 屋内光线自然，沈曼云面带微笑看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="5FFB3B59"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云 os（内心独白，欣慰）：他是该算的一分不糊涂，不该拿的一分不伸手。</w:t></w:r></w:p><w:p w14:paraId="21160825"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云转头看向门口方向，喊道。</w:t></w:r></w:p><w:p w14:paraId="6DC1206D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（招呼）：晓禾帮叔推一下。</w:t></w:r></w:p><w:p w14:paraId="666B71BF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾站在门口，双手一摊，表情抗拒。</w:t></w:r></w:p><w:p w14:paraId="4DE08905"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（干脆）：不推。</w:t></w:r></w:p><w:p w14:paraId="1B058812"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站在一旁，面露惊讶神色。</w:t></w:r></w:p><w:p w14:paraId="51FB7E3E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾走到轮椅旁蹲下，伸手捏了捏周启山的小腿肌肉。</w:t></w:r></w:p><w:p w14:paraId="42821D17"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（疑惑）：叔，你这腿不是完全没劲。</w:t></w:r></w:p><w:p w14:paraId="09364DB4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周启山坐在轮椅上，神情略显尴尬。</w:t></w:r></w:p><w:p w14:paraId="0964EB11"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（掩饰）：医生说可以慢慢走几步。</w:t></w:r></w:p><w:p w14:paraId="5A20A4C4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：那更不能天天坐着，越坐肌肉越废。</w:t></w:r></w:p><w:p w14:paraId="6DB74E16"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站在一旁插话。</w:t></w:r></w:p><w:p w14:paraId="5A6C812C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（劝阻）：他腿伤过别逞强。</w:t></w:r></w:p><w:p w14:paraId="5C988D43"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾站起身，直视周启山，语气坚定。</w:t></w:r></w:p><w:p w14:paraId="12EC9065"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（反驳）：就是伤过才得按康复计划动，你们这么伺候，最后真把他伺候废了。</w:t></w:r></w:p><w:p w14:paraId="4C3A1076"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾将助行器推到周启山面前。</w:t></w:r></w:p><w:p w14:paraId="7E19999E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周启山扶着助行器站起身，额头冒汗，眼神惊恐。</w:t></w:r></w:p><w:p w14:paraId="4B7EC715"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山 os（内心独白，惊慌）：这姑娘眼也太毒了，再走两步，我这个长期坐轮椅就穿帮了。</w:t></w:r></w:p><w:p w14:paraId="0474B63B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 特写镜头，周启山穿着黑布鞋的脚微微颤抖地踩在地上。</w:t></w:r></w:p><w:p w14:paraId="227FDE21"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="3F5CCF02"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>16-2 周家餐厅 日 内</w:t></w:r></w:p><w:p w14:paraId="347DEBED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、林晓禾、周明川、周启山</w:t></w:r></w:p><w:p w14:paraId="43E90232"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 四人围坐在木质餐桌旁吃饭，桌上摆着几盘家常菜。墙上挂着“家和万事兴”的书法字画。</w:t></w:r></w:p><w:p w14:paraId="3E098498"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云一边夹菜一边笑着对林晓禾说。</w:t></w:r></w:p><w:p w14:paraId="1966930D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（亲切）：晓禾啊，阿姨说句实在话，真要是以后成了家，我们家条件就这样。</w:t></w:r></w:p><w:p w14:paraId="6BC25DA3"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="7ADA7344"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第17集</w:t></w:r></w:p><w:p w14:paraId="5554BC12"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>17-1 周家餐厅 日 内</w:t></w:r></w:p><w:p w14:paraId="2A3FF00D"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve"> 林晓禾</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r></w:p><w:p w14:paraId="023B378E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 简朴的餐厅内，四人围坐在木质方桌旁吃饭。墙上挂着“家和万事兴”的字画。沈曼云面带愁容看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="6BC9010B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（担忧）：你叔康复也得花钱，可能帮不上你们多少。</w:t></w:r></w:p><w:p w14:paraId="3AF5B034"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾低头看着碗里的饭，语气平静理性。</w:t></w:r></w:p><w:p w14:paraId="160C90E2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷静）：正常看病该花就花，先走医保，优先公立医院，钱越少越不能闭着眼乱花。</w:t></w:r></w:p><w:p w14:paraId="754221D4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云放下筷子，眼神中流露出对未来的焦虑。</w:t></w:r></w:p><w:p w14:paraId="063874FB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（试探）：那以后养老呢？</w:t></w:r></w:p><w:p w14:paraId="5D67D76C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾抬起头，目光坚定地看向沈曼云。</w:t></w:r></w:p><w:p w14:paraId="643C4935"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：该我们出的一分不少，但赌债乱投资亏的，替亲戚担保的坑，谁惹的谁担。</w:t></w:r></w:p><w:p w14:paraId="5E4252A0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周启山坐在轮椅上，面无表情地看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="137951D1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（冷淡）：你分的倒清楚。</w:t></w:r></w:p><w:p w14:paraId="29283FD2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾直视周启山，神色严肃。</w:t></w:r></w:p><w:p w14:paraId="3F55F507"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：善良和傻，是两回事。</w:t></w:r></w:p><w:p w14:paraId="32F5DF11"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川夹起一块菜放入碗中，嘴角微扬，眼神温柔地看向林晓禾。</w:t></w:r></w:p><w:p w14:paraId="14325167"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>os</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（温和）：他不是愿意替谁吃所有苦，他是知道什么苦该一起扛，什么坑不该往里跳。</w:t></w:r></w:p><w:p w14:paraId="5132A86E"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="76E3B484"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>17-2 旧街口馄饨摊 傍 外</w:t></w:r></w:p><w:p w14:paraId="299043D9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、林晓禾、周启山、周明川、女顾客</w:t></w:r></w:p><w:p w14:paraId="22F13920"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 傍晚时分，老街口的馄饨摊热气腾腾。沈曼云系着围裙在锅前忙碌。林晓禾站在红色塑料凳上调整摊位上方的风扇。周启山坐在轮椅上择菜。周明川提着几瓶饮料从远处走来。</w:t></w:r></w:p><w:p w14:paraId="418CC09D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一位身穿米色开衫的女顾客将打包好的馄饨放在桌上，手机支付界面显示收款成功。</w:t></w:r></w:p><w:p w14:paraId="6B1A8D6A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 特写手机屏幕，显示“微信收款108元”。</w:t></w:r></w:p><w:p w14:paraId="59D163C6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>电子音（机械）：微信收款一百零八元。</w:t></w:r></w:p><w:p w14:paraId="24A8A5E1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云惊讶地看着手机，手里拿着抹布。</w:t></w:r></w:p><w:p w14:paraId="2C0C777C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（震惊）：一百零八？他是不是按错了？</w:t></w:r></w:p><w:p w14:paraId="52ABFA9F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾从凳子上跳下，朝着女顾客离开的方向大喊。</w:t></w:r></w:p><w:p w14:paraId="188AAAD6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（焦急）：姐，你等一下！</w:t></w:r></w:p><w:p w14:paraId="4E3EF5B1"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="5059118D"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第18集</w:t></w:r></w:p><w:p w14:paraId="01517AD5"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>18-1 旧街口云吞摊 傍 外</w:t></w:r></w:p><w:p w14:paraId="65116457"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、女顾客、沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="40D35D71"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 傍晚的老街口，路灯初亮。林晓禾穿着背带裤追上刚离开的女顾客。</w:t></w:r></w:p><w:p w14:paraId="458D8931"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 特写手机屏幕，显示微信收款界面金额为¥25.00。</w:t></w:r></w:p><w:p w14:paraId="4424982D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（焦急，指着手机）：一碗云吞8块，您多出了100。</w:t></w:r></w:p><w:p w14:paraId="3B35DCCC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>女顾客（懊恼，拍额头）：哎呀我赶时间，都没注意。</w:t></w:r></w:p><w:p w14:paraId="2B669FBE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：没注意也不能收。您稍等，我让阿姨退给您。</w:t></w:r></w:p><w:p w14:paraId="28A1D7D3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 女顾客转身离开。林晓禾回到摊位前，蹲下检查风扇和炉灶。</w:t></w:r></w:p><w:p w14:paraId="6ECA3A16"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云站在摊位后看着林晓禾，面带微笑。周启山坐在旁边的轮椅上。</w:t></w:r></w:p><w:p w14:paraId="5B76ED54"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云 os（内心独白，欣慰）：我还在想怎么考她，她自己倒把答案一次次摆我面前。</w:t></w:r></w:p><w:p w14:paraId="49D25112"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（疑惑）：还考？</w:t></w:r></w:p><w:p w14:paraId="7D07D701"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（含笑）：先择你的香菜。</w:t></w:r></w:p><w:p w14:paraId="33834858"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾凑近炉灶闻了闻，神色突变，迅速关闭燃气阀门。</w:t></w:r></w:p><w:p w14:paraId="28DD5C6A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：阿姨这摊今天别卖了。</w:t></w:r></w:p><w:p w14:paraId="0919790A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（惊讶）：怎么了？</w:t></w:r></w:p><w:p w14:paraId="615027BD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾蹲下拿起一根黄色的燃气软管展示给沈曼云看，软管表面有明显裂纹。</w:t></w:r></w:p><w:p w14:paraId="0CBABEFA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（解释）：软管老化漏气了。现在味道小，等锅烧热火一大，容易出事。</w:t></w:r></w:p><w:p w14:paraId="2261C707"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾用肥皂水涂抹在接口处，吹出气泡证明漏气。</w:t></w:r></w:p><w:p w14:paraId="227FE7B3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（震惊）：还真漏了。</w:t></w:r></w:p><w:p w14:paraId="1E1331C8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（坚定）：燃气的东西不能凑合。</w:t></w:r></w:p><w:p w14:paraId="4916F4A4"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="52AE2900"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第19集</w:t></w:r></w:p><w:p w14:paraId="6ABA7D67"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>19-1 旧街口云吞摊 傍 外</w:t></w:r></w:p><w:p w14:paraId="2D84A488"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、沈曼云</w:t></w:r></w:p><w:p w14:paraId="4B3FA890"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 傍晚的老街，夕阳余晖洒在石板路上。林晓禾穿着背带工装裤，从一辆蓝色三轮车上搬下一卷黄色的燃气软管。</w:t></w:r></w:p><w:p w14:paraId="2294FA29"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾走到冒着热气的云吞摊前，蹲下检查炉灶接口，用肥皂水涂抹测试，吹出气泡证明漏气。</w:t></w:r></w:p><w:p w14:paraId="729DAD30"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：别省几十块管子钱，拿整条街的安全赌。</w:t></w:r></w:p><w:p w14:paraId="2BA99010"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云站在摊位后，面带微笑地看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="70DAF218"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（关切）：材料多少钱？阿姨给你。</w:t></w:r></w:p><w:p w14:paraId="2C5FA1D6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（抬头）：46。</w:t></w:r></w:p><w:p w14:paraId="64DA449A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（追问）：那工钱呢？总不能让你白忙活一下午。</w:t></w:r></w:p><w:p w14:paraId="60A6043B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（笑着指了指碗）：您刚才给我多盛了两个云吞，抵了。</w:t></w:r></w:p><w:p w14:paraId="127B27F1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云看着林晓禾吃面的背影，眼神中流露出赞赏。</w:t></w:r></w:p><w:p w14:paraId="6C23AE33"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云 os（内心独白，欣慰）：这个姑娘把账算得精，却从没把人情算得刻薄。</w:t></w:r></w:p><w:p w14:paraId="1D0B92CD"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="559F2F3B"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>19-2 城南五金市场 日 内</w:t></w:r></w:p><w:p w14:paraId="12D2D7ED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、老板</w:t></w:r></w:p><w:p w14:paraId="25EA483E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 狭窄拥挤的五金市场巷道，两侧挂满了锁具和管材。周明川推着小车，与换了一身便装（白T恤牛仔裤）的林晓禾并肩走着。</w:t></w:r></w:p><w:p w14:paraId="11D067CB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 两人在一家店铺前停下，周明川拿起一个智能门锁包装盒展示。</w:t></w:r></w:p><w:p w14:paraId="20ADAA66"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（推荐）：这个安全，指纹密码都能开。</w:t></w:r></w:p><w:p w14:paraId="5EC351B0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老板（热情）：活动价两千三。</w:t></w:r></w:p><w:p w14:paraId="22EFB924"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（皱眉，放下盒子）：你家那扇老木门，门框都快酥了，两千三的锁比门贵十倍。</w:t></w:r></w:p><w:p w14:paraId="6E2752AE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（不解）：安全一点不好吗？</w:t></w:r></w:p><w:p w14:paraId="4554301C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（拿起一把挂锁，专业地）：安全看锁芯等级，C级锁芯。</w:t></w:r></w:p><w:p w14:paraId="4BD9EF0B"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="76C09E9C"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第20集</w:t></w:r></w:p><w:p w14:paraId="73A1EF6D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>20-1 五金市场巷道 日 外</w:t></w:r></w:p><w:p w14:paraId="4888261A"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老板</w:t></w:r></w:p><w:p w14:paraId="35637664"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 狭窄拥挤的五金市场巷道，两侧货架挂满锁具和管材。林晓禾手持一个C级锁芯和一卷黄色电线，仔细查看。</w:t></w:r></w:p><w:p w14:paraId="4E9EDA93"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：防技术开启够用了。</w:t></w:r></w:p><w:p w14:paraId="2C0BB042"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站在一旁看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="0B71F7A2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（疑惑）：你对什么都先算值不值，那人呢？</w:t></w:r></w:p><w:p w14:paraId="1CCB64F8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（放下物品，看向周明川）：人不能论价，也不能按斤称，所以更麻烦。</w:t></w:r></w:p><w:p w14:paraId="075A8A56"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾低头数着手中的钞票。</w:t></w:r></w:p><w:p w14:paraId="1AA317E1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老板站在柜台后，手中拿着钞票，面带笑容。</w:t></w:r></w:p><w:p w14:paraId="6D6AF8ED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老板（调侃）：砍价砍得凶，少20你也能看出来。</w:t></w:r></w:p><w:p w14:paraId="77B76C0C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（抬头，严肃）：砍价是商量买卖，少找钱是算错账两回事。</w:t></w:r></w:p><w:p w14:paraId="45E73131"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川注视着林晓禾，眼神中带着思考。</w:t></w:r></w:p><w:p w14:paraId="13B699CE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（内心独白）：他的原则从来不是少花钱，是每一分钱都得来的明白。</w:t></w:r></w:p><w:p w14:paraId="7F82DDE5"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="2FE0294B"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>20-2 超市 日 内</w:t></w:r></w:p><w:p w14:paraId="3DECB74E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、沈曼云</w:t></w:r></w:p><w:p w14:paraId="0AA32E83"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 明亮的超市货架区，周明川推着购物车，车里放着几盒礼品。他拿起一盒标价2000元的礼盒犹豫。</w:t></w:r></w:p><w:p w14:paraId="5271ED10"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川拿出手机进行视频通话，屏幕上显示沈曼云的画面。</w:t></w:r></w:p><w:p w14:paraId="3571C291"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（视频音，催促）：发什么愣，挑好了没？</w:t></w:r></w:p><w:p w14:paraId="124F73EA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（犹豫）：第一次上门，买太便宜会不会失礼？</w:t></w:r></w:p><w:p w14:paraId="2AC2E37C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（视频音，直接）：你现在月薪五千，拎两千的礼才叫露馅。</w:t></w:r></w:p><w:p w14:paraId="224F7448"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川走到水果区，一边听电话一边往袋子里装苹果。</w:t></w:r></w:p><w:p w14:paraId="072A3D75"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（视频音，建议）：就买牛奶水果，吃的掉不浪费。</w:t></w:r></w:p><w:p w14:paraId="18BC5090"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川推着装有牛奶和水果的购物车，对着手机露出苦笑。</w:t></w:r></w:p><w:p w14:paraId="5ED4FF70"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（无奈）：妈，我发现装穷最大的副作用是我开始看超市促销。</w:t></w:r></w:p><w:p w14:paraId="3D522C19"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（视频音，微笑）：这不是副作用。</w:t></w:r></w:p><w:p w14:paraId="0EE3647E"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="743EDD19"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第21集</w:t></w:r></w:p><w:p w14:paraId="24D86570"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>21-1 超市 日 内</w:t></w:r></w:p><w:p w14:paraId="360E89DD"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r></w:p><w:p w14:paraId="5D84ED2F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 明亮的超市货架区，周明川推着购物车，低头看着手机屏幕。手机屏幕上显示沈曼云的视频画面，背景是旧街道。</w:t></w:r></w:p><w:p w14:paraId="319F4D58"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（视频音，微笑）：是过日子的常识。</w:t></w:r></w:p><w:p w14:paraId="31A54BAD"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="368B70CE"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>21-2 晓禾旧货维修店门口 日 外</w:t></w:r></w:p><w:p w14:paraId="204EB1D4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、王姨、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>卷发大妈</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、林小满</w:t></w:r></w:p><w:p w14:paraId="149AC6F5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光洒在老旧的街道上，一家挂着&quot;晓禾旧货维修店&quot;招牌的店铺前，王姨和</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>卷发大妈</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>坐在小板凳上择菜。周明川双手提着两箱牛奶和一袋苹果走来。</w:t></w:r></w:p><w:p w14:paraId="0CB33E52"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>卷发大妈</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（热情八卦）：哟，这就是晓禾对象吧？</w:t></w:r></w:p><w:p w14:paraId="54C5CB38"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>王姨（热情八卦）：第一次上门就两箱牛奶，现在小伙子可真会过日子。</w:t></w:r></w:p><w:p w14:paraId="12BBB99B"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>卷发大妈</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（热情八卦）：听说还是个修车的。晓禾那么能干，怎么就没找个有房有车的？</w:t></w:r></w:p><w:p w14:paraId="7FA1AC71"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川停下脚步，脸上露出尴尬又无奈的神情。此时，林小满拿着扫帚从店内走出，开始清扫地面。</w:t></w:r></w:p><w:p w14:paraId="654AF786"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，失落）：连她弟弟都不让我进。</w:t></w:r></w:p><w:p w14:paraId="306DE6B6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林小满用扫帚将地上的玻璃碎片扫开，挡在周明川脚前。</w:t></w:r></w:p><w:p w14:paraId="1775643C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（急切）：别踩！刚才搬旧冰箱摔了个酱油瓶，扎鞋底你骑车容易打滑。</w:t></w:r></w:p><w:p w14:paraId="5D63266A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林小满转头看向两位老人，语气变得犀利。</w:t></w:r></w:p><w:p w14:paraId="54F801B8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（讽刺）：王姨，你女婿上次拎来的酒，你转头就拿去烟酒店退了，怎么今天反倒教起别人送礼了？</w:t></w:r></w:p><w:p w14:paraId="553635AF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>王姨（不满）：你这孩子怎么说话呢？</w:t></w:r></w:p><w:p w14:paraId="2B1D4592"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（理直气壮）：我姐找对象，又不是开礼品回收店。</w:t></w:r></w:p><w:p w14:paraId="687704CC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林小满从周明川手中接过一箱牛奶，转身向楼上走去。</w:t></w:r></w:p><w:p w14:paraId="404611CD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（轻松）：周哥，走上楼。另一箱你自己拎啊，我腰不值钱。</w:t></w:r></w:p><w:p w14:paraId="44E846A6"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="20735E51"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第22集</w:t></w:r></w:p><w:p w14:paraId="19B32128"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>22-1 街道 日 外</w:t></w:r></w:p><w:p w14:paraId="7C4CA308"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川</w:t></w:r></w:p><w:p w14:paraId="6CB385E2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老旧街道背景虚化，周明川身穿深蓝色工装，面带微笑看着前方。</w:t></w:r></w:p><w:p w14:paraId="177A09D1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，感慨）：嘴跟他姐一样不饶人，护人的方式也一样。</w:t></w:r></w:p><w:p w14:paraId="612E303C"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="6D864A61"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>22-2 林家客厅 日 内</w:t></w:r></w:p><w:p w14:paraId="4FE85CC2"><w:pPr><w:rPr><w:rFonts w:hint="default" w:eastAsiaTheme="minorEastAsia"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r></w:p><w:p w14:paraId="2D84BE1D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光透过窗户洒进朴素的客厅，窗台上摆着几盆鲜花。墙上挂着黑白照片和奖状。</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>坐在餐桌旁，桌上摆着饭菜。地上放着两箱印着“纯牛奶”字样的礼盒和一袋苹果。周明川提着牛奶走进屋内。</w:t></w:r></w:p><w:p w14:paraId="6EDF81C9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>起身，弯腰拿起其中一箱牛奶，递给周明川。</w:t></w:r></w:p><w:p w14:paraId="74B0A966"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，疑惑）：嫌礼太轻？</w:t></w:r></w:p><w:p w14:paraId="1D6D50A3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川双手接过牛奶，面露惊讶和不解。</w:t></w:r></w:p><w:p w14:paraId="023F264F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（困惑）：阿姨，是不是我买的不合适？</w:t></w:r></w:p><w:p w14:paraId="0A815797"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（严肃）：拿回一箱。</w:t></w:r></w:p><w:p w14:paraId="691BEA9B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（不解）：为什么？</w:t></w:r></w:p><w:p w14:paraId="206BD01A"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（语重心长）：你爸腿在康复，喝牛奶补身体，比我们家更需要。我们娘俩喝不了两箱，放过期反倒是浪费。第一次上门有心意就行，以后真过日子，别为了面子乱花钱。</w:t></w:r></w:p><w:p w14:paraId="2F032DDA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，感动）：原来他们一家都这样，嘴上不热，手上从来不占别人便宜。</w:t></w:r></w:p><w:p w14:paraId="339BE8BC"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="6AA98550"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>22-3 林家餐厅 日 内</w:t></w:r></w:p><w:p w14:paraId="63F63D57"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、林小满、林晓禾</w:t></w:r></w:p><w:p w14:paraId="1EBCFDD5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 四人围坐在餐桌旁吃饭。桌上摆放着几盘家常菜。</w:t></w:r></w:p><w:p w14:paraId="4E352A64"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（认真，放下筷子）：没房没车我不是不能接受，我就问一句，以后你爸看病花钱，你妈摆摊受累，这些责任……</w:t></w:r></w:p><w:p w14:paraId="74EF287C"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="02862875"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第23集</w:t></w:r></w:p><w:p w14:paraId="57B7EDD0"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>23-1 林家餐厅 日 内</w:t></w:r></w:p><w:p w14:paraId="6049A837"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、林晓禾、林小满</w:t></w:r></w:p><w:p w14:paraId="3AFDE7CB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 四人围坐在餐桌旁吃饭。桌上摆放着几盘家常菜。墙上挂着黑白照片和奖状。</w:t></w:r></w:p><w:p w14:paraId="1FF4BDAD"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（严肃）：你准备怎么分？</w:t></w:r></w:p><w:p w14:paraId="2238680D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真）：我父母是我的责任，我不会因为结婚就把他们全推给晓禾。</w:t></w:r></w:p><w:p w14:paraId="33A20991"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（郑重）：记住你今天说的话。</w:t></w:r></w:p><w:p w14:paraId="40FF96B8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾放在桌上的手机响起，屏幕显示来电人&quot;陈奶奶&quot;。</w:t></w:r></w:p><w:p w14:paraId="0AFA7C9E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（接起电话，焦急）：晓禾啊。</w:t></w:r></w:p><w:p w14:paraId="21D18556"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>陈奶奶（电话音，焦急）：晓禾啊，你快过来看看吧，我家热水器一直滴滴的报警，屋里头都闻着焦糊味了。</w:t></w:r></w:p><w:p w14:paraId="3632162D"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（关切）：饭都凉了，吃两口再去。</w:t></w:r></w:p><w:p w14:paraId="1453BADF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾放下筷子，迅速起身拿起旁边的帆布工具包。</w:t></w:r></w:p><w:p w14:paraId="4EC10282"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（急切）：老人一个人在家，焦味不能等。</w:t></w:r></w:p><w:p w14:paraId="26C316EE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（果断，起身）：我跟你去。</w:t></w:r></w:p><w:p w14:paraId="40CD91CD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（惊讶）：你来做客的。</w:t></w:r></w:p><w:p w14:paraId="74B442B0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（微笑）：做客也长了手。</w:t></w:r></w:p><w:p w14:paraId="2CDB37D3"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="3315F499"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>23-2 街道 日 外</w:t></w:r></w:p><w:p w14:paraId="52AEE6D2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="36580546"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川和林晓禾快步走在街道上，林晓禾提着工具包。</w:t></w:r></w:p><w:p w14:paraId="4DD7F1EE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 两人穿过一条老旧的小巷，来到一扇贴有&quot;福&quot;字的木门前。</w:t></w:r></w:p><w:p w14:paraId="1DDCC9C5"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="645095BB"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>23-3 陈奶奶家厨房 日 内</w:t></w:r></w:p><w:p w14:paraId="0FB84358"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、陈奶奶</w:t></w:r></w:p><w:p w14:paraId="5F59AA00"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 厨房内弥漫着淡淡的烟雾，墙上挂着一台老旧的白色燃气热水器。</w:t></w:r></w:p><w:p w14:paraId="0E5EA0EB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾蹲下打开工具包拿出万用表，周明川在一旁协助。</w:t></w:r></w:p><w:p w14:paraId="396BC494"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>陈奶奶（焦急）：晓禾啊，是不是得换新的？之前卖热水器的说我这台太老了，早晚要坏。</w:t></w:r></w:p><w:p w14:paraId="60DC28B6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾专注地用万用表检测热水器内部线路。</w:t></w:r></w:p><w:p w14:paraId="7769434D"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="7B497FF2"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第24集</w:t></w:r></w:p><w:p w14:paraId="2B7B793D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>24-1 陈奶奶家厨房 日 内</w:t></w:r></w:p><w:p w14:paraId="0EE56BA7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、陈奶奶</w:t></w:r></w:p><w:p w14:paraId="45AAFCC0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老旧的厨房内，阳光透过窗户洒在地砖上。林晓禾蹲在地上，手持万用表检测墙上的燃气热水器线路。周明川站在她身旁，手里拿着钳子协助。</w:t></w:r></w:p><w:p w14:paraId="78676010"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（专注）：水箱没漏，镁棒也还能用，换端子重新压线就行。</w:t></w:r></w:p><w:p w14:paraId="6E42389C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真）：接电线也松了，一起重做，老人家用着安全。</w:t></w:r></w:p><w:p w14:paraId="327FB680"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 两人配合默契地修理线路。陈奶奶站在一旁看着他们，脸上露出欣慰的笑容。</w:t></w:r></w:p><w:p w14:paraId="70033428"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>陈奶奶（打趣）：你们俩这默契，跟两口子开夫妻维修店似的。</w:t></w:r></w:p><w:p w14:paraId="7AF5CD78"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（笑着抬头）：奶奶，机器能修好，话就别乱修了。</w:t></w:r></w:p><w:p w14:paraId="251C247D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（微笑）：我觉得这句话不用修。</w:t></w:r></w:p><w:p w14:paraId="1B700261"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾瞥了周明川一眼，眼神中带着几分无奈和笑意。</w:t></w:r></w:p><w:p w14:paraId="6D14235C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，轻松）：嘴皮了点，但真让他跟着干脏活，他一点没躲。</w:t></w:r></w:p><w:p w14:paraId="580220A0"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="142F22CE"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>24-2 老街巷口 夜 外</w:t></w:r></w:p><w:p w14:paraId="4A31EDBA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、芬姨、赵凯</w:t></w:r></w:p><w:p w14:paraId="451BE680"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜幕降临，昏黄的路灯照亮狭窄的街道。一辆黑色轿车停在路边。林晓禾和周明川并肩走在路上。</w:t></w:r></w:p><w:p w14:paraId="11C75AC5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 芬姨迎面走来，身后跟着一位身穿黑色T恤的壮实男子。</w:t></w:r></w:p><w:p w14:paraId="687DED17"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>芬姨（热情）：晓禾真巧，赵老板正好路过这边，我领他过来认识认识。</w:t></w:r></w:p><w:p w14:paraId="749C565E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 画面闪过竖排字幕“汽修工赵凯”。赵凯面带微笑，主动向周明川伸出手。</w:t></w:r></w:p><w:p w14:paraId="273B7DFC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（爽朗）：听芬姨说你也做汽修，同行。</w:t></w:r></w:p><w:p w14:paraId="6AAE188C"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（握手，平静）：修车的</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="6BB264C4"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（随意）：在哪家店？</w:t></w:r></w:p><w:p w14:paraId="69353399"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（平静）：街边小店。</w:t></w:r></w:p><w:p w14:paraId="39721B05"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（随意）：那挺辛苦，技术再好……</w:t></w:r></w:p><w:p w14:paraId="3FA04BA6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯的话未说完，眼神中带着一丝审视看向周明川。</w:t></w:r></w:p><w:p w14:paraId="5A9878D4"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="16B6CDD1"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第25集</w:t></w:r></w:p><w:p w14:paraId="1D6EB6D6"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>25-1 老街巷口 夜 外</w:t></w:r></w:p><w:p w14:paraId="3B64B98C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、赵凯、外卖员、周明川</w:t></w:r></w:p><w:p w14:paraId="574D80EC"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜晚的街道，路灯昏黄。林晓禾站在路边，神情略显凝重。</w:t></w:r></w:p><w:p w14:paraId="00139255"><w:pPr><w:rPr><w:rFonts w:hint="default" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>（</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>画外，讽刺</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>）：</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>说到底也是手艺拿死工资。</w:t></w:r></w:p><w:p w14:paraId="14A0AFB0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，困惑）：话是笑着说的，怎么听着这么硌耳朵。</w:t></w:r></w:p><w:p w14:paraId="1D77D618"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一名身穿黄色制服的外卖员骑着电动车急停在路边，神色慌张地看着旁边一辆黑色轿车。</w:t></w:r></w:p><w:p w14:paraId="6CC08096"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>外卖员（惊慌，双手合十）：老板对不起，我真不是故意的，多少钱我赔。</w:t></w:r></w:p><w:p w14:paraId="424F507D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯蹲在车旁检查车门划痕，站起身来一脸不屑地看着外卖员。</w:t></w:r></w:p><w:p w14:paraId="0F59A787"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（轻蔑，指着车身）：我这车刚提两个月，你赔得起吗？去4S店喷漆，最少三千。</w:t></w:r></w:p><w:p w14:paraId="39A1579F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>外卖员（绝望，声音颤抖）：三千</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>？</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>我这大半个月都挣不到这么多？</w:t></w:r></w:p><w:p w14:paraId="49B9DCA5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川穿着深蓝色工装蹲在车旁，手持喷壶和抹布正在擦拭车门上的白色痕迹。林晓禾站在一旁观看。</w:t></w:r></w:p><w:p w14:paraId="55AC61C3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站起身，拍了拍手，看着赵凯。</w:t></w:r></w:p><w:p w14:paraId="23808E20"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（平静）：没掉漆，是塑料箱转印，擦掉就行。</w:t></w:r></w:p><w:p w14:paraId="5AB21DBD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（质疑，皱眉）：表面擦掉了，谁知道里面有没有暗伤。</w:t></w:r></w:p><w:p w14:paraId="15782261"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷笑，看向赵凯）：车门轻轻蹭一下能有什么暗伤？总不能蹭一下车架都变形吧。</w:t></w:r></w:p><w:p w14:paraId="07F3590A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（傲慢，昂起头）：我这车贵，跟普通车不一样。</w:t></w:r></w:p><w:p w14:paraId="3A16A9DC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（直视赵凯，语气坚定）：车贵没关系，人别跟着掉价。</w:t></w:r></w:p><w:p w14:paraId="35E92402"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（愣住，干笑）：呵呵。</w:t></w:r></w:p><w:p w14:paraId="2F265CF4"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="678E580C"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第26集</w:t></w:r></w:p><w:p w14:paraId="2DBF4F9D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>26-1 老街巷口 夜 外</w:t></w:r></w:p><w:p w14:paraId="391E0266"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：赵凯、林晓禾</w:t></w:r></w:p><w:p w14:paraId="7408DF39"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜晚的街道，路灯昏黄。赵凯站在一辆黑色轿车旁，面带戏谑的笑容看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="06E3F85A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（开玩笑，轻松）：开个玩笑，小伙子技术不错。</w:t></w:r></w:p><w:p w14:paraId="018DCA77"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯看向林晓禾身后的门口，做出邀请的手势。</w:t></w:r></w:p><w:p w14:paraId="38C38695"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（调侃）：芬姨都来了，不请我们进去坐会儿？</w:t></w:r></w:p><w:p w14:paraId="0FC6F0DB"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="7BF7CB9A"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>26-2 林晓禾家客厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="64A7EC80"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：赵凯、林晓禾、周明川、芬姨</w:t></w:r></w:p><w:p w14:paraId="18EC989F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 温馨的客厅内，餐桌上摆着几盘家常菜。赵凯手捧一束粉色玫瑰花走进屋内，将花束放在桌上。</w:t></w:r></w:p><w:p w14:paraId="483C1233"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯转身面对镜头，神情变得认真且带有优越感。</w:t></w:r></w:p><w:p w14:paraId="3FA3D122"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（直白，自信）：晓禾我话说直一点，你没必要跟一个月薪五千的人熬日子。</w:t></w:r></w:p><w:p w14:paraId="69723B80"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头切到周明川穿着深蓝色工装的特写，他双手紧握成拳，指节发白。</w:t></w:r></w:p><w:p w14:paraId="14B7D6E1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（炫耀）：我有房有车三家店。</w:t></w:r></w:p><w:p w14:paraId="0A2F5626"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯继续对着林晓禾和周明川的方向说话，语气轻蔑。</w:t></w:r></w:p><w:p w14:paraId="0AE402F9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（傲慢）：你跟我在一起，这个旧货店直接就能关了。女孩子家家的，犯不上天天搬冰箱钻灰堆。</w:t></w:r></w:p><w:p w14:paraId="3F447F65"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 芬姨拉着林晓禾的手臂，满脸堆笑地看向赵凯，又转头看向林晓禾。</w:t></w:r></w:p><w:p w14:paraId="68964B27"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>芬姨（赞许，热情）：你看赵凯多会疼人。</w:t></w:r></w:p><w:p w14:paraId="753C53E3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川低着头，眼神黯淡，嘴角露出一丝苦涩的自嘲。</w:t></w:r></w:p><w:p w14:paraId="1487D921"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>os</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（自嘲，低沉）：这才是正常人会选的条件吧。</w:t></w:r></w:p><w:p w14:paraId="2E145B44"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 三人站在客厅中央对峙，气氛凝重。地上放着两箱纯牛奶和一袋水果。赵凯逼近林晓禾一步。</w:t></w:r></w:p><w:p w14:paraId="26A31F26"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（逼迫）：你好好考虑一下。</w:t></w:r></w:p><w:p w14:paraId="67EE5BEA"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="1E5B0EB1"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第27集</w:t></w:r></w:p><w:p w14:paraId="31E8281D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>27-1 林晓禾家客厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="58CF2C9B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、赵凯、周明川</w:t></w:r></w:p><w:p w14:paraId="4A03D4BD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 温馨的客厅内，餐桌上摆着几盘家常菜。赵凯手捧一束粉色玫瑰花站在桌前，林晓禾站在他对面，周明川身穿深蓝色工装站在后方，神情略显局促。地上放着两箱纯牛奶和一袋苹果。</w:t></w:r></w:p><w:p w14:paraId="6910378D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静，直视赵凯）：你的条件确实比他好。</w:t></w:r></w:p><w:p w14:paraId="2B9859BF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯脸上露出得意的笑容，身体微微前倾。</w:t></w:r></w:p><w:p w14:paraId="22B1947C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（语气平稳，列举事实）：房子新车也新，三家连锁店，家底厚。</w:t></w:r></w:p><w:p w14:paraId="455D2575"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（自信，带着优越感）：所以你没必要跟着一个修车工吃苦。</w:t></w:r></w:p><w:p w14:paraId="2F71D40E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（眼神坚定，语气认真）：可我找对象不是去招聘网站挑配置。</w:t></w:r></w:p><w:p w14:paraId="32511345"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯愣了一下，随即轻笑一声。</w:t></w:r></w:p><w:p w14:paraId="160BD5AB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（继续说道，神情严肃）：还有我的店干的挺好，你第一次正经跟我说话就让我把它关了。</w:t></w:r></w:p><w:p w14:paraId="55BA8F04"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（皱眉，急切地辩解）：我是让你享福。</w:t></w:r></w:p><w:p w14:paraId="6C8EBAA2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（目光锐利，一字一顿）：在你眼里是享福，在我这是丢饭碗。</w:t></w:r></w:p><w:p w14:paraId="5551A268"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾转身拿起桌上的一个红苹果，咬了一口，看向身旁的周明川。</w:t></w:r></w:p><w:p w14:paraId="6D951441"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾嚼着苹果。</w:t></w:r></w:p><w:p w14:paraId="5FFBA6CA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（语气轻松却坚定）：我先跟这个穷的继续处。</w:t></w:r></w:p><w:p w14:paraId="77F57399"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川听到这话，原本紧张的脸上露出了惊喜和感动的笑容。</w:t></w:r></w:p><w:p w14:paraId="64C18B2E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>os</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（内心独白，轻声自语，带笑意）：这个穷的，怎么听着还挺顺眼。</w:t></w:r></w:p><w:p w14:paraId="0E87CA39"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯脸色瞬间变得难看，他猛地向前一步，双手撑在桌上，怒视林晓禾。</w:t></w:r></w:p><w:p w14:paraId="2F4A4F69"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（愤怒，咬牙切齿）：晓禾，你会后悔的。</w:t></w:r></w:p><w:p w14:paraId="6BE71F1D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾淡定地看着他。</w:t></w:r></w:p><w:p w14:paraId="74D9CA66"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（继续吃苹果）：坏了再修，现在还没坏。</w:t></w:r></w:p><w:p w14:paraId="5885F5D2"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="3A88CB1C"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第28集</w:t></w:r></w:p><w:p w14:paraId="21B2571C"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>28-1 林晓禾家客厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="0166F4CD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：赵凯、周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="66BECCA5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 温馨的客厅内，餐桌上摆着饭菜。赵凯身穿黑色T恤转身走向门口，周明川身穿深蓝色工装站在桌旁看着赵凯离开，林晓禾坐在桌边。</w:t></w:r></w:p><w:p w14:paraId="68E9D904"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯走出房门，周明川目送他离开后露出微笑。</w:t></w:r></w:p><w:p w14:paraId="4E799F36"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="398CF6D6"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>28-2 河边公路 夜 外</w:t></w:r></w:p><w:p w14:paraId="0DFE5037"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="1E19D913"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜晚的河边公路，路灯昏黄，路面湿润。林晓禾驾驶着一辆蓝色电动三轮车，周明川坐在后车斗里。</w:t></w:r></w:p><w:p w14:paraId="1C6A553E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川伸手整理车斗里的纸箱。</w:t></w:r></w:p><w:p w14:paraId="296B19E4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（试探）：你真不怕我条件差？</w:t></w:r></w:p><w:p w14:paraId="13AFEF74"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静）：怕。</w:t></w:r></w:p><w:p w14:paraId="617C370E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（疑惑）：那你还选我？</w:t></w:r></w:p><w:p w14:paraId="425C23C7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：我天天收旧货，旧不旧不重要，先看坏没坏。</w:t></w:r></w:p><w:p w14:paraId="0DE883B9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（追问）：那我呢？</w:t></w:r></w:p><w:p w14:paraId="150ADFF3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（微笑）：暂时没坏。</w:t></w:r></w:p><w:p w14:paraId="411B8620"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（调侃）：只是暂时？</w:t></w:r></w:p><w:p w14:paraId="557E0CCE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（俏皮）：勉强能修。</w:t></w:r></w:p><w:p w14:paraId="1CF6686B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（轻笑）：我是不是还得谢谢林师傅高抬贵手？</w:t></w:r></w:p><w:p w14:paraId="7D946197"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（得意）：知道就好。</w:t></w:r></w:p><w:p w14:paraId="78FF88ED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 天空突然下起雨，周明川从身后拿出一把折叠伞撑开，伞面有些歪斜变形。</w:t></w:r></w:p><w:p w14:paraId="34E04366"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，温暖）：伞都歪成这样了还装没事。这个人，至少不只会说。</w:t></w:r></w:p><w:p w14:paraId="18CACDC3"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="53D96D91"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>28-3 晓禾旧货维修店门口 日 外</w:t></w:r></w:p><w:p w14:paraId="013F1A94"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林小满、收废品老人、林晓禾</w:t></w:r></w:p><w:p w14:paraId="45ADFEFE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 白天，店铺招牌写着“晓禾旧货维修店”。林小满身穿白色T恤正在帮一位推着手推车的老人称重纸箱。</w:t></w:r></w:p><w:p w14:paraId="50FA89D5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 电子秤显示屏数字跳动。</w:t></w:r></w:p><w:p w14:paraId="73ADD7D0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（报数）：37点6。</w:t></w:r></w:p><w:p w14:paraId="55A0BB1F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾身穿背带裤靠在门框上，笑着看向这边。</w:t></w:r></w:p><w:p w14:paraId="72AE8671"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（爽快）：算40。</w:t></w:r></w:p><w:p w14:paraId="72BDCA23"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="776C5EB2"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第29集</w:t></w:r></w:p><w:p w14:paraId="2355F532"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>29-1 晓禾旧货维修店门口 日 外</w:t></w:r></w:p><w:p w14:paraId="32050052"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：收废品老人、周明川、林小满</w:t></w:r></w:p><w:p w14:paraId="51EC18CB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 白天，店铺招牌写着&quot;晓禾旧货维修店&quot;。收废品老人推着装满纸箱的手推车停在店门口，电子秤显示37.6公斤。周明川身穿深蓝色工装站在一旁，林小满身穿白色T恤站在老人对面。</w:t></w:r></w:p><w:p w14:paraId="1EE94D56"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（疑惑）：电子秤摆在眼前，他怎么还故意多算。</w:t></w:r></w:p><w:p w14:paraId="3A66D7C9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>收废品老人（诚恳）：晓禾按秤算就行，别每次多给你。</w:t></w:r></w:p><w:p w14:paraId="581FA333"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="49D7C607"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>29-2 晓禾旧货维修店门口 日 外</w:t></w:r></w:p><w:p w14:paraId="719E5D91"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、收废品老人</w:t></w:r></w:p><w:p w14:paraId="6989DCF2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾身穿白色背心和卡其色背带裤靠在门框上，微笑着看向老人。阳光从她身后洒下。</w:t></w:r></w:p><w:p w14:paraId="04230887"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（爽快）：你这纸箱晒得干没掺水，价本来就该高一点。</w:t></w:r></w:p><w:p w14:paraId="3A7E1E03"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 收废品老人接过钱，数了数后转身离开，脸上带着感激的笑容。</w:t></w:r></w:p><w:p w14:paraId="4FFC92CC"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="12E8A7DD"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>29-3 晓禾旧货维修店内 日 内</w:t></w:r></w:p><w:p w14:paraId="6F41F8AD"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾</w:t></w:r></w:p><w:p w14:paraId="5A9EC8BB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 店内摆满了旧电视机和各种电器零件。周明川走到电子秤前，指着显示屏。</w:t></w:r></w:p><w:p w14:paraId="6740DF90"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（不解）：明明三十七点六。</w:t></w:r></w:p><w:p w14:paraId="4BCC49D4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静）：我知道。</w:t></w:r></w:p><w:p w14:paraId="346F8126"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（追问）：那你说四十。</w:t></w:r></w:p><w:p w14:paraId="2FAF5058"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：老头凌晨四点就在翻垃圾桶，家里还有个瘫痪老伴，多两公斤纸壳，穷不死我。</w:t></w:r></w:p><w:p w14:paraId="4EC00670"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（建议）：你可以直接送他钱。</w:t></w:r></w:p><w:p w14:paraId="4967F939"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（摇头）：他不要，有的人要的是多几块钱，不是被别人当可怜人。</w:t></w:r></w:p><w:p w14:paraId="24B2D064"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（感慨）：她连帮人都知道给人留体面。</w:t></w:r></w:p><w:p w14:paraId="1F0B8D67"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="6E875FB5"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>29-4 晓禾旧货维修店内 日 内</w:t></w:r></w:p><w:p w14:paraId="649D4384"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、老奶奶、林小满</w:t></w:r></w:p><w:p w14:paraId="4FCEDC1E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一位身穿红色碎花上衣的老奶奶将一个木制柜子推到店里，林晓禾递给她钱。老奶奶离开后，林晓禾用螺丝刀修理柜子抽屉。</w:t></w:r></w:p><w:p w14:paraId="675EE0FB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 抽屉突然掉落，一个花色手包从里面滑出掉在地上。</w:t></w:r></w:p><w:p w14:paraId="5E4D848E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林小满跑过来捡起手包，拉开拉链，里面露出一沓现金和一个金手镯，他露出震惊的表情。</w:t></w:r></w:p><w:p w14:paraId="2EA9B2FD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（震惊）：姐这柜子三百收的。</w:t></w:r></w:p><w:p w14:paraId="6BA28088"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="007D5431"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第30集</w:t></w:r></w:p><w:p w14:paraId="1775D2CE"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>30-1 晓禾旧货维修店内 日 内</w:t></w:r></w:p><w:p w14:paraId="06979467"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林小满、林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="3B69D38E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林小满身穿白色T恤，瞪大眼睛一脸震惊地看着手中的东西。随后镜头切换，他换上绿白格子衬衫，笑着说话。</w:t></w:r></w:p><w:p w14:paraId="5360AE3B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（震惊，调侃）：里面值五万多，老太太自己都不知道吧。</w:t></w:r></w:p><w:p w14:paraId="316FECAE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾身穿白色背心和卡其色背带裤，手持写字板，焦急地询问。</w:t></w:r></w:p><w:p w14:paraId="3508D40F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（焦急）：刚才那个奶奶电话。</w:t></w:r></w:p><w:p w14:paraId="147EEED6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（无奈）：留的是座机，打不通。</w:t></w:r></w:p><w:p w14:paraId="7B99AA4E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（追问）：地址呢？</w:t></w:r></w:p><w:p w14:paraId="1958E2D7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（回答）：老钢厂家属区三栋。</w:t></w:r></w:p><w:p w14:paraId="0FB4B0DB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（果断）：走。</w:t></w:r></w:p><w:p w14:paraId="660A10EB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川身穿深蓝色工装，神情凝重，眼神深邃，似乎在沉思。</w:t></w:r></w:p><w:p w14:paraId="7FE6997B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，深沉）：没有我妈，没有摄像头，也没人知道，这才是真正的答案。</w:t></w:r></w:p><w:p w14:paraId="72C1122C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 三人快步走出店铺，林晓禾提着那个花色手包跑在前面。</w:t></w:r></w:p><w:p w14:paraId="7AD5FADD"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="5BE4BAAA"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>30-2 老钢厂家属区楼道 日 内</w:t></w:r></w:p><w:p w14:paraId="5E5459EE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、老奶奶</w:t></w:r></w:p><w:p w14:paraId="5D70A2E3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 斑驳的楼道里，阳光从窗户射入。老奶奶正拿着钥匙开门，林晓禾气喘吁吁地跑上来拦住她。</w:t></w:r></w:p><w:p w14:paraId="776360FF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（急切，擦汗）：奶奶，你柜子夹层里是不是藏东西了？</w:t></w:r></w:p><w:p w14:paraId="5ACC640F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 特写镜头，老奶奶打开手包，里面露出一沓美元现金和一个金手镯。</w:t></w:r></w:p><w:p w14:paraId="171A161C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老奶奶（含泪，激动）：这是我给孙女存的嫁妆钱。我老糊涂了，都忘了藏在夹层。</w:t></w:r></w:p><w:p w14:paraId="5B67DA84"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老奶奶从包里拿出一沓钱递给林晓禾。</w:t></w:r></w:p><w:p w14:paraId="7AEF9567"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（推辞）：别，拿回去。</w:t></w:r></w:p><w:p w14:paraId="380EDE8D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老奶奶（坚持，流泪）：姑娘，你救了我这么大一笔钱，不拿我心里过不去。</w:t></w:r></w:p><w:p w14:paraId="1687533E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（微笑，温和）：真过不去，以后纸箱还卖给我就行。</w:t></w:r></w:p><w:p w14:paraId="027991D1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 老奶奶叹了口气，从包里掏出一枚硬币递过去。</w:t></w:r></w:p><w:p w14:paraId="5FA1F1CF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老奶奶（宽慰）：那拿一块，讨个好彩头。</w:t></w:r></w:p><w:p w14:paraId="50836D12"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="43C99C63"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第31集</w:t></w:r></w:p><w:p w14:paraId="135C3044"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>31-1 老楼走廊 日 内</w:t></w:r></w:p><w:p w14:paraId="010C1390"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、老奶奶</w:t></w:r></w:p><w:p w14:paraId="3A847F68"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 斑驳的老楼走廊里，光线从窗户射入。林晓禾身穿白色背心和卡其色背带裤，掌心托着一枚硬币，面带微笑看着对面的老奶奶。</w:t></w:r></w:p><w:p w14:paraId="7B35C34F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>老奶奶（慈祥）：那拿一块讨个好彩头。</w:t></w:r></w:p><w:p w14:paraId="76CC7065"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头切换，周明川身穿深蓝色工装站在一旁，眉头微皱，眼神疑惑地看着这一幕。</w:t></w:r></w:p><w:p w14:paraId="5BF88639"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（疑惑）：</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>她</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>怎么又收？</w:t></w:r></w:p><w:p w14:paraId="6F00D8E2"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="6FB79AAB"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>31-2 晓禾旧货维修店 日 内</w:t></w:r></w:p><w:p w14:paraId="29E7D98B"><w:pPr><w:rPr><w:rFonts w:hint="default" w:eastAsiaTheme="minorEastAsia"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、林小满、周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>马尾女顾客</w:t></w:r></w:p><w:p w14:paraId="5CA6F4C6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修店内堆满了旧电器和工具。林晓禾走到工作台前，拉开抽屉拿出一个贴有红心标签的玻璃罐，将手中的硬币投入其中。罐身标签写着“老人小修免工费”。</w:t></w:r></w:p><w:p w14:paraId="296E59AC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静）：他不让我空手回来，我也不让这钱进我兜。</w:t></w:r></w:p><w:p w14:paraId="7BE5E70A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林小满身穿白色T恤走近，笑着看向玻璃罐。</w:t></w:r></w:p><w:p w14:paraId="23BB6D43"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（调侃）：姐，你这罐子快满了。</w:t></w:r></w:p><w:p w14:paraId="58B5F5D6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（轻松）：满了就换大的。</w:t></w:r></w:p><w:p w14:paraId="7F14F013"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站在不远处，目光紧紧盯着林晓禾，神情有些复杂。林晓禾察觉到目光，转头看向他。</w:t></w:r></w:p><w:p w14:paraId="5DCDCF7D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（好奇）：你今天怎么老盯着我？</w:t></w:r></w:p><w:p w14:paraId="599C0CFA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真）：在想一件事。</w:t></w:r></w:p><w:p w14:paraId="56044F89"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾坐在工作台前，拿起螺丝刀开始修理电路板，嘴角上扬。</w:t></w:r></w:p><w:p w14:paraId="20B744AA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（玩笑）：想我给你涨工资？</w:t></w:r></w:p><w:p w14:paraId="1525AC6A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川也拿起工具，脸上露出灿烂的笑容，随即眼神变得坚定。</w:t></w:r></w:p><w:p w14:paraId="108B67A1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（戏谑，转为认真）：想我妈要是再敢说考你，我先把她考场拆了。</w:t></w:r></w:p><w:p w14:paraId="1CB23498"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（打趣）：你妈摆个云吞摊，你口气倒挺大。</w:t></w:r></w:p><w:p w14:paraId="5616E30A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，深情，愧疚）：越喜欢她，越觉得我这句谎话扎得慌。</w:t></w:r></w:p><w:p w14:paraId="324240F6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 场景转换，</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>马尾女顾客穿着</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>一件白色衬衫和牛仔裤，抱着一台咖啡机放在桌上。</w:t></w:r></w:p><w:p w14:paraId="76744E53"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>马尾女顾客</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（干练）：能修就修，不行我就换，你看着办。</w:t></w:r></w:p><w:p w14:paraId="429E01EC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川低头专注地拆卸咖啡机零件，用刷子清理灰尘。林小满凑过来，一脸不解。</w:t></w:r></w:p><w:p w14:paraId="61C4D4C4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（疑惑）：周哥，客户都说能换了，你给他换整套，店里不是赚更多？</w:t></w:r></w:p><w:p w14:paraId="7C119010"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（专注，坚定）：坏哪修哪，没坏的为什么一起扔？</w:t></w:r></w:p><w:p w14:paraId="4769B9E9"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="61A40E8C"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第32集</w:t></w:r></w:p><w:p w14:paraId="056F6FC4"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>32-1 晓禾旧货维修店 日 内</w:t></w:r></w:p><w:p w14:paraId="5F6B5368"><w:pPr><w:rPr><w:rFonts w:hint="default"/><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林小满、林晓禾、周明川、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>马尾女顾客、绿衬衫学徒</w:t></w:r></w:p><w:p w14:paraId="16628348"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修店内光线明亮，货架上摆满了旧电视机。林小满身穿白色T恤，倚靠在货架旁，笑着看向对面。</w:t></w:r></w:p><w:p w14:paraId="01A83FE2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（调侃，笑容灿烂）：你跟我姐越来越像了。</w:t></w:r></w:p><w:p w14:paraId="76102E06"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向门口，逆光中林晓禾身穿卡其色背带裤走进店内，神情若有所思。</w:t></w:r></w:p><w:p w14:paraId="4FE2478B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，温柔）：他不是为了讨我喜欢才这么说，背着我，他也是这么做。</w:t></w:r></w:p><w:p w14:paraId="3FA97445"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川身穿深蓝色工装坐在工作台前，将一叠钞票推给面前的</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>马尾女顾客</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>，手中拿着一个黑色的胶圈展示。</w:t></w:r></w:p><w:p w14:paraId="2EEA9923"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>马尾女顾客</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（惊讶）：这么便宜？</w:t></w:r></w:p><w:p w14:paraId="11219C6C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（自信，微笑）：坏的是胶圈，不是你的钱包。</w:t></w:r></w:p><w:p w14:paraId="04E8B7AC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 画面闪回或转场，林小满换上了绿色格纹衬衫，双手捧着一台老式收音机，不慎手滑。</w:t></w:r></w:p><w:p w14:paraId="0ABA025E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 收音机重重摔在地上，瞬间裂成两半，发出巨大的碎裂声。</w:t></w:r></w:p><w:p w14:paraId="2D5214A8"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>绿衬衫学徒</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（惊慌，手足无措）：老板要不我赔，我这个月工资扣完也行。</w:t></w:r></w:p><w:p w14:paraId="0C6E7EFF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾蹲下身查看碎裂的收音机，抬头看向</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>绿衬衫学徒</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="41183E28"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：你故意摔的？</w:t></w:r></w:p><w:p w14:paraId="0B9E3AF7"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>绿衬衫学徒</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（急忙摆手）：不是。</w:t></w:r></w:p><w:p w14:paraId="32067B96"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真）：那先想怎么修，不是先想怎么扣钱。</w:t></w:r></w:p><w:p w14:paraId="41DE7C9F"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>绿衬衫学徒</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（担忧）：可客户要是不同意怎么办？</w:t></w:r></w:p><w:p w14:paraId="5B9BD45F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（坚定）：我们一起道歉，店里的活，店里先担责任。</w:t></w:r></w:p><w:p w14:paraId="54FB3765"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 三人围坐在工作台前修理收音机。周明川在打磨外壳，林晓禾在涂抹胶水，</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>绿衬衫学徒</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>在一旁整理零件。</w:t></w:r></w:p><w:p w14:paraId="5C199534"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（温和）：一点工资都不扣？</w:t></w:r></w:p><w:p w14:paraId="19EDA702"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（专注，语重心长）：犯错要记，但不能一出错就让学徒一个人扛。</w:t></w:r></w:p><w:p w14:paraId="16671CF9"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="22A9DB5B"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第33集</w:t></w:r></w:p><w:p w14:paraId="75A4A36D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>33-1 维修店 日 内</w:t></w:r></w:p><w:p w14:paraId="42A4C077"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="273582ED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光透过窗户洒进充满工具的维修店，空气中漂浮着微尘。林晓禾坐在工作台前，手持工具专注地修理一台旧收音机。周明川站在一旁看着她。</w:t></w:r></w:p><w:p w14:paraId="36E1B260"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（疑惑）：真这么干，以后谁还敢学手艺？</w:t></w:r></w:p><w:p w14:paraId="53171770"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>os</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（平静）：他对旧东西有耐心，对犯过错的人也一样。可这份耐心，不知道会不会留给我。</w:t></w:r></w:p><w:p w14:paraId="35361475"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真，手中动作不停）：错了就认，能补就补，藏着才最麻烦。</w:t></w:r></w:p><w:p w14:paraId="315B900F"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="2EEC9DDC"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>33-2 周家别墅书房 日 内</w:t></w:r></w:p><w:p w14:paraId="4B96EFD6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、沈曼云、周启山、助理</w:t></w:r></w:p><w:p w14:paraId="597BBDE7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 宽敞豪华的书房内，光线明亮。沈曼云坐在巨大的办公桌后，周明川站在桌前汇报，周启山站在一侧窗边，助理站在角落。</w:t></w:r></w:p><w:p w14:paraId="59B725FA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 字幕“周家别墅书房”闪过。</w:t></w:r></w:p><w:p w14:paraId="30621752"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（陈述）：五万现金，他连数都没数，第一反应是追人送回去。</w:t></w:r></w:p><w:p w14:paraId="4DEEC439"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（点头）：我知道了。</w:t></w:r></w:p><w:p w14:paraId="0E767737"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（询问）：还试吗？</w:t></w:r></w:p><w:p w14:paraId="45121569"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云将桌上的一个牛皮纸档案袋推向旁边的助理。</w:t></w:r></w:p><w:p w14:paraId="446A90EB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（果断）：销毁吧，不用看了。</w:t></w:r></w:p><w:p w14:paraId="3512D2C6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 助理拿起档案袋转身离开。周启山转过身看向沈曼云。</w:t></w:r></w:p><w:p w14:paraId="1365ADD6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（严肃）：再试就不是看人了，是欺负人。</w:t></w:r></w:p><w:p w14:paraId="28548524"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（辩解）：我没说还试。</w:t></w:r></w:p><w:p w14:paraId="5090CC9F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（语重心长）：你以前做生意，最喜欢说风险没归零，感情哪有风险归零的道理。</w:t></w:r></w:p><w:p w14:paraId="387312F2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（恳切）：妈，找个时间说清楚吧。</w:t></w:r></w:p><w:p w14:paraId="56880C69"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（欲言又止）：他要是知道我……</w:t></w:r></w:p><w:p w14:paraId="1ABF7BD0"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="207196AE"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第34集</w:t></w:r></w:p><w:p w14:paraId="1C0EE1F8"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>34-1 周家书房 日 内</w:t></w:r></w:p><w:p w14:paraId="7AEBB0CE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、周明川、周启山</w:t></w:r></w:p><w:p w14:paraId="7CD3F54E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 豪华的书房内，沈曼云坐在真皮办公椅上，周明川和周启山站在办公桌前。</w:t></w:r></w:p><w:p w14:paraId="01F7AB7D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（试探）：我们一家都在演，会不会直接把你那小扳手拧下来？</w:t></w:r></w:p><w:p w14:paraId="79555121"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（愧疚）：他生气也应该，是我们不对。</w:t></w:r></w:p><w:p w14:paraId="33935A6B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（严肃）：总比最后从别人嘴里知道强。</w:t></w:r></w:p><w:p w14:paraId="24DC049A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（果断）：好，到此为止，不再加任何测试。</w:t></w:r></w:p><w:p w14:paraId="6740A593"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="7B0C0CD9"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>34-2 晓禾旧货维修店 日 内</w:t></w:r></w:p><w:p w14:paraId="63FD66D9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林小满、林晓禾</w:t></w:r></w:p><w:p w14:paraId="60BF5920"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光照进堆满旧家电的维修店，周明川身穿深蓝色工装走进店内。林小满坐在桌前写字。</w:t></w:r></w:p><w:p w14:paraId="0B622C0E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（询问）：找我姐。</w:t></w:r></w:p><w:p w14:paraId="04D01C87"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（抬头）：她去给人装热水器了，晚上还得修两台洗衣机。</w:t></w:r></w:p><w:p w14:paraId="4808A45E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（疑惑）：她最近为什么接这么多夜单？</w:t></w:r></w:p><w:p w14:paraId="44B17696"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（调侃）：她说想多存点应急钱，怎么，你怕她图你那5000块工资啊？</w:t></w:r></w:p><w:p w14:paraId="40AAE9C9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾推开店门走进来，手里拿着几张纸。</w:t></w:r></w:p><w:p w14:paraId="1B841855"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（关切）：你爸不是还要康复吗？我问了几个老客户，你们这种情况没必要全去私人机构，公立医院加社区康复，费用能少一半。</w:t></w:r></w:p><w:p w14:paraId="0F56FECA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（感动）：你这两天忙成这样，也是为了我爸。</w:t></w:r></w:p><w:p w14:paraId="492B9AB9"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="478C3BE0"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第35集</w:t></w:r></w:p><w:p w14:paraId="63980551"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>35-1 晓禾旧货维修店 日 内</w:t></w:r></w:p><w:p w14:paraId="534F81F3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="0F6CA4C7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修店内光线明亮，墙上挂满工具。林晓禾身穿白色背心和卡其色背带裤，神情严肃地看着周明川。</w:t></w:r></w:p><w:p w14:paraId="07C880B9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃，语气坚定）：我接活是给自己存钱，你爸看病的钱你自己出。我能帮你省，不代表我替你养爸，你自己的责任别往我身上推。</w:t></w:r></w:p><w:p w14:paraId="48288176"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川身穿深蓝色工装，表情从惊讶转为失落，随即低头。</w:t></w:r></w:p><w:p w14:paraId="0BD6EFD5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（低声）：明白。</w:t></w:r></w:p><w:p w14:paraId="4F3C8E0A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，无奈又宠溺）：她连关心人都要把边界说得明明白白，可我怎么越来越喜欢。</w:t></w:r></w:p><w:p w14:paraId="7EDCB767"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="4AFF0289"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>35-2 街边面馆 夜 外</w:t></w:r></w:p><w:p w14:paraId="60804684"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="0331AC53"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜晚的路边面馆，灯光温暖。两人面对面坐着吃面，桌上放着两碗面和调料瓶。周明川细心地撕开创可贴，贴在林晓禾手背的伤口上。</w:t></w:r></w:p><w:p w14:paraId="326EE93B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（疑惑）：今天怎么这么安静？</w:t></w:r></w:p><w:p w14:paraId="0D88BDF6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（犹豫）：我有件事想告诉你。</w:t></w:r></w:p><w:p w14:paraId="59A7B940"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（猜测）：欠债了？</w:t></w:r></w:p><w:p w14:paraId="3170A93A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（摇头）：不是。</w:t></w:r></w:p><w:p w14:paraId="5A72B3C0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（追问）：你爸检查出问题？</w:t></w:r></w:p><w:p w14:paraId="6876F520"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（否认）：也不是。</w:t></w:r></w:p><w:p w14:paraId="3E25266D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（催促）：那说。</w:t></w:r></w:p><w:p w14:paraId="4923AA20"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川口袋里的手机突然响起，他看了一眼屏幕，神色变得焦急。</w:t></w:r></w:p><w:p w14:paraId="31EE38B3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（歉意，起身）：我接一下，很急。</w:t></w:r></w:p><w:p w14:paraId="5B5BF4AA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川拿着手机快步走出面馆玻璃门，站在门口接听电话。林晓禾独自坐在桌前，看着他的背影，眼神中流露出思索。</w:t></w:r></w:p><w:p w14:paraId="228BE6D0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，疑惑）：他每次说店里有急活，为什么处理问题的语气更像老板。</w:t></w:r></w:p><w:p w14:paraId="16CE4B17"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="1F992E3D"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第36集</w:t></w:r></w:p><w:p w14:paraId="4118F6E4"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>36-1 街边面馆 夜 外</w:t></w:r></w:p><w:p w14:paraId="578E5F27"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="0EFF84BB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜晚的街边面馆，透明防风帘后是城市夜景灯光。周明川身穿深蓝色工装走进店内，拉开椅子坐下。林晓禾坐在对面，面前放着一碗面。</w:t></w:r></w:p><w:p w14:paraId="168255F4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（疑惑）：刚才要说什么？</w:t></w:r></w:p><w:p w14:paraId="20653692"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真）：明天说，我想把事情说完整。</w:t></w:r></w:p><w:p w14:paraId="4C3F3764"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（爽快）：行，别拖成坏件。</w:t></w:r></w:p><w:p w14:paraId="44F9E914"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>os</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（郑重）：明天一定不能再晚。</w:t></w:r></w:p><w:p w14:paraId="2841DE88"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="50D91E77"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>36-2 晓禾旧货维修店 夜 内</w:t></w:r></w:p><w:p w14:paraId="439247B4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="79BEE30F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修店内灯光昏黄，墙上挂满工具，货架上堆满旧电器。两人坐在工作台前拆解一台电子设备，桌上放着螺丝刀、万用表等工具。</w:t></w:r></w:p><w:p w14:paraId="627A5456"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（皱眉，查看设备标签）：这个型号停产了，直接换整机得两千多。</w:t></w:r></w:p><w:p w14:paraId="20F21029"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（专注操作）：不用换。</w:t></w:r></w:p><w:p w14:paraId="0BC63DA9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（惊讶）：你有板？</w:t></w:r></w:p><w:p w14:paraId="4C0871F9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（自信，手持电烙铁）：驱动部分还能用，坏的是供电稳压，找一块同参数模块改。</w:t></w:r></w:p><w:p w14:paraId="2CFB9378"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川熟练地焊接电路板，火花微闪。林晓禾在一旁看着他的手部动作。</w:t></w:r></w:p><w:p w14:paraId="1DAE5CED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（打量）：你一个月五千？</w:t></w:r></w:p><w:p w14:paraId="59A9B4B9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（调侃）：怎么，准备给我涨工资？</w:t></w:r></w:p><w:p w14:paraId="20DB2047"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（直言）：我是觉得你老板挺黑。</w:t></w:r></w:p><w:p w14:paraId="58305B91"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（自嘲）：可能是我不够会涨工资。</w:t></w:r></w:p><w:p w14:paraId="2734E167"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，思索）：这人肯定没他说的那么简单，但至少这双手没骗人。</w:t></w:r></w:p><w:p w14:paraId="1BD853BC"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="2F3D5436"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第37集</w:t></w:r></w:p><w:p w14:paraId="6D777E49"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>37-1 晓禾旧货维修店 夜 内</w:t></w:r></w:p><w:p w14:paraId="4918695C"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r></w:p><w:p w14:paraId="43D75872"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修店内灯光温暖，背景墙上挂满工具，货架摆放旧电器。两人坐在工作台前，桌上放着示波器等设备。林晓禾举起沾有油污的手掌，周明川笑着与其击掌。</w:t></w:r></w:p><w:p w14:paraId="5877916B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（开心，展示手掌）：周师傅有点东西。</w:t></w:r></w:p><w:p w14:paraId="696FB104"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（得意，微笑）：林师傅承让。</w:t></w:r></w:p><w:p w14:paraId="266B5256"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="13B6E959"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>37-2 餐厅包间 夜 内</w:t></w:r></w:p><w:p w14:paraId="15B14404"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:lang w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、赵凯、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>芬姨</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>军绿色T恤男</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老年女</w:t></w:r></w:p><w:p w14:paraId="21E75211"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 餐厅包间内，圆桌中央放着水果蛋糕，墙上贴着菜单海报。众人围坐用餐，气氛略显紧张。</w:t></w:r></w:p><w:p w14:paraId="54E8F8D1"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>芬姨</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（关切，拉着林晓禾手臂）：晓禾啊，你真不再考虑考虑赵凯，有房有车店又多。</w:t></w:r></w:p><w:p w14:paraId="6B628080"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>军绿色T恤男</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（举杯，语重心长）：明川人是不错，可结婚不能光看人吧。</w:t></w:r></w:p><w:p w14:paraId="2EE3D944"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老年女</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（嫌弃，放下筷子）：婆婆摆摊，公公坐轮椅，自己月薪5000，以后两口子挣的钱，不全得填家里窟窿。</w:t></w:r></w:p><w:p w14:paraId="12309AA0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川低头沉默，手握水杯。赵凯身体前倾，表情轻蔑。</w:t></w:r></w:p><w:p w14:paraId="0C893399"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（傲慢，直视林晓禾）：我说句不好听的，晓禾你这不是找对象，是扶贫。</w:t></w:r></w:p><w:p w14:paraId="303526AE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（愤怒，目光坚定）：他穷不穷我知道。他没偷没抢，不赌不欠债，靠手艺挣钱，我不觉得丢人。</w:t></w:r></w:p><w:p w14:paraId="00CB0E0A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（冷笑，打断）：可现实……</w:t></w:r></w:p><w:p w14:paraId="6BA5A9C1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（强势，打断）：现实我比你会算，你有多少钱是你的事。</w:t></w:r></w:p><w:p w14:paraId="0BA484A2"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="5ABC5167"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第38集</w:t></w:r></w:p><w:p w14:paraId="23BA85CC"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>38-1 餐厅包间 夜 内</w:t></w:r></w:p><w:p w14:paraId="7C2E102A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>军绿色T恤男</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老年女</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、周明川</w:t></w:r></w:p><w:p w14:paraId="5EA8BCA5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 餐厅包间内灯光温暖，圆桌上摆着餐具和菜肴。林晓禾身穿米色T恤，神情严肃地看着对面。</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>军绿色T恤男</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>身穿军绿色T恤，语重心长地劝说。</w:t></w:r></w:p><w:p w14:paraId="300F7B1A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（愤怒，目光坚定）：我找谁是我的事。</w:t></w:r></w:p><w:p w14:paraId="6CDAD600"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>军绿色T恤男</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（关切，无奈）：晓禾我们也是为你好。</w:t></w:r></w:p><w:p w14:paraId="559CB980"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷笑，反问）：真为我好？就别替把人按价值算。</w:t></w:r></w:p><w:p w14:paraId="74C4173B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头切至周明川特写，他眼神震动，眼眶微红，看着林晓禾的背影。</w:t></w:r></w:p><w:p w14:paraId="277EB8DF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，感动）：她不知道我是谁，却在所有人面前替这个穷修车工撑腰。</w:t></w:r></w:p><w:p w14:paraId="5D1114C5"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="2B88AE6A"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>38-2 河边道路 夜 外</w:t></w:r></w:p><w:p w14:paraId="28FD6CFB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="46E7B5B8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜晚的河边道路，路灯昏黄。林晓禾驾驶着一辆蓝色电动三轮车，周明川坐在后车斗里。风吹动两人的头发。</w:t></w:r></w:p><w:p w14:paraId="6547748E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（试探，轻声）：晓禾。</w:t></w:r></w:p><w:p w14:paraId="5F5EF8B2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静）：嗯？</w:t></w:r></w:p><w:p w14:paraId="52BD3B27"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真，注视前方）：要不我们认真谈。</w:t></w:r></w:p><w:p w14:paraId="6AF69F72"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（疑惑，侧头）：我们之前不认真？</w:t></w:r></w:p><w:p w14:paraId="3A9EBA07"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（郑重，解释）：我是说以结婚为前提。</w:t></w:r></w:p><w:p w14:paraId="2E0C0D26"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾握着车把的手微微一顿，随即嘴角上扬。</w:t></w:r></w:p><w:p w14:paraId="77A58087"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（爽快，微笑）：可以。</w:t></w:r></w:p><w:p w14:paraId="613DD230"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（惊讶）：这么快？</w:t></w:r></w:p><w:p w14:paraId="5D041D42"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（调侃，目视前方）：反悔我就停车。</w:t></w:r></w:p><w:p w14:paraId="3AD4827F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（急切，摆手）：别，往前开。</w:t></w:r></w:p><w:p w14:paraId="296F5C94"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川从口袋里掏出一个棕色的小盒子，打开盒盖，里面是一枚银色的戒指。</w:t></w:r></w:p><w:p w14:paraId="350009D3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（诚恳，递出戒指）：贵的我现在送不起。这个网上淘的，仿的锆石的，几十块钱带着玩。</w:t></w:r></w:p><w:p w14:paraId="39B4618C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾停下车，转身看着周明川手中的戒指，神情温柔。</w:t></w:r></w:p><w:p w14:paraId="3BFAC168"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="1608BBF0"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第39集</w:t></w:r></w:p><w:p w14:paraId="774D6803"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>39-1 河边道路 夜 外</w:t></w:r></w:p><w:p w14:paraId="0BCBCBE2"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r></w:p><w:p w14:paraId="0663A3AA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜晚的河边道路，路灯昏黄。林晓禾站在一辆蓝色电动三轮车旁，手中拿着一枚戒指查看。周明川坐在车斗里看着她。</w:t></w:r></w:p><w:p w14:paraId="69B5040D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（疑惑）：假的？</w:t></w:r></w:p><w:p w14:paraId="26554919"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（随意）：嗯，你要是嫌弃就扔了。</w:t></w:r></w:p><w:p w14:paraId="16B19123"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（微笑）：假的也是钱买的。</w:t></w:r></w:p><w:p w14:paraId="2123F84A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾将戒指戴在手指上，仔细端详。</w:t></w:r></w:p><w:p w14:paraId="2B91A32D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（满意）：戴着吧，挺好看。</w:t></w:r></w:p><w:p w14:paraId="1CD9A259"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，忧虑）：等我告诉她真相，她还会把它留着吗？</w:t></w:r></w:p><w:p w14:paraId="0C1BBA24"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="51679379"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>39-2 周家别墅客厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="651A105F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="5A02CA5C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 豪华的别墅客厅，水晶吊灯明亮。周启山和沈曼云坐在真皮沙发上，周明川身穿工装站在他们面前。画面左侧出现竖排字幕“周家别墅客厅”。</w:t></w:r></w:p><w:p w14:paraId="02230AA6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坚定）：明天我告诉她，全部。</w:t></w:r></w:p><w:p w14:paraId="0EE475C3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（关切）：确定？</w:t></w:r></w:p><w:p w14:paraId="60D78984"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坦然）：她生气也应该。</w:t></w:r></w:p><w:p w14:paraId="606B78A8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（严肃）：早该说了。</w:t></w:r></w:p><w:p w14:paraId="71667A20"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（询问）：要不要我跟你一起？</w:t></w:r></w:p><w:p w14:paraId="7BD1F3D4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（拒绝）：先我说。谎是我一起瞒的，我骗得最多。</w:t></w:r></w:p><w:p w14:paraId="7B803A40"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川从口袋掏出手机查看屏幕。手机锁屏显示时间01:33，随后进入聊天界面，显示一条语音消息和一张汽车维修车间的照片。</w:t></w:r></w:p><w:p w14:paraId="31650FCF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（语音，轻快）：明天有个大活，给的钱不少。你不是懂车吗？跟我一起去搭把手，正好见见世面。</w:t></w:r></w:p><w:p w14:paraId="50DE30E0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川看着手机屏幕，神情复杂。</w:t></w:r></w:p><w:p w14:paraId="105AB006"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（感慨）：这算老天催你坦白。</w:t></w:r></w:p><w:p w14:paraId="1CB5284D"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="66C455CB"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第40集</w:t></w:r></w:p><w:p w14:paraId="2C2D513E"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>40-1 周家别墅餐厅 日 内</w:t></w:r></w:p><w:p w14:paraId="36402346"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山</w:t></w:r></w:p><w:p w14:paraId="57362D8A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 豪华的餐厅内，长桌上摆满精致点心。周启山拄着拐杖站在桌边，沈曼云站在一旁，神情担忧地看着身穿工装的周明川。</w:t></w:r></w:p><w:p w14:paraId="41006646"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（关切，提议）：要不我让人把那张维修单给别人，你先单独跟他说。</w:t></w:r></w:p><w:p w14:paraId="2D513AEB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坚定）：不躲了。</w:t></w:r></w:p><w:p w14:paraId="78C2CB4D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（惊讶）：你准备在公司开口？</w:t></w:r></w:p><w:p w14:paraId="73F390C1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坦然）：本来就该说，再骗一次，我连解释的资格都没了。</w:t></w:r></w:p><w:p w14:paraId="03CA2C3A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（严肃，训斥）：今天不管怎么收场，别替自己找理由。</w:t></w:r></w:p><w:p w14:paraId="0E2B4AAB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（低头）：我知道。</w:t></w:r></w:p><w:p w14:paraId="228CD5CB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（忧虑）：明川，要是她不原谅，你也得认。</w:t></w:r></w:p><w:p w14:paraId="68024AF4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（点头）：认。</w:t></w:r></w:p><w:p w14:paraId="0CE77CBC"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="03466CF8"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>40-2 盛川集团发布中心外 日 外</w:t></w:r></w:p><w:p w14:paraId="01A8E858"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="3AA24741"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 现代化的玻璃幕墙大楼前，挂着“盛川集团 SHENGHAN GROUP”的招牌。林晓禾驾驶着一辆蓝色电动三轮车，周明川坐在后车斗里，车上放着工具箱。</w:t></w:r></w:p><w:p w14:paraId="69C64999"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（回头，调侃）：你们这种大公司的人，会不会嫌我来三轮挡门？</w:t></w:r></w:p><w:p w14:paraId="7BA905C4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（自信）：他们敢，我……</w:t></w:r></w:p><w:p w14:paraId="39301112"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（好奇）：你什么？</w:t></w:r></w:p><w:p w14:paraId="48FBF5ED"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第41集</w:t></w:r></w:p><w:p w14:paraId="67D716BA"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>41-1 盛川集团大楼外 日 外</w:t></w:r></w:p><w:p w14:paraId="7C8CE049"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、保安、林晓禾</w:t></w:r></w:p><w:p w14:paraId="6E7094AB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 现代化的玻璃幕墙大楼前，挂着“盛川集团 SHENGHAN GROUP”的招牌。周明川坐在蓝色电动三轮车后斗，挠头微笑。</w:t></w:r></w:p><w:p w14:paraId="1AEC3B93"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（尴尬，轻松）：我帮你推远点。</w:t></w:r></w:p><w:p w14:paraId="1A165AED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川下车站在车旁，神情变得凝重。</w:t></w:r></w:p><w:p w14:paraId="6AF7D267"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，沉重）：最后几个小时了，每多说一句谎，都像在往后面多添一刀。</w:t></w:r></w:p><w:p w14:paraId="31E0201A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一名身穿黑色制服的保安走来，看到周明川后露出震惊表情。</w:t></w:r></w:p><w:p w14:paraId="6AB052DB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>保安（震惊）：周……</w:t></w:r></w:p><w:p w14:paraId="4B2727DA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 保安结巴了一下，调整状态。</w:t></w:r></w:p><w:p w14:paraId="38926867"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>保安（恭敬）：周周师傅，维修从2号门进去。</w:t></w:r></w:p><w:p w14:paraId="1C394AD7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾站在一旁，疑惑地看着周明川。</w:t></w:r></w:p><w:p w14:paraId="09297FF0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（疑惑）：你以前来过？</w:t></w:r></w:p><w:p w14:paraId="40E9AE57"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（平静）：参加过培训。</w:t></w:r></w:p><w:p w14:paraId="42F32E0A"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="3F0DBB67"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>41-2 发布中心设备区 日 内</w:t></w:r></w:p><w:p w14:paraId="0E6870D7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、赵凯、职员群演甲、职员群演乙、职员群演丙</w:t></w:r></w:p><w:p w14:paraId="48E7C1B5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 宽敞明亮的展厅内，背景有巨大的弧形屏幕显示雪山画面。林晓禾蹲在地上修理升降台，周明川站在一旁。远处赵凯带着一群职员走来。</w:t></w:r></w:p><w:p w14:paraId="06048282"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 字幕“发布中心设备区”闪过。</w:t></w:r></w:p><w:p w14:paraId="171C64AC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，疑惑）：一个保安认识他可以说培训，怎么连三个主管见他都跟见领导似的。</w:t></w:r></w:p><w:p w14:paraId="4895F5E0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 赵凯走到两人面前，上下打量周明川，嘴角带着轻蔑的笑。</w:t></w:r></w:p><w:p w14:paraId="6F5AF465"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（轻蔑）：真把路边修车工带进来了，这地方也是他能随便进的？</w:t></w:r></w:p><w:p w14:paraId="3C666767"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（抬头，反驳）：他手艺比你强，带他怎么了？</w:t></w:r></w:p><w:p w14:paraId="5F8670A2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，复杂）：她还在替那个假的我说话。</w:t></w:r></w:p><w:p w14:paraId="786322A4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（傲慢，指着周围）：这里随便一辆车都是新平台，碰坏一块漆，你俩干一年都赔不起。</w:t></w:r></w:p><w:p w14:paraId="47902279"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="65B9BE53"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第42集</w:t></w:r></w:p><w:p w14:paraId="39FFD8B4"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>42-1 发布中心设备区 日 内</w:t></w:r></w:p><w:p w14:paraId="00F17039"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、赵凯</w:t></w:r></w:p><w:p w14:paraId="03998776"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 宽敞明亮的展厅内，背景有巨大的弧形屏幕显示雪山画面。周明川身穿深蓝色工装面对赵凯，林晓禾站在一旁。</w:t></w:r></w:p><w:p w14:paraId="77CB6EB8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（严肃）：车是给人用的，不是拿来唬人的。</w:t></w:r></w:p><w:p w14:paraId="3CD09D3E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>赵凯（冷笑）：口气倒不小。</w:t></w:r></w:p><w:p w14:paraId="4A25D906"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="014E0A2D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>42-2 走廊 日 内</w:t></w:r></w:p><w:p w14:paraId="4ED7824D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="3A87C8F4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 工业风格的走廊，墙上贴有“高件仓库”和“非授权人员 禁止入内”的标识。周明川拿出一张黑卡刷过门禁，绿灯亮起。</w:t></w:r></w:p><w:p w14:paraId="2C396C5C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（震惊，回头）：高级管理？</w:t></w:r></w:p><w:p w14:paraId="6FB07827"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（平静）：以前培训的时候发的，没注销。</w:t></w:r></w:p><w:p w14:paraId="3A73E60B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（怀疑）：什么培训能给普通技工发高级管理权限？周明川，你是不是有事没告诉我？</w:t></w:r></w:p><w:p w14:paraId="610D18F2"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="0810EA90"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>42-3 发布中心设备区 日 内</w:t></w:r></w:p><w:p w14:paraId="434D2401"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、李经理、职员群演甲、职员群演乙、职员群演丙</w:t></w:r></w:p><w:p w14:paraId="4FD3D3DB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头切回展厅，李经理满头大汗，神色慌张地跑过来。</w:t></w:r></w:p><w:p w14:paraId="43DD2F2C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（焦急大喊）：主舞台展示车断电了，媒体预演马上开始了！</w:t></w:r></w:p><w:p w14:paraId="6597F62A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（冷静）：等这边处理完，我全部告诉你。</w:t></w:r></w:p><w:p w14:paraId="607CFF13"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（盯着他）：最好是全部。</w:t></w:r></w:p><w:p w14:paraId="218B17A4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 场景切换至一辆引擎盖打开的汽车前，李经理和几名职员正围着笔记本电脑焦急操作。</w:t></w:r></w:p><w:p w14:paraId="5CA1132C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（看着屏幕，崩溃）：低压电正常，主机联系不吸合，工程电脑连不上。</w:t></w:r></w:p><w:p w14:paraId="65C9F2D1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川大步走到车头前。</w:t></w:r></w:p><w:p w14:paraId="1D50428D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（果断命令）：先断高压，所有人后退一步。</w:t></w:r></w:p><w:p w14:paraId="5CDFEE80"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（惊愕，转头）：你是谁？凭什么？</w:t></w:r></w:p><w:p w14:paraId="641766B3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（眼神凌厉）：先照做。</w:t></w:r></w:p><w:p w14:paraId="03D43F9F"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="057044BD"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第43集</w:t></w:r></w:p><w:p w14:paraId="2B9EFC35"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>43-1 发布中心设备区 日 内</w:t></w:r></w:p><w:p w14:paraId="60A2DB2E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、李经理、林晓禾、职员群演甲</w:t></w:r></w:p><w:p w14:paraId="1A89B85B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 宽敞明亮的展厅设备区，一辆浅蓝色汽车引擎盖打开。周明川身穿深蓝色工装，神情专注地操作着电路板。李经理和林晓禾站在一旁围观，神色紧张。</w:t></w:r></w:p><w:p w14:paraId="23168272"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（冷静，指令清晰）：调BMS日记，工程模式切三级，别直接强制唤醒。</w:t></w:r></w:p><w:p w14:paraId="1069EA56"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（震惊，瞪大眼睛）：三级权限只有内部核心层才能……</w:t></w:r></w:p><w:p w14:paraId="691CEF36"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（疑惑，盯着周明川）：你怎么知道他们内部工程模式？</w:t></w:r></w:p><w:p w14:paraId="67A63818"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川没有回答，继续低头检查车辆线路。</w:t></w:r></w:p><w:p w14:paraId="76C81FA6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（笃定）：测试车昨天换过前排线束。</w:t></w:r></w:p><w:p w14:paraId="7BAD5D52"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（急忙点头确认）：是，昨晚连夜换的。</w:t></w:r></w:p><w:p w14:paraId="49C2E615"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川蹲下身，手指指向车头下方的一个插头。</w:t></w:r></w:p><w:p w14:paraId="02BDCCC7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（指出问题）：2号插头没压到底，重插，锁扣推到位。</w:t></w:r></w:p><w:p w14:paraId="7369C8BF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川伸手将插头用力按入，发出“咔哒”一声脆响。车内中控屏幕瞬间亮起，显示车辆正常界面。</w:t></w:r></w:p><w:p w14:paraId="1A7C80DF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，震惊）：这绝不是“街边修车工”能有的本事。</w:t></w:r></w:p><w:p w14:paraId="16459B16"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 远处电梯门打开，沈曼云身穿深蓝色旗袍，在几名西装男子的簇拥下走出。</w:t></w:r></w:p><w:p w14:paraId="3689FBF5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（高声通报）：沈董到了！</w:t></w:r></w:p><w:p w14:paraId="59001A15"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>职员群演甲（齐声问候）：沈董好！</w:t></w:r></w:p><w:p w14:paraId="373E6E8B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾转头看向走来的沈曼云，瞳孔放大，满脸不可置信。</w:t></w:r></w:p><w:p w14:paraId="6EBD650B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（震惊，脱口而出）：阿姨？</w:t></w:r></w:p><w:p w14:paraId="6BB510E5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云面带微笑走近。李经理上前一步汇报。</w:t></w:r></w:p><w:p w14:paraId="48D7D7E2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（恭敬）：沈董，主舞台故障已经处理好了。</w:t></w:r></w:p><w:p w14:paraId="409F5373"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（喃喃自语，难以置信）：沈董？那个每天在旧街给我加两个云……</w:t></w:r></w:p><w:p w14:paraId="1A340F88"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="755C6B94"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第44集</w:t></w:r></w:p><w:p w14:paraId="60A0C60D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>44-1 汽车展厅 日 内</w:t></w:r></w:p><w:p w14:paraId="3ECE8F30"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、林晓禾、周启山、李经理、周明川、职员群演甲、职员群演乙、职员群演丙</w:t></w:r></w:p><w:p w14:paraId="0E4A3E1E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 现代化的汽车展厅内，光线明亮。沈曼云身穿深蓝色旗袍，面带微笑看着林晓禾。林晓禾身穿白色背心和卡其色背带裤，满脸震惊。</w:t></w:r></w:p><w:p w14:paraId="7122A3D8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（震惊，难以置信）：加两个云吞的沈阿姨？</w:t></w:r></w:p><w:p w14:paraId="108BDD95"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（温和）：晓禾。</w:t></w:r></w:p><w:p w14:paraId="61A98A57"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（困惑，指着周围）：您的云吞摊呢？</w:t></w:r></w:p><w:p w14:paraId="1C1FEA43"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周启山身穿棕色西装，手持拐杖，在李经理的搀扶下走下台阶。李经理推着一辆空轮椅跟在后面。</w:t></w:r></w:p><w:p w14:paraId="5A07CAC0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（关切）：周董小心台阶。</w:t></w:r></w:p><w:p w14:paraId="56D3C4BA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾看着周启山行走的动作，更加惊讶。</w:t></w:r></w:p><w:p w14:paraId="126AE568"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（惊讶）：叔你能走？</w:t></w:r></w:p><w:p w14:paraId="610C34A1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（平静）：腿伤是真的，现在是康复期，能走一段。</w:t></w:r></w:p><w:p w14:paraId="21760A87"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（恍然大悟，带着质问）：所以平时离不开轮椅是假的？</w:t></w:r></w:p><w:p w14:paraId="20509420"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（愧疚）：是我们说重了。</w:t></w:r></w:p><w:p w14:paraId="45DE0D62"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 李经理快步走到周启山身边，神色焦急地汇报。</w:t></w:r></w:p><w:p w14:paraId="0475E1CB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（急切）：周总，董事会的人已经到了，北城基地方案就等您最后确认。</w:t></w:r></w:p><w:p w14:paraId="0033F9E3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向周明川，他身穿深蓝色工装，神情严肃地站着。林晓禾转头看向他。</w:t></w:r></w:p><w:p w14:paraId="5159AAEA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（震惊，盯着周明川）：盛川集团的周总？</w:t></w:r></w:p><w:p w14:paraId="1933F3C0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（点头）：对。</w:t></w:r></w:p><w:p w14:paraId="639E30AA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（追问）：北城项目也是你的？</w:t></w:r></w:p><w:p w14:paraId="4EE3787D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坦然）：我负责。</w:t></w:r></w:p><w:p w14:paraId="1425F430"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川看着平静的林晓禾，内心感到不安。</w:t></w:r></w:p><w:p w14:paraId="03233AAB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，紧张）：她越平静，我越知道事情糟了。</w:t></w:r></w:p><w:p w14:paraId="39CF9A0F"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="50ACD981"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第45集</w:t></w:r></w:p><w:p w14:paraId="07CEE3D3"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>45-1 发布中心侧厅 日 内</w:t></w:r></w:p><w:p w14:paraId="1FE0C50B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="7A75B9B8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 现代化的办公区域侧厅，背景是巨大的落地窗和城市天际线。周明川身穿深蓝色工装，满头大汗，神情焦急地看着林晓禾。林晓禾身穿白色背心和脏旧的卡其色背带裤，表情冷漠愤怒。沈曼云身着黑色旗袍站在一旁，周启山身穿棕色西装手持拐杖站在后方。</w:t></w:r></w:p><w:p w14:paraId="4C3AF47D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（焦急）：晓禾你听我解释。</w:t></w:r></w:p><w:p w14:paraId="5E3F54ED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷漠）：不用解释。我问，你答。</w:t></w:r></w:p><w:p w14:paraId="15D63D90"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾转向沈曼云，眼神锐利地质问。</w:t></w:r></w:p><w:p w14:paraId="2972315A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（质问）：云吞摊是真的？</w:t></w:r></w:p><w:p w14:paraId="524FBAFB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（坦然）：我年轻时确实卖过云吞，现在那个摊是为了……</w:t></w:r></w:p><w:p w14:paraId="05532E2C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（打断，冷笑）：为了考我。</w:t></w:r></w:p><w:p w14:paraId="41D3952F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾转头看向周启山。</w:t></w:r></w:p><w:p w14:paraId="4BC78685"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（质问）：叔的腿伤是真的？</w:t></w:r></w:p><w:p w14:paraId="2CA06767"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（点头）：真的。</w:t></w:r></w:p><w:p w14:paraId="0B93E368"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（追问）：说离不开轮椅是假的？</w:t></w:r></w:p><w:p w14:paraId="59C2BE88"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（承认）：是。</w:t></w:r></w:p><w:p w14:paraId="1551455C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（语速加快）：月薪五千？</w:t></w:r></w:p><w:p w14:paraId="64BBD82C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（低声）：假的。</w:t></w:r></w:p><w:p w14:paraId="7ED38A2C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（盯着周明川）：没车？</w:t></w:r></w:p><w:p w14:paraId="1145E1E7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（低头）：假的。</w:t></w:r></w:p><w:p w14:paraId="61791B36"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（愤怒）：没婚房，只有那套破房子？</w:t></w:r></w:p><w:p w14:paraId="4365E72C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（愧疚）：假的。</w:t></w:r></w:p><w:p w14:paraId="44966FBC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾深吸一口气，眼中闪过失望的神色。</w:t></w:r></w:p><w:p w14:paraId="28D0CA06"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（自嘲，苦笑）：合着闹了半天，只有会修东西是真的。</w:t></w:r></w:p><w:p w14:paraId="1CE27B8D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（急切）：晓禾。</w:t></w:r></w:p><w:p w14:paraId="1B6A1885"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云上前一步，语气缓和地解释。</w:t></w:r></w:p><w:p w14:paraId="7D27D014"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（温和）：晓禾，我们不是看不起你，我们只是想确认，你是不是冲着明川的钱来的。</w:t></w:r></w:p><w:p w14:paraId="594AB8F6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾看着沈曼云，眼神逐渐变得冰冷。</w:t></w:r></w:p><w:p w14:paraId="13672EC9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（讽刺）：所以你们怕我骗钱。</w:t></w:r></w:p><w:p w14:paraId="790AC684"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="7C227D6A"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第46集</w:t></w:r></w:p><w:p w14:paraId="5C78E628"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>46-1 周家客厅 日 内</w:t></w:r></w:p><w:p w14:paraId="648A40A5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="51598CF8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 现代化的宽敞客厅，落地窗外是城市高楼景观。林晓禾身穿脏旧的工装背带裤，眼眶泛红，神情委屈而愤怒地面对周家三人。周明川身穿深蓝工装站在一旁，神色愧疚。沈曼云身着旗袍，周启山穿西装持拐杖站立。</w:t></w:r></w:p><w:p w14:paraId="22AFEE2D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（含泪质问，激动，语速加快）：我就不怕别人骗感情吗，你们要看我会不会嫌摆摊的婆婆，我没嫌。</w:t></w:r></w:p><w:p w14:paraId="55652A9A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（愧疚，温和）：阿姨知道委屈你了。</w:t></w:r></w:p><w:p w14:paraId="12154FBC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（哽咽，大声）：要看我会不会嫌坐轮椅的公公，我没嫌！</w:t></w:r></w:p><w:p w14:paraId="782BFE19"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（沉重，低头）：是我们做的不地道。</w:t></w:r></w:p><w:p w14:paraId="73C3CBC1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（悲愤，指着周围）：要看我嫌不嫌破房，我拎着工具把电线龙头扶手全给你们装了。</w:t></w:r></w:p><w:p w14:paraId="5D8FF682"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头特写周明川紧握的拳头，青筋暴起。镜头切回林晓禾满脸泪水。</w:t></w:r></w:p><w:p w14:paraId="7E4CB00E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（绝望，流泪）：我以为我们在商量以后怎么过日子，原来我一直在参加你们家的面试。</w:t></w:r></w:p><w:p w14:paraId="32521AFA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（急切，上前一步）：晓禾这事是我考虑不周，你要是有气……</w:t></w:r></w:p><w:p w14:paraId="6A7D5D21"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（打断，冷笑，讽刺，直视沈曼云）：阿姨，我天天收旧货，电视冰箱铜线值多少钱，我能称能拆能估，人心也能放秤上称吗？你们家选儿媳妇也得……</w:t></w:r></w:p><w:p w14:paraId="20B7E776"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="73163872"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第47集</w:t></w:r></w:p><w:p w14:paraId="459EB671"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>47-1 周家客厅 日 内</w:t></w:r></w:p><w:p w14:paraId="048BAAD5"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川</w:t></w:r></w:p><w:p w14:paraId="5EA60B2C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（平静，审视）：也得先称称我几斤几两。</w:t></w:r></w:p><w:p w14:paraId="1E240375"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾弯腰提起地上的银色工具箱，转身欲走。周明川急忙上前一步拦住她。</w:t></w:r></w:p><w:p w14:paraId="55979DA9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（急切，恳求）：晓禾，我后来是真的喜欢你。</w:t></w:r></w:p><w:p w14:paraId="7F46BE35"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷笑，反问）：后来？那前面呢？</w:t></w:r></w:p><w:p w14:paraId="4F129041"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头特写林晓禾含泪却坚定的双眼。</w:t></w:r></w:p><w:p w14:paraId="6B2DA7FA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（质问，语速加快）：前面我每说一句话，你是不是都在心里给我打分？</w:t></w:r></w:p><w:p w14:paraId="0F105E17"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（低头，愧疚）：是。</w:t></w:r></w:p><w:p w14:paraId="2AF577A2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（悲愤，连续追问）：我给老人买粉，你猜我是不是装的？</w:t></w:r></w:p><w:p w14:paraId="0F8D53F2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（痛苦，承认）：是我狭隘。</w:t></w:r></w:p><w:p w14:paraId="4E00F2E3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（直视，咄咄逼人）：我问你工资，你觉得我是不是拜金？我离开老房去买材料，你以为我嫌穷跑了？</w:t></w:r></w:p><w:p w14:paraId="70939E18"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川眼眶泛红，泪水滑落脸颊，神情极度懊悔。</w:t></w:r></w:p><w:p w14:paraId="4B69865A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（流泪，哽咽）：我错了，可后来我真的没有再怀疑你了。</w:t></w:r></w:p><w:p w14:paraId="7FC9462B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾从口袋掏出一枚粉色心形钻戒，放在周明川摊开的手掌中。</w:t></w:r></w:p><w:p w14:paraId="598E7BDD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（决绝，冷静）：周明川，你们家的考试我过了，可你没过我的。你的假戒指拿回去。</w:t></w:r></w:p><w:p w14:paraId="11185FB2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾转身提着工具箱大步走向门口，推门离去。周明川捧着戒指呆立原地。</w:t></w:r></w:p><w:p w14:paraId="72573DFD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（愧疚，轻声）：明川对不起。</w:t></w:r></w:p><w:p w14:paraId="1F53C1C9"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="6BB3EB36"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第48集</w:t></w:r></w:p><w:p w14:paraId="61211160"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>48-1 办公室 日 内</w:t></w:r></w:p><w:p w14:paraId="03E7A7AA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、周明川</w:t></w:r></w:p><w:p w14:paraId="0CA99740"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 明亮的办公室内，沈曼云身穿黑色旗袍，佩戴珍珠项链，神情严肃地看着周明川。</w:t></w:r></w:p><w:p w14:paraId="6AD9E795"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（平静，坦白）：这个局是我开的。</w:t></w:r></w:p><w:p w14:paraId="4FF6CEFB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川眼眶泛红，神情痛苦愧疚。</w:t></w:r></w:p><w:p w14:paraId="5235BCA4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（愧疚，哽咽）：可最后一直瞒着没说的人是我。</w:t></w:r></w:p><w:p w14:paraId="3580B713"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="5E579EE4"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>48-2 林家客厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="6BC20D5A"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:lang w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、林小满、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r></w:p><w:p w14:paraId="672D96AF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 温馨的客厅里，墙上贴着奖状和福字。林晓禾坐在沙发上抱着膝盖哭泣，手臂上有擦伤。林小满焦急地蹲在她面前，</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（换了一身碎花家居服）端着一杯水走过来放在桌上。</w:t></w:r></w:p><w:p w14:paraId="16C685E0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（焦急，难以置信）：姐你之前真的一点都不知道？</w:t></w:r></w:p><w:p w14:paraId="3E1ABF0B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾低头流泪，声音微弱。</w:t></w:r></w:p><w:p w14:paraId="0B49D2DF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（悲伤，摇头）：不知道。</w:t></w:r></w:p><w:p w14:paraId="40C75DE0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（愤怒，激动）：那他家也太……</w:t></w:r></w:p><w:p w14:paraId="5A8F0C08"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>严厉地打断林小满的话。</w:t></w:r></w:p><w:p w14:paraId="59DE0A8D"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（严厉，喝止）：小满闭嘴。</w:t></w:r></w:p><w:p w14:paraId="55720D3A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>坐到林晓禾身边，轻轻拍着她的肩膀安慰。</w:t></w:r></w:p><w:p w14:paraId="2B1E7BC7"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（关切，温和）：他有没有拿你当笑话？</w:t></w:r></w:p><w:p w14:paraId="29FE9C12"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（迷茫，流泪）：我不知道。</w:t></w:r></w:p><w:p w14:paraId="1AA27A1B"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（果断，劝慰）：那就先别见，想清楚再说。</w:t></w:r></w:p><w:p w14:paraId="77EE1931"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（抬头，委屈）：妈，你不问我，为什么不抓住这个机会？</w:t></w:r></w:p><w:p w14:paraId="16ABE94F"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（疑惑）：什么机会？</w:t></w:r></w:p><w:p w14:paraId="4003BBF8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（自嘲）：百亿豪门。</w:t></w:r></w:p><w:p w14:paraId="3E87DB74"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>轻笑一声，拉着林晓禾的手。</w:t></w:r></w:p><w:p w14:paraId="47300F83"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（慈爱，反问）：你小时候没饭吃吗？非得靠嫁人换饭吃？</w:t></w:r></w:p><w:p w14:paraId="0E7DA03E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾含泪苦笑。</w:t></w:r></w:p><w:p w14:paraId="19175B8B"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（语重心长，教导）：钱多钱少是他的，你被骗了是真的。先把自己的委屈想明白，别让别人拿有钱两个字堵你的嘴。</w:t></w:r></w:p><w:p w14:paraId="2BF61A60"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头扫过茶几上的手机屏幕，显示着通话界面，林小满坐在一旁低头沉默。</w:t></w:r></w:p><w:p w14:paraId="05A6FBF4"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="0B63DAE5"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第49集</w:t></w:r></w:p><w:p w14:paraId="65E7826C"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>49-1 林家客厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="0B1EE8D5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林小满</w:t></w:r></w:p><w:p w14:paraId="2573CA01"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 温馨的客厅内，灯光柔和。林小满坐在沙发上，手里拿着手机，神情愤怒地看着屏幕。茶几上放着牛奶和水果。</w:t></w:r></w:p><w:p w14:paraId="4F8113C1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（愤怒，对着手机）：今晚谁也别采访，我们家又不是景点，想来就来。</w:t></w:r></w:p><w:p w14:paraId="044F979B"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="1E6F4210"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>49-2 晓禾旧货维修店 日 外/内</w:t></w:r></w:p><w:p w14:paraId="1B3CC659"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、王姨、芬姨、陈奶奶、路人甲、沈曼云</w:t></w:r></w:p><w:p w14:paraId="58B49DFE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光明媚的街道旁，一家名为“晓禾旧货维修店”的店铺敞开着卷帘门。店内堆满了旧电器和工具。林晓禾穿着工装背带裤，坐在工作台前专注地修理风扇。店门外，王姨、芬姨和陈奶奶三位大妈聚在一起 gossip（八卦）。</w:t></w:r></w:p><w:p w14:paraId="31EFCED1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>芬姨（兴奋，八卦）：哎你们刷到没？就晓禾处的那个修车工，居然是盛川集团的太子爷。</w:t></w:r></w:p><w:p w14:paraId="13F1F661"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>陈奶奶（笃定，分析）：我早说他不简单。你想啊，换别人一听家里长辈做点小生意，家里有位长辈行动不便，薪资普通，早扭头跑了，他偏不。合着人早就了解清楚情况了。</w:t></w:r></w:p><w:p w14:paraId="715ACEFD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>王姨（怀疑，摇头）：不能吧，晓禾啥人咱们还不知道，犯得上演这么久？</w:t></w:r></w:p><w:p w14:paraId="6421CED6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一辆黑色轿车缓缓停在店门口。沈曼云身穿深蓝色旗袍，优雅地从车上下来，走向店内。</w:t></w:r></w:p><w:p w14:paraId="208F1859"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（温和，询问）：晓禾，我能进去坐会儿吗？</w:t></w:r></w:p><w:p w14:paraId="24AEA417"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（抬头，客气）：店里脏，沈董别蹭脏了衣服。</w:t></w:r></w:p><w:p w14:paraId="0CC63363"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（微笑，亲切）：你叫我阿姨就行。</w:t></w:r></w:p><w:p w14:paraId="76B7FC63"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静，解释）：以前叫阿姨，是因为我以为您真在卖云吞。</w:t></w:r></w:p><w:p w14:paraId="5A3E72FD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云在林晓禾对面的小板凳上坐下，神情真诚。</w:t></w:r></w:p><w:p w14:paraId="6D303963"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（诚恳，坦白）：我今天没带支票，也没带房本，我知道那只会让事情更难看。</w:t></w:r></w:p><w:p w14:paraId="26CE1323"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="742A90B1"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第50集</w:t></w:r></w:p><w:p w14:paraId="082B5656"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>50-1 晓禾旧货维修店 日 内/外</w:t></w:r></w:p><w:p w14:paraId="5098F599"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、沈曼云、周明川、芬姨、路人甲、保镖甲、助理</w:t></w:r></w:p><w:p w14:paraId="259D5861"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光透过窗户洒进堆满旧电器和工具的维修店。林晓禾坐在工作台前，手持螺丝刀专注地修理一台风扇。沈曼云坐在对面，神情诚恳。</w:t></w:r></w:p><w:p w14:paraId="57E648C8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷淡，手中动作不停）：那您来干什么？</w:t></w:r></w:p><w:p w14:paraId="4DF60464"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（诚恳，略带愧疚）：来承认是我错了。</w:t></w:r></w:p><w:p w14:paraId="2FD66C20"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾停下手中的动作，抬头看了一眼沈曼云，随即继续低头修理。</w:t></w:r></w:p><w:p w14:paraId="4CA2CFBC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静）：这话我听见了，其他的以后再说。</w:t></w:r></w:p><w:p w14:paraId="7868BF07"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向店门口，一群围观群众堵在门口张望。林晓禾抬头看向门口。</w:t></w:r></w:p><w:p w14:paraId="39466A00"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（提高音量，不耐烦）：想看热闹的散了吧，我这修东西，挡着门耽误做生意。</w:t></w:r></w:p><w:p w14:paraId="2B6A5B3A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云微微点头，起身离开。画面切换到街道，一辆黑色迈巴赫轿车驶来停在店门口，车牌号清晰可见。</w:t></w:r></w:p><w:p w14:paraId="5461B292"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 车门打开，周明川身穿深灰色西装下车，身后跟着保镖甲和助理，保镖手中捧着两个精致的红木礼盒。三人走向店内。</w:t></w:r></w:p><w:p w14:paraId="32471904"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>路人甲（震惊，张大嘴巴）：我的天这阵仗。</w:t></w:r></w:p><w:p w14:paraId="3AF23267"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>芬姨（惊讶，指着车队）：刚才是他的妈来，现在儿子亲自出马，这是要干啥啊？</w:t></w:r></w:p><w:p w14:paraId="43FAFC6B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川走进店内，将两个红木礼盒放在林晓禾面前的工作台上。</w:t></w:r></w:p><w:p w14:paraId="35C3B70B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（温和，注视林晓禾）：晓禾。</w:t></w:r></w:p><w:p w14:paraId="796605C6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（讽刺，并未抬头）：沈董刚走，周总接着来，你们家道歉还带轮班的？</w:t></w:r></w:p><w:p w14:paraId="39172936"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川打开其中一个礼盒，露出里面的车钥匙和房产证。</w:t></w:r></w:p><w:p w14:paraId="74C2EFF6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真，语气坚定）：城南江景苑，280平江景房，已经过户到你名下。还有这辆车，配24小时司机，你出门拉货都能用。</w:t></w:r></w:p><w:p w14:paraId="501A548C"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="639D7A86"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第51集</w:t></w:r></w:p><w:p w14:paraId="518A833F"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>51-1 晓禾旧货维修店 日 外/内</w:t></w:r></w:p><w:p w14:paraId="21E9A65B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：大爷、王姨、路人甲、林晓禾、周明川、芬姨</w:t></w:r></w:p><w:p w14:paraId="03F68993"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修店门口，几位邻居围在一起议论纷纷。大爷指着店内方向，神情激动。</w:t></w:r></w:p><w:p w14:paraId="49B47F1F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>大爷（震惊，指指点点）：江景苑，那地方一平好几万呢。</w:t></w:r></w:p><w:p w14:paraId="4C122F68"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 王姨双手捂住胸口，瞪大眼睛，一脸不可思议。</w:t></w:r></w:p><w:p w14:paraId="5C182BEF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>王姨</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>（</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>震惊</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>）：我的妈呀，一出手就是一套房一辆车，这是要把晓禾娶回去啊。</w:t></w:r></w:p><w:p w14:paraId="14C2B794"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 店内，林晓禾坐在工作台前，手持螺丝刀正在修理一个风扇部件，头也不抬。</w:t></w:r></w:p><w:p w14:paraId="350BD6EC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷淡，手中动作不停）：周总这是打算把我这几天的真心，按市场价结算一下。</w:t></w:r></w:p><w:p w14:paraId="505AF8B5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川身穿深灰色西装站在店门口，逆光看着林晓禾，神情急切。</w:t></w:r></w:p><w:p w14:paraId="1226283B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（焦急，上前一步）：我不是这个意思。</w:t></w:r></w:p><w:p w14:paraId="01FDDD0C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾停下手中的活，抬头看向周明川，眼神锐利。</w:t></w:r></w:p><w:p w14:paraId="6DEC3A0B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（讽刺，目光直视）：房，车，再加你兜里那张不限额黑卡，你觉得我收下这些，之前被骗的事就一笔勾销了？拿回去。</w:t></w:r></w:p><w:p w14:paraId="573AA126"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（受伤，低声）：晓禾。</w:t></w:r></w:p><w:p w14:paraId="0A13CA86"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾站起身，将手中的工具重重拍在桌上，情绪激动地指着周明川。</w:t></w:r></w:p><w:p w14:paraId="7E7297C4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（愤怒，提高音量）：我要是图这些，当初听见你月薪五千就该走，用不着等今天。你现在拿这些砸过来，是觉得我之前对你好全是因为没看清你有钱？</w:t></w:r></w:p><w:p w14:paraId="61D72279"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 店门口的围观人群中，芬姨手捂嘴巴，满眼震惊。</w:t></w:r></w:p><w:p w14:paraId="7A788198"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>芬姨（震惊，手捂嘴）：几百万的房和车，说不要就不要了。</w:t></w:r></w:p><w:p w14:paraId="54C12527"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 王姨看着林晓禾的背影，脸上露出赞许的笑容。</w:t></w:r></w:p><w:p w14:paraId="4B868131"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>王姨（赞赏，点头）：我就说晓禾不是那种人，这姑娘硬气。</w:t></w:r></w:p><w:p w14:paraId="30DD9CBF"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="56D6C9FA"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第52集</w:t></w:r></w:p><w:p w14:paraId="5365604F"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>52-1 周家老屋 日 内</w:t></w:r></w:p><w:p w14:paraId="25DC4EDE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、周启山</w:t></w:r></w:p><w:p w14:paraId="288A853C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 斑驳的旧屋内，墙皮脱落，挂着一幅“家和万事兴”的字画和一个老式挂钟。周明川身穿深灰色西装走进屋内，神情落寞。</w:t></w:r></w:p><w:p w14:paraId="2AD655A5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（沉重）：她进这个家第一天，就在想怎么把日子修好。我却到最后，还想着用钱</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>把问题解决掉。</w:t></w:r></w:p><w:p w14:paraId="03CE6568"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川走到一张旧木桌前，拉开抽屉，里面放着一块写着“能修，别扔”的硬纸板。他拿起纸板，眼眶微红。</w:t></w:r></w:p><w:p w14:paraId="7D5B6A11"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周启山身穿棕色西装，拄着拐杖从门口走进来，看着周明川。</w:t></w:r></w:p><w:p w14:paraId="7892E66A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（平静）：你妈已经去道过歉了。</w:t></w:r></w:p><w:p w14:paraId="2186A839"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（低沉）：我知道。</w:t></w:r></w:p><w:p w14:paraId="45463E7C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（陈述）：房和车，人家没收。</w:t></w:r></w:p><w:p w14:paraId="0AD26675"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（苦笑）：没收，还把我怼回来了。</w:t></w:r></w:p><w:p w14:paraId="22B502D0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（轻笑，摇头）：哈哈这回知道了，钱不能用来解决感情的事。</w:t></w:r></w:p><w:p w14:paraId="666D9107"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（抬头，眼神坚定）：爸，我想换个法子。</w:t></w:r></w:p><w:p w14:paraId="20FBC864"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（疑惑）：怎么换？</w:t></w:r></w:p><w:p w14:paraId="2AE83058"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真）：她以前喜欢的是那个会干活能搭把手的我，我就先把这部分做回真的。</w:t></w:r></w:p><w:p w14:paraId="184F9CEF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（惊讶）：不坐办公室，去修破烂？</w:t></w:r></w:p><w:p w14:paraId="4B79ABF0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（诚恳）：之前是我骗了她，这次是我该做的。</w:t></w:r></w:p><w:p w14:paraId="4C65DE18"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周启山拍了拍周明川的肩膀。</w:t></w:r></w:p><w:p w14:paraId="0FEB2CA7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（欣慰）：这回总算有点像话。</w:t></w:r></w:p><w:p w14:paraId="118C6EE2"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="1C9282E5"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第53集</w:t></w:r></w:p><w:p w14:paraId="4E3C310D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>53-1 盛川集团会议室 日 内</w:t></w:r></w:p><w:p w14:paraId="16F037EB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、李经理、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>老年男子</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、沈曼云、职员群演甲、职员群演乙、职员群演丙、职员群演丁、职员群演戊</w:t></w:r></w:p><w:p w14:paraId="7F1167AA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 宽敞明亮的现代化会议室，长形会议桌两侧坐着多位职员。墙上挂着&quot;盛川集团 SHENGCHUAN GROUP&quot;标识和标语&quot;台川就是命令 舆情就是战场&quot;。前方大屏幕显示&quot;实时舆情监测&quot;数据图表，红色数字显示热度指数。</w:t></w:r></w:p><w:p w14:paraId="22606BCA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 李经理站在周明川身旁，手持文件汇报工作。周明川身穿深灰色西装三件套，坐在主位，神情严肃。</w:t></w:r></w:p><w:p w14:paraId="4926DA37"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（恭敬，继续汇报）：周总，只要您不再公开回应，热度两天会下去，林小姐那边我们也可以联系，给一笔补偿，签保密。</w:t></w:r></w:p><w:p w14:paraId="79D0B6CB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（冷声打断）：不准联系她谈钱。</w:t></w:r></w:p><w:p w14:paraId="2E2D56C4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（犹豫）：可品牌风险……</w:t></w:r></w:p><w:p w14:paraId="17FFE81B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坚定）：是我做错了事，不是他制造风险，所有后果我担。</w:t></w:r></w:p><w:p w14:paraId="16A6052D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（推眼镜，询问）：那对外怎么说？</w:t></w:r></w:p><w:p w14:paraId="7C2B7205"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（冷静指示）：如果必须回应，就说身份隐瞒是我个人决定，我向当事人郑重道歉。不要写他职业，不要包装他，也不要把责任推给相亲平台。</w:t></w:r></w:p><w:p w14:paraId="37251C7E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向会议桌另一侧，</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>老年男子</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>身穿深棕色中式上衣，佩戴佛珠项链，神情凝重地看着周明川。</w:t></w:r></w:p><w:p w14:paraId="1DBAA6B3"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>老年男子</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（语重心长）：明川，你以后要接整个集团，私人生活也会影响公司声誉。</w:t></w:r></w:p><w:p w14:paraId="252F5F78"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（目光坚定）：所以我更不能为了公司形象，再让他替我承担一次后果。</w:t></w:r></w:p><w:p w14:paraId="1C857BD6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向沈曼云，她身穿黑色旗袍，佩戴珍珠项链和翡翠耳环，面带欣慰的微笑看着周明川。</w:t></w:r></w:p><w:p w14:paraId="5881C124"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（微笑，感慨）：以前我教他控风险，现在他终于知道，有些责任不能转嫁。</w:t></w:r></w:p><w:p w14:paraId="00FE5F09"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="475AE042"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第54集</w:t></w:r></w:p><w:p w14:paraId="72200A0D"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>54-1 晓禾旧货维修店门口 夜 外</w:t></w:r></w:p><w:p w14:paraId="676C103F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="6840BC03"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜色中的街道，路灯昏黄。一家挂着“晓禾旧货维修”蓝底白字招牌的店铺卷帘门紧闭。</w:t></w:r></w:p><w:p w14:paraId="2AC7EA2C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾穿着沾有污渍的背带裤，正伸手去拉卷帘门。周明川身穿深蓝色工装，手提橙色工具箱站在她身后。</w:t></w:r></w:p><w:p w14:paraId="3639CBC4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾停下动作，转身看向周明川，眼神中带着审视和讽刺。</w:t></w:r></w:p><w:p w14:paraId="309FAA30"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（嘲讽）：周大少爷，这次又准备演什么？房和车都不收，还想送什么？</w:t></w:r></w:p><w:p w14:paraId="4EA780BE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川放下手中的工具箱，神情认真且诚恳地看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="3827B601"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（诚恳）：这次不送东西。我会修车，这是真的。我想把我们之间的关系也修回来。</w:t></w:r></w:p><w:p w14:paraId="6CC7ED4E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾微微低头，语气平淡地回应。</w:t></w:r></w:p><w:p w14:paraId="025DD6A0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷淡）：人不是机器。</w:t></w:r></w:p><w:p w14:paraId="5875E3BD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川急切地解释，语速稍快。</w:t></w:r></w:p><w:p w14:paraId="1EDE70D7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（急切，坦白）：所以我先学着做人。以前我习惯拿钱解决问题，是我错了。从今天起，我每天下班过来，免费干活，拆冰箱搬货修电路，什么都干。</w:t></w:r></w:p><w:p w14:paraId="09CF079A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾抬头看着周明川，双臂抱在胸前，态度坚决。</w:t></w:r></w:p><w:p w14:paraId="17D86A58"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（拒绝）：我这庙小，容不下盛川集团的周总来打工。</w:t></w:r></w:p><w:p w14:paraId="1DA831A5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川目光坚定，向前迈了一小步。</w:t></w:r></w:p><w:p w14:paraId="5DCF57EA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坚定）：在这里我不是周总。我就是个犯了错，想弥补的人。你不用给我好脸色，也不用原谅我，让我干活就行。</w:t></w:r></w:p><w:p w14:paraId="20A347C0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾盯着周明川看了一会儿，表情严肃。</w:t></w:r></w:p><w:p w14:paraId="2E877240"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：我店里不养闲人，干不好照样骂。</w:t></w:r></w:p><w:p w14:paraId="52719E79"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川脸上露出一丝如释重负的微笑。</w:t></w:r></w:p><w:p w14:paraId="40309351"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（欣喜）：能进就行。</w:t></w:r></w:p><w:p w14:paraId="22146405"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="2720D732"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第55集</w:t></w:r></w:p><w:p w14:paraId="494E250C"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>55-1 晓禾旧货维修店 日 内</w:t></w:r></w:p><w:p w14:paraId="26673003"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、王姨、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>芬姨</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>陈奶奶、顾客、路人甲</w:t></w:r></w:p><w:p w14:paraId="6B6BB398"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光透过卷帘门射入堆满旧电器的维修店内。周明川身穿深蓝色工装，正弯腰搬动一台机器。</w:t></w:r></w:p><w:p w14:paraId="68B1A8AB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>芬姨</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>提着两袋蔬菜走进店里，身后跟着陈奶奶和王姨，三人驻足观看周明川干活。</w:t></w:r></w:p><w:p w14:paraId="610573C7"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>芬姨</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（惊讶，指着周明川）：哎你看，真是新闻里那个周总，放着百亿家产不享，跑这修破烂来了。</w:t></w:r></w:p><w:p w14:paraId="52D4D07A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>王姨（不屑）：我看就是新鲜劲，过两天就受不了这苦了。</w:t></w:r></w:p><w:p w14:paraId="55C4CF9A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>芬姨</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>走到正在擦拭零件的林晓禾身边。</w:t></w:r></w:p><w:p w14:paraId="2D8C53CE"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>芬姨</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（好奇）：晓禾，这真是盛川那个周总啊？</w:t></w:r></w:p><w:p w14:paraId="17692B17"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（淡定，继续擦拭零件）：修风扇的时候不是周总，是免费劳力。</w:t></w:r></w:p><w:p w14:paraId="123A4E98"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一名身穿西装的顾客抱着一台银色空气净化器急匆匆走进店里。</w:t></w:r></w:p><w:p w14:paraId="415B1D35"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>顾客（焦急）：售后说主板烧了，换一套一千二，你们要是能今天换主板，我就放这修。</w:t></w:r></w:p><w:p w14:paraId="0746C6D3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川接过净化器，熟练地用螺丝刀拆开外壳检查内部线路。</w:t></w:r></w:p><w:p w14:paraId="2D07AA78"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（调侃）：换主板能收一千二，你亏了。</w:t></w:r></w:p><w:p w14:paraId="75AAAD43"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（专注检查）：排线坏了，收人家一千二干什么。</w:t></w:r></w:p><w:p w14:paraId="0B662853"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（打趣）：集团继承人也知道几十块钱是钱？</w:t></w:r></w:p><w:p w14:paraId="47711DC6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川抬头看向林晓禾，露出一丝微笑，继续手中的焊接工作。</w:t></w:r></w:p><w:p w14:paraId="25A74A11"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（轻松）：最近拜了个师傅，天天在我耳边念叨能修别扔。</w:t></w:r></w:p><w:p w14:paraId="0DACC9A1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（玩笑）：师傅收徒很贵。</w:t></w:r></w:p><w:p w14:paraId="10994128"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真）：我慢慢还。</w:t></w:r></w:p><w:p w14:paraId="1FA06413"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="059E691E"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第56集</w:t></w:r></w:p><w:p w14:paraId="2F540BCA"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>56-1 晓禾旧货维修店 日 内</w:t></w:r></w:p><w:p w14:paraId="136130DD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、女顾客、林小满</w:t></w:r></w:p><w:p w14:paraId="6C817854"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光透过卷帘门射入堆满旧电器的维修店内。周明川身穿深蓝色工装，手持电烙铁正在焊接电路板，神情专注且带着一丝微笑。</w:t></w:r></w:p><w:p w14:paraId="7340A981"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，温柔）：她不说原谅，可已经开始重新把工具递给我。</w:t></w:r></w:p><w:p w14:paraId="16490FB3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一位身穿米色碎花连衣裙的中年女顾客气势汹汹地冲进店里，指着工作台大声质问。</w:t></w:r></w:p><w:p w14:paraId="78B3434B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>女顾客（愤怒，焦急）：我放在洗衣机上的金项链不见了！修之前还在，送过来就没了！</w:t></w:r></w:p><w:p w14:paraId="278CB78C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾放下手中的工具，抬头冷静地看着女顾客。</w:t></w:r></w:p><w:p w14:paraId="2737C752"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静，解释）：您送来时登记单只写了机器故障，没有登记贵重物品。</w:t></w:r></w:p><w:p w14:paraId="0CE2F466"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>女顾客（激动，指手画脚）：我记得清清楚楚，就压在毛巾下面！你们修东西的人手最杂，谁知道拿没拿？</w:t></w:r></w:p><w:p w14:paraId="703C2908"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 背景处身穿白T恤的林小满猛地站起来，一脸怒容地走向前。</w:t></w:r></w:p><w:p w14:paraId="003D01B6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（愤怒，大声）：你别血口喷人！</w:t></w:r></w:p><w:p w14:paraId="3B8DC47D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>女顾客（咄咄逼人）：不是你们还有谁？</w:t></w:r></w:p><w:p w14:paraId="4CA076DE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站起身，挡在林晓禾身前，目光坚定地看着女顾客。</w:t></w:r></w:p><w:p w14:paraId="7F3990CF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坚定）：不是他。</w:t></w:r></w:p><w:p w14:paraId="44D7C3FB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>女顾客（质疑）：你都没查，凭什么说不是他？</w:t></w:r></w:p><w:p w14:paraId="4956C895"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（毫不犹豫）：因为我信他。</w:t></w:r></w:p><w:p w14:paraId="4AF45EBD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头特写林晓禾的脸，她眼眶瞬间红了，泪水在打转，嘴角却微微上扬露出感动的笑意。</w:t></w:r></w:p><w:p w14:paraId="647FC976"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，感动）：以前他看我做十件事，才敢相信一件。现在他连问都没问……</w:t></w:r></w:p><w:p w14:paraId="1C6EBB3B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川转向女顾客，语气平和但有力。</w:t></w:r></w:p><w:p w14:paraId="4256B996"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真）：但项链可以一起找。机器只修了排水泵，内桶没动过。</w:t></w:r></w:p><w:p w14:paraId="3CD107F1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川和林晓禾蹲在一台拆开的洗衣机旁，周明川拿着拆下的零件，林晓禾用镊子从洗衣机内桶的滤网中夹出了一条金项链。</w:t></w:r></w:p><w:p w14:paraId="0D415D4E"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="0BADF789"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第57集</w:t></w:r></w:p><w:p w14:paraId="3CF32A16"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>57-1 晓禾旧货维修店 日 内</w:t></w:r></w:p><w:p w14:paraId="53FA35DB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>女顾客</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="030123C2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 堆满旧电器和工具的维修店内，光线明亮。</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>女顾客</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>身穿米色碎花连衣裙，面带歉意地看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="242917E0"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>女顾客</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（愧疚，急切）：对不住对不住，我刚才急糊涂了。</w:t></w:r></w:p><w:p w14:paraId="129A1D76"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾坐在工作台前，手里拿着工具，微笑着看向</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>女顾客</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="47B0B3CD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（宽慰，轻松）：找回来就行，下次贵重东西别放机器边上。</w:t></w:r></w:p><w:p w14:paraId="79F4B724"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾低头继续手中的修理工作，嘴角带着笑意。</w:t></w:r></w:p><w:p w14:paraId="4A53ECCF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（调侃，抬头）：你刚才不怕我真拿了？</w:t></w:r></w:p><w:p w14:paraId="4AD32B97"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向站在一旁的周明川，他身穿深蓝色工装，神情认真地看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="7A76B20B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真，坚定）：怕。</w:t></w:r></w:p><w:p w14:paraId="622915AB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川走近几步，目光温柔地注视着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="31B8E0A0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（温柔，诚恳）：但怕，不代表先怀疑你。你先信人，再一起把事弄清楚。</w:t></w:r></w:p><w:p w14:paraId="58665912"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 特写镜头，林晓禾的手熟练地用螺丝刀拧紧电路板上的螺丝。</w:t></w:r></w:p><w:p w14:paraId="23CC0039"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="4953FEE0"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>57-2 街道（晓禾旧货维修店门口） 傍 外</w:t></w:r></w:p><w:p w14:paraId="263B0F95"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="28E449AD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夕阳余晖洒在街道上。店铺招牌“晓禾旧货维修店”清晰可见。林晓禾骑着一辆蓝色的电动三轮车，周明川从店门口走出，利落地跳上三轮车后斗坐下。</w:t></w:r></w:p><w:p w14:paraId="01387C38"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 三轮车缓缓启动，两人并排坐在车上。</w:t></w:r></w:p><w:p w14:paraId="30F0E9D7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（好奇，侧头）：盛川集团没有车？</w:t></w:r></w:p><w:p w14:paraId="264B45F0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（淡定）：有。</w:t></w:r></w:p><w:p w14:paraId="27EA1963"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（疑惑）：那坐我这个干嘛？</w:t></w:r></w:p><w:p w14:paraId="2445870D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（微笑，回忆）：第一次约会就坐这里，习惯了。</w:t></w:r></w:p><w:p w14:paraId="0664DEB9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（打趣）：那时候你是穷汽修工。</w:t></w:r></w:p><w:p w14:paraId="5F371B07"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（得意，玩笑）：现在我是有钱汽修工。</w:t></w:r></w:p><w:p w14:paraId="5CAF62E5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾被逗乐，忍不住露出了笑容。</w:t></w:r></w:p><w:p w14:paraId="51BDDBFB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（惊喜，注视）：你笑了。</w:t></w:r></w:p><w:p w14:paraId="16A497EA"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（掩饰，嘴硬）：路颠的。</w:t></w:r></w:p><w:p w14:paraId="707492D5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（拆穿，含笑）：这路很平。</w:t></w:r></w:p><w:p w14:paraId="6A4C8B48"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（佯装生气，警告）：再说下车。</w:t></w:r></w:p><w:p w14:paraId="3A563BF1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川看着前方，脸上挂着宠溺的笑容，不再说话。三轮车在街道上平稳行驶。</w:t></w:r></w:p><w:p w14:paraId="279B00E8"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="557CD593"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第58集</w:t></w:r></w:p><w:p w14:paraId="14ED79CF"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t xml:space="preserve">58-1 </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾</w:t></w:r><w:r><w:t>家 日 内</w:t></w:r></w:p><w:p w14:paraId="0AF4BAF8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、周明川</w:t></w:r></w:p><w:p w14:paraId="033FDE43"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 简朴的客厅内，阳光透过窗户洒入。</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>坐在沙发上，手里端着茶杯，神情忧虑地看着面前的周明川。周明川身穿深蓝色工装，站在母亲面前，随后蹲下身子倾听。</w:t></w:r></w:p><w:p w14:paraId="382D4FC1"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（忧虑，语重心长）：知道你有钱以后，我反而更不放心。</w:t></w:r></w:p><w:p w14:paraId="36A07D2C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真）：我明白。</w:t></w:r></w:p><w:p w14:paraId="1073F518"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（感慨）：穷人家的日子，怕的是没钱。有钱人家的日子，我现在知道了，怕的是把别人当东西挑。</w:t></w:r></w:p><w:p w14:paraId="68FDF892"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（愧疚）：以前是我们做错了。</w:t></w:r></w:p><w:p w14:paraId="599B2411"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（严肃）：你家再有钱，晓禾也不是你们买回去的。</w:t></w:r></w:p><w:p w14:paraId="029F5821"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坚定）：我不会再让他证明什么。</w:t></w:r></w:p><w:p w14:paraId="432ED67E"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（摇头）：这句话不是说给我听的。</w:t></w:r></w:p><w:p w14:paraId="54D4EFE2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（目光坚定）：我会证明给晓禾看。</w:t></w:r></w:p><w:p w14:paraId="5D97C86C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>拿起桌上的红苹果，递给周明川。</w:t></w:r></w:p><w:p w14:paraId="756ADF30"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（缓和语气）：吃苹果。</w:t></w:r></w:p><w:p w14:paraId="353608CF"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="0403A5D5"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>58-2 晓禾旧货维修店 夜 内</w:t></w:r></w:p><w:p w14:paraId="1CC8261B"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾</w:t></w:r></w:p><w:p w14:paraId="4A111DD1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 维修店内灯光昏黄，窗外下着大雨。林晓禾正在整理工具包，周明川在一旁帮忙。桌上的老式电话突然响起。</w:t></w:r></w:p><w:p w14:paraId="37C427CD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾接起电话。</w:t></w:r></w:p><w:p w14:paraId="351569D8"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老爷爷</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（电话音，焦急）：晓禾我家突然全没电了，闸怎么推都推不上。</w:t></w:r></w:p><w:p w14:paraId="6031DC40"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（关切，快速询问）：总闸拉了吗？别碰插座，小心触电。</w:t></w:r></w:p><w:p w14:paraId="00B819B8"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老爷爷</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（电话音，慌张）：拉了拉了，可冰箱里存着我老伴的胰岛素，必须冷藏，断一晚上就全废了。</w:t></w:r></w:p><w:p w14:paraId="2763D517"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（果断）：行我知道了，您别碰电线，我马上过去。</w:t></w:r></w:p><w:p w14:paraId="7EDD27D1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾挂断电话，迅速穿上一件透明雨衣。周明川见状也站起身，拿起抹布擦手。</w:t></w:r></w:p><w:p w14:paraId="734DA468"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（急切）：我跟你一起去。</w:t></w:r></w:p><w:p w14:paraId="020F6598"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="0AC47384"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第59集</w:t></w:r></w:p><w:p w14:paraId="091964EC"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>59-1 老街巷口 夜 外</w:t></w:r></w:p><w:p w14:paraId="769F4D96"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="0F20219D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 大雨滂沱的夜晚，街道湿滑反光。林晓禾身穿透明雨衣，神情焦急地对周明川说话。</w:t></w:r></w:p><w:p w14:paraId="7FDDB547"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（焦急）：雨太大，你叫司机送你回去，别跟着跑一趟。</w:t></w:r></w:p><w:p w14:paraId="584A1FE3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站在店铺门口，手里拿着塑料袋，神色轻松。</w:t></w:r></w:p><w:p w14:paraId="5DB47990"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（轻松）：司机早走了，我坐三轮跟你去，搭把手也快。</w:t></w:r></w:p><w:p w14:paraId="4812279D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 两人骑着一辆蓝色电动三轮车在雨中行驶，林晓禾驾驶，周明川坐在后斗扶着栏杆。突然三轮车链条脱落掉在地上，溅起水花。</w:t></w:r></w:p><w:p w14:paraId="18845E0B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川跳下车，蹲在积水中修理链条，雨水打湿了他的工装裤。</w:t></w:r></w:p><w:p w14:paraId="7BE3ECE9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（心疼）：你工作裤都湿了。</w:t></w:r></w:p><w:p w14:paraId="65AA1153"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（不在意，笑着）：修理工哪有不淋两下的。</w:t></w:r></w:p><w:p w14:paraId="7EB0D65A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川手上沾满油污和泥水，手背被划伤流血。林晓禾撑着伞凑近查看。</w:t></w:r></w:p><w:p w14:paraId="3A3DF9DC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（关切）：疼不疼？</w:t></w:r></w:p><w:p w14:paraId="21146924"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（深情注视）：没你不理我疼。</w:t></w:r></w:p><w:p w14:paraId="46C849C8"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（嗔怪）：少贫，手给我看。</w:t></w:r></w:p><w:p w14:paraId="68C83531"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="5C6B1C06"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t xml:space="preserve">59-2 </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老爷爷</w:t></w:r><w:r><w:t>家 夜 内</w:t></w:r></w:p><w:p w14:paraId="56F53488"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:lang w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老爷爷</w:t></w:r></w:p><w:p w14:paraId="3DEBCDF6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 昏暗的屋内，林晓禾蹲在地上用钳子修理插座，周明川手持手电筒照明。</w:t></w:r></w:p><w:p w14:paraId="4F697321"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 门打开，</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老爷爷</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>站在门口，满脸歉意地看着两人。</w:t></w:r></w:p><w:p w14:paraId="644A07D9"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老爷爷</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（过意不去）：哎呀这么大的雨，还麻烦你们两口子跑一趟。</w:t></w:r></w:p><w:p w14:paraId="39D323D2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾站起身，有些尴尬地看向周明川。</w:t></w:r></w:p><w:p w14:paraId="634AF152"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（尴尬）：还不是……</w:t></w:r></w:p><w:p w14:paraId="5B1D4353"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（微笑接话）：努力中。</w:t></w:r></w:p><w:p w14:paraId="54429EEC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>老爷爷</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>看着两人开怀大笑。</w:t></w:r></w:p><w:p w14:paraId="5DEFBE73"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="6A0ADC6A"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>59-3 老街巷口 夜 外</w:t></w:r></w:p><w:p w14:paraId="3ADA701E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="3EB7AC03"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 雨夜街头，两人再次骑上三轮车。周明川在后座撑着一把黑伞，大半伞面倾斜向林晓禾一侧。</w:t></w:r></w:p><w:p w14:paraId="1CE6E7D2"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾 os（内心独白，温柔）：第一次他这么撑伞，我只觉得他有点傻。现在才发现，有些习惯不是演出来的。</w:t></w:r></w:p><w:p w14:paraId="71BE1CBE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头特写林晓禾的脸，她嘴角微微上扬，眼神中流露出感动与柔情。</w:t></w:r></w:p><w:p w14:paraId="7A7D0C62"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="1A18DEB0"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第60集</w:t></w:r></w:p><w:p w14:paraId="2A573E29"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>60-1 晓禾旧货维修店 日 外/内</w:t></w:r></w:p><w:p w14:paraId="54E9BF68"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、李经理、林小满</w:t></w:r></w:p><w:p w14:paraId="6CCBABF9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光明媚的白天，一家名为“晓禾旧货维修店”的店铺门口。店内堆满了旧电视和电器零件。李经理身穿黑色西装，手持一份文件站在柜台前，对面站着穿米色T恤的林晓禾和穿白T恤的林小满。</w:t></w:r></w:p><w:p w14:paraId="3F0D88DB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（职业微笑，递过文件）：林小姐，这波热度非常难得，品牌名我们保留，您只要出镜，三年签约费八百万，包装你做全国维修女神IP。</w:t></w:r></w:p><w:p w14:paraId="7344838D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头特写文件标题《请货续维会书》（字幕显示）。林小满瞪大眼睛，一脸震惊。林晓禾接过文件快速翻阅。</w:t></w:r></w:p><w:p w14:paraId="001777C3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静，翻看着文件）：以后还修不修老人二十块钱的电饭煲？</w:t></w:r></w:p><w:p w14:paraId="003A3440"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（轻笑，不以为然）：那种单子没商业价值，主营转高端二手精品就行。</w:t></w:r></w:p><w:p w14:paraId="4D3F1A1F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾合上文件夹，将其推回给李经理。</w:t></w:r></w:p><w:p w14:paraId="4E2F6565"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（果断）：那不卖。</w:t></w:r></w:p><w:p w14:paraId="4CEC53E7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（震惊，难以置信）：八百万您都不考虑？</w:t></w:r></w:p><w:p w14:paraId="14961FD0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（直视对方，语气坚定）：你买的是热度，不是我的店。</w:t></w:r></w:p><w:p w14:paraId="45572D62"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>李经理（急切，试图说服）：做生意总要升级。</w:t></w:r></w:p><w:p w14:paraId="32F80E46"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：升级不是把老客人扔出去。</w:t></w:r></w:p><w:p w14:paraId="09C1CEC0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 李经理无奈地看了一眼手表，转身离开。此时，换了一身深蓝色工装的周明川从店后方走出。</w:t></w:r></w:p><w:p w14:paraId="49E51663"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（惊讶，看着姐姐）：八百万都不要。</w:t></w:r></w:p><w:p w14:paraId="0F8832BC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（转头看向弟弟，调侃）：怎么，心疼？</w:t></w:r></w:p><w:p w14:paraId="02CC4AD9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（认真，摇头）：我只是确定了，你当初没图我钱，不是因为不知道钱好。</w:t></w:r></w:p><w:p w14:paraId="25A59C3A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（淡然）：钱当然好，不是自己的拿着扎手。</w:t></w:r></w:p><w:p w14:paraId="22930A3C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川站在一旁，目光温柔地注视着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="1403A848"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川 os（内心独白，深情）：她从来不是不爱钱，她只是比谁都清楚，什么钱该挣，什么钱不该拿。</w:t></w:r></w:p><w:p w14:paraId="5A58AC03"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="658ACBBC"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第61集</w:t></w:r></w:p><w:p w14:paraId="4C3C516A"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>61-1 林晓禾家（造型间） 日 内</w:t></w:r></w:p><w:p w14:paraId="6AF45E32"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:lang w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>造型师</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、林小满、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r></w:p><w:p w14:paraId="496E44EF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光透过窗户洒进房间，衣架上挂满了各式华丽礼服，桌上摆放着带灯泡的化妆镜和首饰盒。林小满趴在楼梯扶手上张望，</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>从后方走来拍了拍他的肩膀。</w:t></w:r></w:p><w:p w14:paraId="3EB5ED58"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>造型师</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>身穿白色西装，手提黑色化妆箱走向穿着米色T恤和牛仔裤的林晓禾。</w:t></w:r></w:p><w:p w14:paraId="5FB7346B"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>造型师</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（微笑，职业）：林小姐，沈董交代了，今晚家宴您的造型由我们全权负责。</w:t></w:r></w:p><w:p w14:paraId="471053A1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（惊讶，皱眉）：我就去吃个饭，用得着这么大阵仗？</w:t></w:r></w:p><w:p w14:paraId="08D41E75"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>造型师</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（耐心解释）：沈董说，周家的儿媳妇第一次正式出席家宴，不能委屈了。</w:t></w:r></w:p><w:p w14:paraId="6AB6855C"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（热情，劝说）：人家大老远来了，你就试试，又不是让你天天穿。</w:t></w:r></w:p><w:p w14:paraId="36D1535B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">△ </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>造型师</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>递给林晓禾一个印有“BALENCIAGA”字样的透明包装袋，并推着她走向更衣室。</w:t></w:r></w:p><w:p w14:paraId="2167AC41"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 房门打开，林晓禾换上了一袭白色抹胸蕾丝礼服，佩戴着璀璨的钻石项链和耳环，缓缓走出，神情略显局促。</w:t></w:r></w:p><w:p w14:paraId="21ED58F7"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林小满（震惊，瞪大眼睛，手里的苹果掉落）：姐，你还是我姐吗</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>？</w:t></w:r></w:p><w:p w14:paraId="2586B536"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>林晓禾母亲（</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>感动</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>）：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>你爸要是看见，肯定高兴。</w:t></w:r></w:p><w:p w14:paraId="6BF7CAFF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾看着镜中的自己，眼神复杂。</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>造型师</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>走上前打量着她。</w:t></w:r></w:p><w:p w14:paraId="3AB14502"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>造型师</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（赞赏）：林小姐底子好，就是平时太忙没时间收拾，沈董眼光真好。</w:t></w:r></w:p><w:p w14:paraId="4A910CA0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（不安，摸着耳环）：这衣服多少钱？</w:t></w:r></w:p><w:p w14:paraId="5E8ADB0C"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>造型师</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（大方）：沈董说了，这些都是送您的。</w:t></w:r></w:p><w:p w14:paraId="1C522BAA"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="16707178"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第62集</w:t></w:r></w:p><w:p w14:paraId="074356D0"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>62-1 晓禾旧货维修店门口 日 外</w:t></w:r></w:p><w:p w14:paraId="048036A6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="1A7D8CEC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 阳光明媚的街道，一家名为&quot;晓禾旧货维修店&quot;的店铺前，招牌上写着&quot;旧货回收 家电维修 电路检测 配件更换&quot;。周明川身穿深灰色三件套西装站在店门口，面对穿着白色抹胸蕾丝礼服的林晓禾。</w:t></w:r></w:p><w:p w14:paraId="40E2944D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（温柔）：你今天很好看。</w:t></w:r></w:p><w:p w14:paraId="3E66EB1F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（怪，微笑）：少贫，再好看也是你妈花钱堆出来的。</w:t></w:r></w:p><w:p w14:paraId="71542F6A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真，深情）：不是衣服好看，是你。</w:t></w:r></w:p><w:p w14:paraId="20613A53"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾听到后脸颊微红，眼神略显羞涩。</w:t></w:r></w:p><w:p w14:paraId="643B0792"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="2CDCBAA7"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>62-2 周家豪宅餐厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="6C34C072"><w:pPr><w:rPr><w:rFonts w:hint="default" w:eastAsiaTheme="minorEastAsia"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾、沈曼云、周启山、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>珍珠项链女</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>、美玲、宾客群演甲、宾客群演乙</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>中年男子</w:t></w:r></w:p><w:p w14:paraId="0799FD66"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 豪华的餐厅内，巨大的水晶吊灯悬挂在天花板中央，长餐桌摆满了精致的餐具和美食。多位宾客围坐在桌旁用餐。</w:t></w:r></w:p><w:p w14:paraId="0F2605DC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川推开厚重的木门，牵着林晓禾的手走进餐厅。所有宾客的目光都投向他们。</w:t></w:r></w:p><w:p w14:paraId="6A2EC925"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>珍珠项链女</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（震惊，指着林晓禾）：这是那个修旧货的？</w:t></w:r></w:p><w:p w14:paraId="6D759FBC"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>中年男子</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>（感慨）：换身衣服跟换了个人似的。</w:t></w:r></w:p><w:p w14:paraId="1CB363A9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云身穿深蓝色旗袍，面带笑容地从座位上站起来，快步走向林晓禾。</w:t></w:r></w:p><w:p w14:paraId="7D70D580"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（热情，拉着林晓禾的手）：晓禾来了，快到阿姨这边坐。第一次来家吃饭，阿姨没什么好东西，这条项链你试试。</w:t></w:r></w:p><w:p w14:paraId="214288B1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云从助理手中接过一个黑色首饰盒，打开后露出一条璀璨夺目的钻石项链。</w:t></w:r></w:p><w:p w14:paraId="4F5DE726"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>美玲（震惊，瞪大眼睛）：嫂子，这不是你去年慈善晚宴拍的那条……</w:t></w:r></w:p><w:p w14:paraId="3A4AC5CF"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="5A833879"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第63集</w:t></w:r></w:p><w:p w14:paraId="541A68ED"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>63-1 周家豪宅餐厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="3984D19F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、林晓禾</w:t></w:r></w:p><w:p w14:paraId="5533AD81"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 豪华的餐厅内，水晶吊灯璀璨。沈曼云身穿深蓝色旗袍，正拿着一条钻石项链给身穿白色抹胸礼服的林晓禾戴上。</w:t></w:r></w:p><w:p w14:paraId="63D30991"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（满意，温柔）：正好，这链子压得住场子，配我们晓禾的气质。</w:t></w:r></w:p><w:p w14:paraId="6CA590BC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云帮林晓禾戴好项链，双手拉着她的手。</w:t></w:r></w:p><w:p w14:paraId="0A6156A6"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（慈爱，叮嘱）：戴着，阿姨送的，不许摘。</w:t></w:r></w:p><w:p w14:paraId="2C8873F9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾看着镜子里的自己，神情有些复杂。</w:t></w:r></w:p><w:p w14:paraId="6CC08EA5"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="6AF89240"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>63-2 周家豪宅餐厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="45EF39BC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：美玲、周明川、沈曼云</w:t></w:r></w:p><w:p w14:paraId="1B67A1EC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 餐桌上摆满了美食。身穿米色西装的美玲坐在桌边，轻蔑地看着对面，手中晃着红酒杯。</w:t></w:r></w:p><w:p w14:paraId="3159DAED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>美玲（轻蔑，冷笑）：穿的倒是人模狗样的，可明川，你别忘了，他到底是收废户的。</w:t></w:r></w:p><w:p w14:paraId="479FDDF3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 美玲喝了一口红酒，眼神犀利。</w:t></w:r></w:p><w:p w14:paraId="15868BD4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>美玲（嘲讽，提高音量）：今晚在座的都是集团股东和世交长辈，传出去周家继承人娶个修破烂的，圈子里怎么看？</w:t></w:r></w:p><w:p w14:paraId="0CB13D50"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向身穿西装的周明川，他面色阴沉，紧握拳头。</w:t></w:r></w:p><w:p w14:paraId="7530644C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云放下酒杯，神色严肃地看向美玲。</w:t></w:r></w:p><w:p w14:paraId="205E3277"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（质问，严厉）：美玲，你刚才说他什么出身？</w:t></w:r></w:p><w:p w14:paraId="1E116BD3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>美玲（理直气壮）：我就是实话实说。</w:t></w:r></w:p><w:p w14:paraId="1B49ADD1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（平静，回忆）：我年轻的时候，在路边摆云吞摊，一碗八块钱。你那时候见了我，也叫我一声嫂子。</w:t></w:r></w:p><w:p w14:paraId="00F9B012"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云目光坚定地看着美玲。</w:t></w:r></w:p><w:p w14:paraId="713476FC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（感慨，深沉）：他认识明川的时候，我在卖云吞，他爸坐轮椅，明川一个月五千，没房没车，婚房还是漏水的老破小。</w:t></w:r></w:p><w:p w14:paraId="557BC963"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="2B3AA48B"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第64集</w:t></w:r></w:p><w:p w14:paraId="7989C37A"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>64-1 周家豪宅餐厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="1F8E2305"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、周明川、林晓禾、周启山、美玲、吴倩、莉莉、女宾客甲</w:t></w:r></w:p><w:p w14:paraId="661DEBC4"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 豪华的餐厅内，水晶吊灯璀璨，长桌上摆满精致菜肴。众人围坐，气氛略显凝重。沈曼云身穿深蓝色旗袍，神情严肃地看着对面。</w:t></w:r></w:p><w:p w14:paraId="73EAB86F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（严肃，质问）：他那时候都没嫌弃，现在我们有什么资格嫌他？</w:t></w:r></w:p><w:p w14:paraId="354AE983"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头转向身穿灰色西装的周明川，他看着沈曼云，语气诚恳。</w:t></w:r></w:p><w:p w14:paraId="771EA5ED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（诚恳，辩解）：姑姑，我找老婆不是挑门面，她靠自己挣钱，没有一分钱来路不正，我不觉得她哪里不体面。</w:t></w:r></w:p><w:p w14:paraId="29455683"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云拿出一个红木盒子，打开后里面是一只翠绿的玉镯。她微笑着看向身旁的林晓禾。</w:t></w:r></w:p><w:p w14:paraId="59DFB7E5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（温和，慈爱）：是明川奶奶传给我的，周家的传家宝，只传给长房儿媳。今天我把它给你，不是因为你穿了高定，戴了项链，是因为你这个人配得上。</w:t></w:r></w:p><w:p w14:paraId="75A66DDD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云拉起林晓禾的手，将玉镯轻轻套在她的手腕上。林晓禾眼眶泛红，神情激动。</w:t></w:r></w:p><w:p w14:paraId="7E5C0608"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（感动，哽咽）：阿姨，这太贵重了。</w:t></w:r></w:p><w:p w14:paraId="3816AE01"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（温柔，纠正）：叫妈。</w:t></w:r></w:p><w:p w14:paraId="4BD8C311"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云紧紧握着林晓禾的手，目光坚定地看着她。</w:t></w:r></w:p><w:p w14:paraId="46606A23"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（坚定，承诺）：这个家，以后没人敢拿你的身份说你，有我在。</w:t></w:r></w:p><w:p w14:paraId="79FAF031"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 桌下，周明川伸手握住了林晓禾的另一只手，给予支持。</w:t></w:r></w:p><w:p w14:paraId="33D5AA1F"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="11F4A8CA"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>64-2 周家客厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="0710A04D"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia" w:eastAsiaTheme="minorEastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:val="en-US" w:eastAsia="zh-CN"/></w:rPr><w:t>人物：</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/><w:lang w:eastAsia="zh-CN"/></w:rPr><w:t>、</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾</w:t></w:r></w:p><w:p w14:paraId="745FA21D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 场景切换至客厅，灯光柔和。林晓禾坐在皮质沙发上，沈曼云站在茶几旁，正在用茶壶倒茶。</w:t></w:r></w:p><w:p w14:paraId="3485F890"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（感慨，回忆）：我年轻的时候真卖过云吞，那时候最怕别人看不起我摆摊。</w:t></w:r></w:p><w:p w14:paraId="10120607"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="7DD6E34C"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第65集</w:t></w:r></w:p><w:p w14:paraId="18360CA1"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>65-1 周家客厅 夜 内</w:t></w:r></w:p><w:p w14:paraId="53E00EC1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、林晓禾</w:t></w:r></w:p><w:p w14:paraId="6869D388"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 温馨的客厅内，灯光柔和。林晓禾身穿白色抹胸礼服坐在皮质沙发上，神情委屈。沈曼云身穿深蓝色旗袍坐在她身旁，茶几上放着一块写有“8元一碗”的木牌和一套茶具。</w:t></w:r></w:p><w:p w14:paraId="0637C40C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（平静，略带失望）：之前我还挺佩服您，觉得一个人摆摊撑过来不容易。</w:t></w:r></w:p><w:p w14:paraId="7E41785A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头特写沈曼云，她面带微笑但眼神复杂，似乎在回忆往事。</w:t></w:r></w:p><w:p w14:paraId="632CB9FD"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（感慨，自嘲）：后来钱越挣越多，我反而学会用条件看人，先控风险，再谈别的。</w:t></w:r></w:p><w:p w14:paraId="1C4D60B9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头切回林晓禾，她看着沈曼云，语气中带着一丝讽刺。</w:t></w:r></w:p><w:p w14:paraId="1D6F364E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷静，直视）：所以找儿媳妇，也得先筛查一遍风险。</w:t></w:r></w:p><w:p w14:paraId="5C916FD3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云低下头，双手交握，表情变得愧疚和沉重。</w:t></w:r></w:p><w:p w14:paraId="4F22794C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（愧疚，反思）：我当时真以为是替明川负责，怕他年轻看走眼。现在才懂，儿媳不是员工，婚姻也不是招聘。拿管公司那套管家事，是我糊涂。</w:t></w:r></w:p><w:p w14:paraId="63457E21"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云站起身，走到林晓禾面前，微微弯腰，态度诚恳地道歉。</w:t></w:r></w:p><w:p w14:paraId="5CC5F4B9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（诚恳，歉意）：晓禾对不起。这次不是沈董事长问你，是一个做错事的妈妈，问你还能不能再给我这个儿子一次机会。</w:t></w:r></w:p><w:p w14:paraId="310F6804"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾眼眶泛红，眼泪在打转，声音有些颤抖。</w:t></w:r></w:p><w:p w14:paraId="5DA2E888"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（委屈，含泪）：阿姨我不是因为你们有钱才生气。</w:t></w:r></w:p><w:p w14:paraId="168A4A54"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（诚恳，歉意）：我知道。</w:t></w:r></w:p><w:p w14:paraId="3E0FAFED"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（委屈，含泪）：我怕的是，我掏心掏肺跟你们商量过日子，回头你们告诉我，这全是一场考试。</w:t></w:r></w:p><w:p w14:paraId="51283659"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云眼神坚定，双手合十做出保证的姿态，肩上搭着一条浅色披肩。</w:t></w:r></w:p><w:p w14:paraId="5768AF8D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（坚定，承诺）：以后不会了，我保证。</w:t></w:r></w:p><w:p w14:paraId="1F075BA7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾拿起茶杯，深吸一口气，神情逐渐平复但仍显严肃。</w:t></w:r></w:p><w:p w14:paraId="620BF2FB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（认真，严肃）：这话我记下了。</w:t></w:r></w:p><w:p w14:paraId="185E05E4"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="3E26FC33"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第66集</w:t></w:r></w:p><w:p w14:paraId="21E6FC0B"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>66-1 别墅门口 夜 外</w:t></w:r></w:p><w:p w14:paraId="63CC4FE7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="3A08A666"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜晚，别墅大门敞开，暖黄灯光从屋内透出。周明川身穿深灰色西装站在台阶下等待。林晓禾身穿白色抹胸礼服从屋内走出，神情严肃地走下台阶。</w:t></w:r></w:p><w:p w14:paraId="5DA60C5F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（冷静，直视）：要我原谅也行，三个条件。</w:t></w:r></w:p><w:p w14:paraId="17FB820E"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（急切，诚恳）：你说，多少条依你。</w:t></w:r></w:p><w:p w14:paraId="25CE1DEB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃，条理清晰）：第一，有事直接问。</w:t></w:r></w:p><w:p w14:paraId="520D87FC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（干脆）：好。</w:t></w:r></w:p><w:p w14:paraId="799BEF1A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（严肃）：第二，不准找人偷偷查我打听我。</w:t></w:r></w:p><w:p w14:paraId="7AB7D2CE"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（干脆）：好。</w:t></w:r></w:p><w:p w14:paraId="7FDC65C0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（加重语气）：第三，永远不准再拿感情当考试。</w:t></w:r></w:p><w:p w14:paraId="6834C8F1"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坚定，承诺）：一辈子都不考。</w:t></w:r></w:p><w:p w14:paraId="71F49FA9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川伸手从西装内侧口袋掏出一个白色戒指盒，打开盒子展示给林晓禾看。盒内是一枚心形粉钻戒指，在灯光下闪耀。</w:t></w:r></w:p><w:p w14:paraId="3B97DF62"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（深情）：这个，你应该认得。</w:t></w:r></w:p><w:p w14:paraId="236FE984"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头特写戒指盒内的粉色心形钻戒。林晓禾看着戒指，眼神中闪过一丝错愕和不解。</w:t></w:r></w:p><w:p w14:paraId="6C531FB3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（轻蔑，疑惑）：几十块的假戒指，你还留着？</w:t></w:r></w:p><w:p w14:paraId="7CEC1CA0"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（认真，纠正）：不是假的。</w:t></w:r></w:p><w:p w14:paraId="20D96569"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川双手捧着戒指盒，目光温柔地看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="48BADC39"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（深情，解释）：佳士得拍的520万，半年前拍下的。看到第一眼就想，以后要送给真正想娶的人。</w:t></w:r></w:p><w:p w14:paraId="44840DA5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（震惊，不敢置信）：你说什么？</w:t></w:r></w:p><w:p w14:paraId="7FE29C75"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坦诚，回忆）：装穷相亲那天起我就把它带在身上，不敢拿真盒子，怕你看出端倪，就找了个普通纸盒装着，骗你说是几十块的锆石仿品。</w:t></w:r></w:p><w:p w14:paraId="19803337"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="4B2E07E5"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第67集</w:t></w:r></w:p><w:p w14:paraId="376F8B5C"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>67-1 别墅花园 夜 外</w:t></w:r></w:p><w:p w14:paraId="2D1852D9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周明川、林晓禾</w:t></w:r></w:p><w:p w14:paraId="622CD633"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 夜晚的别墅花园，灯光柔和。林晓禾身穿白色抹胸礼服，双手捧着一个打开的白色戒指盒，盒内是一枚闪耀的心形粉钻戒指。她神情震惊，眼眶微红。</w:t></w:r></w:p><w:p w14:paraId="7308449F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（深情）：仿品，我怕你知道它值多少钱，就不敢收了。</w:t></w:r></w:p><w:p w14:paraId="5820104F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（震惊，难以置信）：五百多万的戒指，你就装个破纸盒里骗我？</w:t></w:r></w:p><w:p w14:paraId="37C5BDD5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 镜头切到周明川，他身穿深灰色西装，神情诚恳地看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="2B6E583D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（坦诚，认真）：我那时候连身份都在骗你，多骗一个戒指算什么？但有一件事我没骗你，我想娶你是真的。</w:t></w:r></w:p><w:p w14:paraId="18CC0EFC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾眼中含泪，感动地看着周明川。周明川从盒中取出戒指，轻轻戴在林晓禾的左手中指上。</w:t></w:r></w:p><w:p w14:paraId="4AF0BB8C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（深情，郑重）：林晓禾，我不是要拿钱砸你，我是想从今天起，我所有的一切，包括这枚戒指，包括我这个人，都是你的。</w:t></w:r></w:p><w:p w14:paraId="22357559"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾看着手上的戒指，破涕为笑，举起手展示。</w:t></w:r></w:p><w:p w14:paraId="1252EE2B"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（调侃，傲娇）：五百多万的戒指收了，不代表你试用期过了。</w:t></w:r></w:p><w:p w14:paraId="204BCD30"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（惊喜，顺从）：那我继续表现。</w:t></w:r></w:p><w:p w14:paraId="2ED00CDB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（嗔怪，微笑）：少得意，表现不好照样退货。</w:t></w:r></w:p><w:p w14:paraId="523C986F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川开心地笑了，上前紧紧抱住林晓禾。</w:t></w:r></w:p><w:p w14:paraId="64C30DE8"><w:pPr><w:spacing w:before="60" w:after="60"/></w:pPr></w:p><w:p w14:paraId="3677FCFE"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>67-2 老街云吞摊 日 外</w:t></w:r></w:p><w:p w14:paraId="09D33287"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：沈曼云、周启山</w:t></w:r></w:p><w:p w14:paraId="3E45CAE7"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 清晨的老街，阳光洒在一家名为“旧街口云吞”的小摊上。沈曼云穿着围裙正在锅里下云吞，热气腾腾。周启山坐在轮椅上，在一旁整理桌椅。</w:t></w:r></w:p><w:p w14:paraId="27B8AC5C"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（试探，期待）：老婆，你说我以后还用不用坐轮椅？</w:t></w:r></w:p><w:p w14:paraId="3B35639B"><w:pPr><w:spacing w:before="240" w:after="240"/></w:pPr></w:p><w:p w14:paraId="338B3F83"><w:pPr><w:pStyle w:val="2"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>第68集</w:t></w:r></w:p><w:p w14:paraId="2E6B7E28"><w:pPr><w:pStyle w:val="3"/><w:bidi w:val="0"/></w:pPr><w:r><w:t>68-1 老街云吞摊 日 外</w:t></w:r></w:p><w:p w14:paraId="34CBAC35"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>人物：周启山、沈曼云、林晓禾、周明川</w:t></w:r></w:p><w:p w14:paraId="4963492D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 清晨的老街，阳光洒在湿漉漉的石板路上。一家名为“旧街口云吞摊”的小摊冒着热气，招牌上写着“手工鲜肉云吞 8元一碗”。</w:t></w:r></w:p><w:p w14:paraId="2EA1C140"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周启山身穿灰色衬衫，拄着拐杖站在摊位旁，面带微笑看着沈曼云。</w:t></w:r></w:p><w:p w14:paraId="0B85E0A3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（调侃，微笑）：装样子了。</w:t></w:r></w:p><w:p w14:paraId="28A075E3"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云身穿深蓝色围裙，正在大锅前捞云吞，听到这话抬头瞪了周启山一眼。</w:t></w:r></w:p><w:p w14:paraId="487A1D73"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（嗔怪，手中动作不停）：你敢再装一次，我连你腿一块修。</w:t></w:r></w:p><w:p w14:paraId="6BB766BF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周启山笑着指了指身后停放的一辆空轮椅。</w:t></w:r></w:p><w:p w14:paraId="2F7690BC"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（幽默，指着轮椅）：那这椅子也别闲着，回头洗干净送康复中心去，还能帮着别人。</w:t></w:r></w:p><w:p w14:paraId="04F19680"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 沈曼云笑了，将捞好的云吞盛入碗中。</w:t></w:r></w:p><w:p w14:paraId="329B1917"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>沈曼云（笑意盈盈）：行啊，这回也学会能修别扔了。</w:t></w:r></w:p><w:p w14:paraId="586C25A5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周启山收起笑容，目光变得深邃温和。</w:t></w:r></w:p><w:p w14:paraId="2F41064A"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周启山（感慨，语重心长）：能用在实处，就不算废物。跟人一样。</w:t></w:r></w:p><w:p w14:paraId="56A33C3F"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 一辆蓝色的电动三轮车驶来，林晓禾穿着工装背带裤坐在驾驶位，周明川穿着深蓝色工装坐在后车斗里，手里提着两袋蔬菜。</w:t></w:r></w:p><w:p w14:paraId="6D8122EB"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 三轮车停在摊位前，林晓禾跳下车，开心地朝摊位喊道。</w:t></w:r></w:p><w:p w14:paraId="648D1616"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（欢快，大声）：阿姨两碗云吞，明川付钱。</w:t></w:r></w:p><w:p w14:paraId="5160607D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川从车上下来，一脸惊讶地看着林晓禾。</w:t></w:r></w:p><w:p w14:paraId="6B8E393D"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（无奈，皱眉）：怎么又是我？</w:t></w:r></w:p><w:p w14:paraId="24EC07C9"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾理直气壮地看着他。</w:t></w:r></w:p><w:p w14:paraId="24295779"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（俏皮，理所当然）：你有钱。</w:t></w:r></w:p><w:p w14:paraId="61004A50"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 周明川指着摊位上的价格牌反驳。</w:t></w:r></w:p><w:p w14:paraId="60CE1E50"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>周明川（辩解，指着牌子）：你不是说不看钱？</w:t></w:r></w:p><w:p w14:paraId="675298F5"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 林晓禾走到价格牌前，手指点着“8元一碗”的字样，狡黠地笑了。</w:t></w:r></w:p><w:p w14:paraId="7D4262EF"><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>林晓禾（得意，指着价格）：不看钱，没说不让你付8块。</w:t></w:r></w:p><w:p w14:paraId="3F433D69"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/></w:rPr><w:t>△ 四人站在摊位前，沐浴在金色的晨光中，相视而笑，气氛温馨和谐。</w:t></w:r></w:p><w:p w14:paraId="1F26BBC1"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="721279A1"><w:pPr><w:rPr><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="24"/></w:rPr><w:t>《假穷真爱》免费看全集https://novelquickapp.com/s/S_yMCfCE75w/</w:t></w:r></w:p><w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1440" w:right="1800" w:bottom="1440" w:left="1800" w:header="851" w:footer="992" w:gutter="0"/><w:cols w:space="720" w:num="1"/></w:sectPr></w:body></w:document></pkg:xmlData></pkg:part><pkg:part pkg:name="/docProps/app.xml" pkg:contentType="application/vnd.openxmlformats-officedocument.extended-properties+xml"><pkg:xmlData><Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties" xmlns:vt="http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes"><Pages>59</Pages><Words>12706</Words><Characters>12883</Characters><TotalTime>33</TotalTime><ScaleCrop>false</ScaleCrop><LinksUpToDate>false</LinksUpToDate><CharactersWithSpaces>13192</CharactersWithSpaces><Application>WPS Office_12.1.0.28505_F1E327BC-269C-435d-A152-05C5408002CA</Application></Properties></pkg:xmlData></pkg:part><pkg:part pkg:name="/docProps/core.xml" pkg:contentType="application/vnd.openxmlformats-package.core-properties+xml"><pkg:xmlData><cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-