          "延续到后段"
        ],
        "additionalProperties": false
      },
      "加密取帧请求": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "镜头": {
              "type": "string",
              "pattern": "^E[0-9]{2,}-K[0-9]{3,}$"
            },
            "时间": {
              "type": "string"
            },
            "原因": {
              "type": "string"
            }
          },
          "required": [
            "镜头",
            "时间",
            "原因"
          ],
          "additionalProperties": false
        }
      },
      "待核对": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "位置": {
              "type": "object",
              "minProperties": 1
            },
            "问题": {
              "type": "string"
            },
            "需要": {
              "type": "string"
            },
            "级别": {
              "enum": [
                "阻断",
                "规范"
              ]
            }
          },
          "required": [
            "位置",
            "问题",
            "级别"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "片段",
      "模式",
      "镜头",
      "衔接",
      "加密取帧请求",
      "待核对"
