{
  "动作识别": {
    "type": "object",
    "properties": {
      "片段": {
        "type": "string",
        "pattern": "^E[0-9]{2,}-P[0-9]{2,}$"
      },
      "模式": {
        "enum": [
          "片段识别",
          "定向复看"
        ]
      },
      "镜头": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "镜头": {
              "type": "string",
              "pattern": "^E[0-9]{2,}-K[0-9]{3,}$"
            },
            "起": {
              "type": "string",
              "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
            },
            "止": {
              "type": "string",
              "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
            },
            "场景信息": {
              "type": "object",
