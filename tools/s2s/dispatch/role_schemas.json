                    "夜",
                    "不明"
                  ]
                },
                "内外": {
                  "enum": [
                    "内",
                    "外",
                    "不明"
                  ]
                },
                "闪回迹象": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "地点",
                "日夜",
                "内外",
                "闪回迹象"
              ],
              "additionalProperties": false
            },
            "画面人物": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "人物": {
                    "type": "string",
                    "pattern": "^(C[0-9]{3,}|E[0-9]{2,}-P[0-9]{2,}-T[1-9][0-9]*)$"
                  },
                  "外观": {
                    "type": "string"
                  },
                  "位置": {
                    "type": "string"
                  }
                },
                "required": [
                  "人物",
                  "位置"
                ],
                "additionalProperties": false
              }
            },
            "动作": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "起": {
                    "type": "string",
                    "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
                  },
                  "止": {
                    "type": "string",
                    "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
                  },
                  "执行者": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^C[0-9]{3,}$"
                      },
                      {
                        "type": "string",
                        "pattern": "^E[0-9]{2,}-P[0-9]{2,}-T[1-9][0-9]*$"
                      }
                    ]
                  },
                  "动作": {
                    "type": "string"
                  },
                  "对象": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "物件": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "结果": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "关键": {
                    "type": "boolean"
                  },
                  "关键类别": {
                    "anyOf": [
                      {
                        "enum": [
                          1,
                          2,
                          3,
                          4,
                          5
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "依据帧": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(K[0-9]{3,}_[0-9]{2}|t[0-9]{2}-[0-5][0-9]\\.[0-9])\\.jpg$"
                    },
                    "minItems": 1
                  },
                  "确定度": {
                    "enum": [
                      "确认",
                      "存疑"
                    ]
                  },
                  "说明": {
                    "type": "string"
                  }
                },
                "required": [
                  "起",
                  "止",
                  "执行者",
                  "动作",
                  "对象",
                  "物件",
                  "结果",
                  "关键",
                  "关键类别",
                  "依据帧",
                  "确定度",
                  "说明"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "关键": {
                          "const": true
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "关键类别": {
                          "type": "integer",
                          "enum": [
                            1,
                            2,
                            3,
                            4,
                            5
                          ]
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "关键类别": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "神态": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "人物": {
                    "type": "string",
                    "pattern": "^(C[0-9]{3,}|E[0-9]{2,}-P[0-9]{2,}-T[1-9][0-9]*)$"
                  },
                  "神态": {
                    "type": "string"
                  },
                  "时间": {
                    "type": "string",
                    "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
                  },
                  "依据帧": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(K[0-9]{3,}_[0-9]{2}|t[0-9]{2}-[0-5][0-9]\\.[0-9])\\.jpg$"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "人物",
                  "神态",
                  "时间",
                  "依据帧"
                ],
                "additionalProperties": false
              }
            },
            "口型": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "人声时间段",
                  "人物状态"
                ],
                "additionalProperties": false,
                "properties": {
                  "人声时间段": {
                    "type": "string",
                    "pattern": "^\\d{2,}:\\d{2}\\.\\d-\\d{2,}:\\d{2}\\.\\d$"
                  },
                  "人物状态": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "人物",
                        "状态"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "人物": {
                          "type": "string"
                        },
                        "状态": {
                          "enum": [
                            "可见",
                            "被挡",
                            "背对",
                            "出画"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "画面文字": {
              "type": "array"
            },
            "说明": {
              "type": "string"
            }
          },
          "required": [
            "镜头",
            "起",
            "止",
            "场景信息",
            "画面人物",
            "动作",
            "神态",
            "口型",
            "画面文字",
            "说明"
          ],
          "additionalProperties": false
        }
      },
      "衔接": {
        "type": "object",
        "properties": {
