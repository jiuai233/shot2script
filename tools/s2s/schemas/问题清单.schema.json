{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "问题清单",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^E[0-9]{2,}-Q[0-9]{3,}$"
      },
      "来源": {
        "enum": [
          "识别",
          "归属",
          "成稿",
          "验收",
          "跨集"
        ]
      },
      "位置": {
        "type": "object",
        "properties": {
          "场景": {
            "type": "string",
            "pattern": "^场景[1-9][0-9]*-[1-9][0-9]*$"
          },
          "行": {
            "type": "integer",
            "minimum": 1
          },
          "镜头": {
            "type": "string",
            "pattern": "^E[0-9]{2,}-K[0-9]{3,}$"
          },
          "时间": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
          },
          "句": {
            "type": "string",
            "pattern": "^E[0-9]{2,}-S[0-9]{3,}$"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "原文": {
        "type": "string"
      },
      "类型": {
        "enum": [
          "具体动作",
          "动作与对白关联",
          "人物指代与角色卡",
          "声音与画面归属",
          "全文完整性与一致性",
          "角色卡资料"
        ]
      },
      "级别": {
        "enum": [
          "阻断",
          "规范"
        ]
      },
      "相关人物": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^C[0-9]{3,}$"
            },
            {
              "type": "string",
              "pattern": "^E[0-9]{2,}-P[0-9]{2,}-T[1-9][0-9]*$"
            }
          ]
        }
      },
      "依据": {
        "type": "string"
      },
      "修正要求": {
        "type": "string"
      },
      "处理职责": {
        "type": "string"
      },
      "状态": {
        "enum": [
          "待核对",
          "待修正",
          "已修正",
          "待人工裁定",
          "已裁定"
        ]
      },
      "复核结果": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "来源",
      "位置",
      "原文",
      "类型",
      "级别",
      "相关人物",
      "依据",
      "修正要求",
      "处理职责",
      "状态",
      "复核结果"
    ],
    "additionalProperties": false
  }
}
