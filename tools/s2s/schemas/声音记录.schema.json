{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "声音记录",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^E[0-9]{2,}-S[0-9]{3,}$"
      },
      "起": {
        "type": "string",
        "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
      },
      "止": {
        "type": "string",
        "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
      },
      "文本": {
        "type": "string"
      },
      "声线": {
        "type": "string",
        "pattern": "^E[0-9]{2,}-V[1-9][0-9]*$"
      },
      "听辨": {
        "enum": [
          "清楚",
          "重叠",
          "听不清"
        ]
      },
      "核对": {
        "type": "object",
        "properties": {
          "状态": {
            "enum": [
              "一致",
              "不一致",
              "仅主路",
              "仅副路",
              "人工确认",
              "单路识别",
              "待核对"
            ]
          },
          "主路": {
            "type": "string"
          },
          "副路": {
            "type": "string"
          },
          "字幕": {
            "type": "string"
          },
          "备注": {
            "type": "string"
          },
          "优先级": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "决定来源": {
            "enum": [
              "主路",
              "副路",
              "字幕",
              "手改",
              "原文"
            ]
          },
          "原始文本": {
            "type": "string"
          },
          "异常": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "状态",
          "优先级"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "原始文本",
              "异常"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "主路"
                  ]
                },
                {
                  "required": [
                    "副路"
                  ]
                }
              ]
            },
            "properties": {
              "状态": {
                "enum": [
                  "单路识别",
                  "待核对",
                  "人工确认"
                ]
              }
            }
          },
          {
            "required": [
              "主路",
              "副路"
            ],
            "not": {
              "required": [
                "原始文本"
              ]
            },
            "properties": {
              "状态": {
                "enum": [
                  "一致",
                  "不一致",
                  "仅主路",
                  "仅副路",
                  "人工确认"
                ]
              }
            }
          }
        ]
      },
      "截断": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "起",
      "止",
      "文本",
      "声线",
      "听辨"
    ],
    "additionalProperties": false
  }
}
