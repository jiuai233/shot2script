{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "字幕记录",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "起": {
        "type": "string",
        "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
      },
      "止": {
        "type": "string",
        "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
      },
      "文字": {
        "type": "string"
      },
      "类型": {
        "enum": [
          "台词字幕",
          "人物字卡",
          "地点字幕",
          "画面文字"
        ]
      },
      "框": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "width": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "height": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "置信度": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "required": [
      "起",
      "止",
      "文字",
      "类型"
    ],
    "additionalProperties": false
  }
}
