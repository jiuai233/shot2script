{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "加密帧索引",
  "type": "object",
  "properties": {
    "视频": {
      "type": "string"
    },
    "起": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
    },
    "止": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
    },
    "帧率": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "帧": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "文件": {
            "type": "string",
            "pattern": "^t[0-9]{2}-[0-5][0-9]\\.[0-9]\\.jpg$"
          },
          "时间": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
          }
        },
        "required": [
          "文件",
          "时间"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "视频",
    "起",
    "止",
    "帧率",
    "帧"
  ],
  "additionalProperties": false
}
