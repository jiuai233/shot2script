{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "镜头表",
  "type": "object",
  "properties": {
    "集": {
      "type": "integer",
      "minimum": 1
    },
    "视频": {
      "type": "string"
    },
    "时长": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
    },
    "镜头": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{2,}-K[0-9]{3,}$"
          },
          "起": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
          },
          "止": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
          },
          "帧": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "文件": {
                  "type": "string",
                  "pattern": "^K[0-9]{3}_[0-9]{2}\\.jpg$"
                },
                "时间": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
                }
              },
              "required": [
                "文件",
                "时间"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "起",
          "止",
          "帧"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "集",
    "视频",
    "时长",
    "镜头"
  ],
  "additionalProperties": false
}
