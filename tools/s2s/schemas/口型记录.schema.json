{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "口型记录",
  "type": "object",
  "properties": {
    "集": {
      "type": "integer",
      "minimum": 1
    },
    "参数": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "阈值": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "fps",
        "阈值"
      ],
      "additionalProperties": true
    },
    "句": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/句"
      }
    },
    "声线配对": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "声线": {
            "type": "string",
            "pattern": "^E[0-9]{2,}-V[1-9][0-9]*$"
          },
          "轨迹组": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "支持句数": {
            "type": "integer",
            "minimum": 0
          },
          "反例句数": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "声线",
          "轨迹组",
          "支持句数",
          "反例句数"
        ],
        "additionalProperties": false
      }
    },
    "版本": {
      "enum": [
        "baseline",
        "side",
        "model",
        "fused"
      ]
    },
    "主动说话人模型": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "输入版本": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "模型": {
      "type": "object"
    },
    "统计": {
      "type": "object"
    },
    "证据目录": {
      "type": "string"
    },
    "复用模型输出": {
      "type": "string"
    },
    "复用侧脸记录": {
      "type": "string"
    },
    "复核统计": {
      "type": "object"
    }
  },
  "required": [
    "集",
    "参数",
    "句",
    "声线配对"
  ],
  "additionalProperties": false,
  "$defs": {
    "框": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "曲线项": {
      "type": "object",
      "properties": {
        "时间": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-5][0-9]\\.(?:[0-9]|[0-9]{3})$"
        },
        "张合比": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "有效": {
          "type": "boolean"
        },
        "音量": {
          "type": "number",
          "minimum": 0
        },
        "嘴部像素变化": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "时间",
        "张合比",
        "有效",
        "音量"
      ],
      "additionalProperties": false
    },
    "模型曲线项": {
      "type": "object",
      "properties": {
        "时间": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-5][0-9]\\.(?:[0-9]|[0-9]{3})$"
        },
        "说话概率": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "时间",
        "说话概率"
      ],
      "additionalProperties": false
    },
    "评分依据": {
      "type": "object",
      "properties": {
        "有效帧": {
          "type": "integer",
          "minimum": 0
        },
        "检测帧": {
          "type": "integer",
          "minimum": 0
        },
        "静音基线帧": {
          "type": "integer",
          "minimum": 0
        },
        "基线来源": {
          "type": "string"
        },
        "规则分数": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "规则状态": {
          "enum": [
            "开口",
            "未开口",
            "看不到",
            "存疑"
          ]
        },
        "模型有效帧": {
          "type": "integer",
          "minimum": 0
        },
        "评分冲突": {
          "type": "boolean"
        },
        "测量方式": {
          "type": "string"
        }
      },
      "required": [
        "有效帧",
        "检测帧",
        "静音基线帧",
        "基线来源"
      ],
      "additionalProperties": true
    },
    "复核": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "状态": {
              "type": "string"
            },
            "依据帧": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "结果": {
              "type": "string"
            },
            "原因": {
              "type": "string"
            },
            "画面结论": {
              "enum": [
                "画内",
                "未开口",
                "看不到",
                "存疑"
              ]
            },
            "与代码一致": {
              "type": "boolean"
            },
            "补帧索引": {
              "type": "string"
            }
          },
          "required": [
            "状态"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "依据帧",
                "结果"
              ]
            },
            {
              "required": [
                "原因"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "轨迹": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{2,}-K[0-9]{3,}-F[1-9][0-9]*$"
        },
        "轨迹组": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "框": {
          "$ref": "#/$defs/框"
        },
        "说话分数": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "状态": {
          "enum": [
            "开口",
            "未开口",
            "看不到",
            "存疑"
          ]
        },
        "评分依据": {
          "$ref": "#/$defs/评分依据"
        },
        "不可用原因": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "依据帧": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "曲线": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/曲线项"
          }
        },
        "规则分数": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "模型分数": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "模型曲线": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/模型曲线项"
          }
        },
        "检测来源": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "嘴部区域": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "轨迹组",
        "框",
        "说话分数",
        "状态",
        "评分依据",
        "不可用原因",
        "依据帧",
        "曲线"
      ],
      "additionalProperties": false
    },
    "句": {
      "type": "object",
      "properties": {
        "句": {
          "type": "string",
          "pattern": "^E[0-9]{2,}-S[0-9]{3,}$"
        },
        "起": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
        },
        "止": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-5][0-9]\\.[0-9]$"
        },
        "文本": {
          "type": "string"
        },
        "声线": {
          "type": "string",
          "pattern": "^E[0-9]{2,}-V[1-9][0-9]*$"
        },
        "镜头": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E[0-9]{2,}-K[0-9]{3,}$"
          }
        },
        "结论": {
          "enum": [
            "画内",
            "未开口",
            "看不到",
            "存疑"
          ]
        },
        "轨迹": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/轨迹"
          }
        },
        "复核": {
          "$ref": "#/$defs/复核"
        },
        "代表帧": {
          "type": "string"
        },
        "代表时间秒": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "句",
        "起",
        "止",
        "文本",
        "声线",
        "镜头",
        "结论",
        "轨迹",
        "复核"
      ],
      "additionalProperties": false
    }
  }
}
