{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "对照表",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "行": {
        "type": "integer",
        "minimum": 1
      },
      "类型": {
        "enum": [
          "场景行",
          "人物行",
          "△",
          "对白"
        ]
      },
      "场景": {
        "type": "string",
        "pattern": "^场景[1-9][0-9]*-[1-9][0-9]*$"
      },
      "句": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^E[0-9]{2,}-S[0-9]{3,}$"
        }
      },
      "镜头": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^E[0-9]{2,}-K[0-9]{3,}$"
        }
      },
      "动作": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^E[0-9]{2,}-A[0-9]{4,}$"
        }
      }
    },
    "required": [
      "行",
      "类型",
      "场景",
      "句",
      "镜头",
      "动作"
    ],
    "additionalProperties": false
  }
}
